@{
    Layout = null;
}

<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <META http-equiv="Content-Type" content="text/html; charset=utf-8">

    <style type="text/css">
        body {
            text-rendering: geometricPrecision;
        }
       

        /*Print classes*/
        table.bordered {
            border-collapse: collapse;
        }

            table.bordered td, table.bordered th {
                padding: 3px 5px;
                border: 1px solid #777;
            }

        table.no-border {
            border: none !important;
        }

            table.no-border td, table.no-border th {
                border: none !important;
            }
        /*Print classes*/

        /*Print classes*/
        label.control-label {
            font-weight: bold
        }

        tr.highlight-bold td {
            background-color: #eee;
            font-size: 11pt;
            font-weight: bold;
        }

        table.protokol-table th {
            background-color: #a8a8a8;
            font-weight: bold;
            color: white;
            padding: 2px 5px;
        }

        table.protokol-table td {
            padding: 1px 5px;
            font-size: 10pt;
        }

        table.row-space-single td {
            padding-bottom: 15px;
        }
        

        p {
            margin-top: 0.4em;
            margin-block-start: 0.4em;
            margin-bottom: 0.4em;
            margin-block-end: 0.4em;
        }
    </style>

</head>
<body>
    @RenderBody()
</body>
</html>