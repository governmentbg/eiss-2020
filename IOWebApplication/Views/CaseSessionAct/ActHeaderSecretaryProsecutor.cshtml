@using IOWebApplication.Infrastructure.Extensions
@using IOWebApplication.Infrastructure.Models.ViewModels.Case
@using IOWebApplication.Infrastructure.Constants
@model CaseSessionActPrintVM
@switch (Model.ActTypeId)
{
    //Решение
    case NomenclatureConstants.ActType.Answer:
    //Преместено от долния case 19.11.2021
    case NomenclatureConstants.ActType.Definition:
        {
            @if (!string.IsNullOrEmpty(Model.SecretaryName))
            {
                <div>
                    при участието на секретаря @Model.SecretaryName
                </div>
            }
            else
            {
                @if (Model.SecretaryList.Count > 0)
                {
                    <div>
                        при участието на секретаря @Model.SecretaryList.MakeNiceNamesList()
                    </div>
                }
            }

            @if (Model.ProsecutorList.Count > 0 && Model.SessionIdOpen)
            {
                <div>
                    в присъствието на прокурора @Model.ProsecutorList.MakeNiceNamesList()
                </div>
            }
        }
        break;
    //Определение и Разпореждане не се визуализират секретар и прокурор
    case NomenclatureConstants.ActType.Injunction:
        {
        }
        break;

    default:
        {
            @if (!string.IsNullOrEmpty(Model.SecretaryName) || Model.SecretaryList.Count > 0)
            {
                @if (!string.IsNullOrEmpty(Model.SecretaryName))
                {
                    <div>
                        при участието на секретаря @Model.SecretaryName
                    </div>
                }
                else
                {
                    @if (Model.SecretaryList.Count > 0)
                    {
                        <div>
                            при участието на секретаря @Model.SecretaryList.MakeNiceNamesList()
                        </div>
                    }
                }
                @if (Model.ProsecutorList.Count > 0 && Model.SessionIdOpen)
                {
                    <div>
                        и прокурора @Model.ProsecutorList.MakeNiceNamesList()
                    </div>
                }
            }
            else
            {
                @if (Model.ProsecutorList.Count > 0 && Model.SessionIdOpen)
                {
                    <div>
                        при участието на прокурора @Model.ProsecutorList.MakeNiceNamesList()
                    </div>
                }
            }
        }
        break;
}


