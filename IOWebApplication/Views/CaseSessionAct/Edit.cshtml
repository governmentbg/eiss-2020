@model CaseSessionActEditVM
@using IOWebApplication.Infrastructure.Contracts
@using IOWebApplication.Infrastructure.Data.Models.Cases
@using IOWebApplication.Infrastructure.Models.ViewModels.Case
@using IOWebApplication.Infrastructure.Models.ViewModels.Common
@using IOWebApplication.Infrastructure.Models.ViewModels
@using IOWebApplication.Infrastructure.Constants
@using IOWebApplication.Infrastructure.Extensions
@inject IUserContext userContext

@{
    if (Model.Id > 0)
    {
        ViewData["Title"] = "Редакция на акт/протокол";
    }
    else
    {
        ViewData["Title"] = "Добавяне на акт/протокол";
    }

    var caseId = ViewBag.caseId;
    bool hasActPdf = (bool)(ViewBag.hasActPdf ?? false);
    bool isFastProcess = (bool)(ViewBag.isFastProcess ?? false);
    bool hasDefacedBlank = (bool)(ViewBag.hasDefacedBlank ?? false) || (Model.ActDeclaredDate != null);
    bool hasDefacedMotivesBlank = (bool)(ViewBag.hasDefacedMotivesBlank ?? false);
    bool hasDefacedAct = (bool)(ViewBag.hasDefacedAct ?? false);
    bool hasDefacedMotives = (bool)(ViewBag.hasDefacedMotives ?? false);
    int caseGroupId = (int)ViewBag.CaseGroupId;
    bool hasMotives = !string.IsNullOrEmpty(Model.RegNumber)
                        && caseGroupId == NomenclatureConstants.CaseGroups.NakazatelnoDelo
                        && Model.IsFinalDoc
                        && NomenclatureConstants.ActType.WithMotives.Contains(Model.ActTypeId);
    bool hasComplainResult = (bool)ViewBag.hasComplainResult;
    bool hasComplainIndex = (bool)ViewBag.hasComplainIndex;
    bool hasEditFinishDoc = (bool)ViewBag.hasEditFinishDoc;
    if (!string.IsNullOrEmpty(Model.EcliCode))
    {
        hasEditFinishDoc = false;
    }

    bool canAccessFile = (bool)ViewBag.canAccessFile;
    bool canRegisterAct = ((Model.RegDate == null) && !hasActPdf) && !userContext.IsSystemInFeature(NomenclatureConstants.SystemFeatures.Request1_2024);
    bool autoSave = (bool)(ViewBag.autoSave ?? false);
    bool canAccessDefaceAct = (bool)(ViewBag.canAccessDefaceAct ?? false);
    bool canAccessDefaceMotive = (bool)(ViewBag.canAccessDefaceMotive ?? false);
    bool showNoResultButton = (bool)(ViewBag.sessionNoResults ?? false);
    bool quickViewEnabled = (bool)(ViewBag.quickViewEnabled ?? false);
    IAccessControl access = (IAccessControl)ViewBag.AccessControl;
    string regNumberDate = "";
    if (Model.RegDate != null)
    {
        regNumberDate = $"{Model.RegNumber} / {Model.RegDate:dd.MM.yyyy}";
    }
    bool showNoSecretaryInfo = false;
    if (NomenclatureConstants.ActType.SecretarySign.Contains(Model.ActTypeId) && string.IsNullOrEmpty(Model.SecretaryUserId))
    {
        showNoSecretaryInfo = true;
    }
    bool hasActComplainResultRespect = (bool)ViewBag.hasActComplainResultRespect;

    bool canCorrectAfterDeclare = (bool)(ViewBag.canCorrectAfterDeclare ?? false);

    bool activeRequest12024 = userContext.IsSystemInFeature(NomenclatureConstants.SystemFeatures.Request1_2024);

    ViewData["ShowMenuCounts"] = true;
}

@section breadcrumb {
    @if (ViewBag.breadcrumbs != null)
    {
        <partial name="Breadcrumbs" model="@(List<IOWebApplication.Infrastructure.Models.ViewModels.Common.BreadcrumbsVM>)ViewBag.breadcrumbs" />
    }
}
@section titleInfo {
    @if (Model.CaseId > 0)
    {
        @await Component.InvokeAsync(nameof(IOWebApplication.Components.CaseWarningComponent), new { caseId = Model.CaseId.Value })
    }
}


<div class="nav-tabs-custom">
    <ul class="nav nav-tabs" id="actTab">
        <li class="active"><a href="#tabMainActData" data-toggle="tab"><i class="fa fa-database"></i> Основни данни</a></li>
        @if (Model.Id > 0)
        {
            <li class=""><a href="#tabWorkTask" data-toggle="tab"><i class="fa fa-exclamation"></i> Задачи</a></li>

            @if ((bool)ViewBag.hasCoordination)
            {
                <li class=""><a href="#tabCordination" data-toggle="tab"><i class="fa fa-thumbs-o-up"></i> Съгласуване</a></li>
            }
            <li class=""><a href="#tabDocTemplates" data-toggle="tab"><i class="fa fa-book"></i> Свързани документи</a></li>
        }
    </ul>

    <div class="tab-content">
        <div class="tab-pane active" id="tabMainActData">

            <div class="row">
                <div class="col-md-6">
                    @if (showNoSecretaryInfo)
                    {
                        <div class="callout callout-warning">
                            <p>В протокола няма избран секретар.</p>
                        </div>
                    }


                    <form asp-action="Edit" method="post" id="mainForm">
                        @Html.HiddenFor(x => x.Id)
                        @Html.HiddenFor(x => x.CaseId)
                        @Html.HiddenFor(x => x.CourtId)
                        @Html.HiddenFor(x => x.CaseSessionId)
                        @Html.HiddenFor(x => x.RegDate)
                        @Html.HiddenFor(x => x.RegNumber)
                        @Html.HiddenFor(x => x.ActDeclaredDate)
                        @Html.HiddenFor(x => x.DateWrt)
                        @Html.HiddenFor(x => x.Description)


                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div id="saveContainer">
                            <partial name="_SaveFormContent" model="@("#saveContainer")" />
                            <fieldset class="is-fieldset">
                                <legend class="legend_1">Информация</legend>
                                @if (Model.Id > 0)
                                {
                                    <div class="row">
                                        <div class="col-lg-3">@Html.DisplayFor(x => regNumberDate, "obj", new { label = "Номер / Дата на регистрация" })</div>
                                        <div class="col-lg-3">@Html.DisplayFor(x => x.ActDeclaredDate, "date")</div>
                                        <div class="col-lg-6">
                                            @if (!string.IsNullOrEmpty(Model.EcliCode))
                                            {
                                                @Html.DisplayFor(x => x.EcliCode, "obj")
                                            }
                                        </div>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(Model.RegNumber))
                                {
                                    @Html.HiddenFor(x => x.ActTypeId)
                                    @Html.HiddenFor(x => x.ActKindId)
                                    @Html.HiddenFor(x => x.RelatedActId)
                                    @Html.HiddenFor(x => x.HasCorrectedAct)

                                    <div class="row disable-controls">
                                        <div class="col-lg-6">
                                            @Html.EditorFor(x => x.ActTypeId, "GenericDropDown")
                                            @if (isFastProcess)
                                            {
                                                <div id="divGenerateExecProcess">
                                                    @Html.DisplayFor(x => x.GenerateExecProcess, "objVal", null, new { value = (Model.GenerateExecProcess) ? "Да" : "He" })
                                                </div>
                                            }
                                        </div>
                                        <div class="col-lg-6">
                                            <div id="divActKind" style="display:none;">
                                                @Html.EditorFor(x => x.ActKindId, "GenericDropDown")
                                                <div id="divActDirection" style="display:block;">
                                                    @Html.EditorFor(x => x.ActDirectionId, "GenericDropDown")
                                                </div>
                                                <div id="divRelatedAct" style="display:none;">
                                                    @Html.EditorFor(x => x.RelatedActId, "GenericDropDown")
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row" id="divActTerm">
                                        <div class="col-lg-6"></div>
                                        <div class="col-lg-6">@Html.EditorFor(x => x.ActTerm)</div>
                                    </div>
                                    <div class="row" id="divSignJudge">
                                        <div class="col-lg-12 disable-controls">@Html.EditorFor(x => x.SignJudgeLawUnitId, "LawUnit", null, new { lawUnitType = NomenclatureConstants.LawUnitTypes.Judge })</div>
                                    </div>
                                    <div class="row disable-controls">
                                        <div class="col-lg-6">
                                            @Html.DisplayFor(x => x.HasCorrectedAct, "objVal", null, new { value = (Model.HasCorrectedAct) ? "Да" : "He" })
                                        </div>

                                    </div>
                                    @if (Model.HasCorrectedAct)
                                    {
                                        <div class="row disable-controls">
                                            <div class="col-lg-12">
                                                @Html.EditorFor(x => x.CorrectedActsIds, "GenericDropDownMultipleArray")
                                            </div>

                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="row">
                                        <div class="col-lg-6">
                                            @Html.EditorFor(x => x.ActTypeId, "GenericDropDown")
                                            <div id="divGenerateExecProcess">
                                                @Html.EditorFor(x => x.GenerateExecProcess, "Boolean")
                                            </div>
                                        </div>
                                        <div class="col-lg-6">
                                            <div id="divActKind" style="display:none;">
                                                @Html.EditorFor(x => x.ActKindId, "GenericDropDown")
                                                <div id="divActDirection" style="display:block;">
                                                    @Html.EditorFor(x => x.ActDirectionId, "GenericDropDown")
                                                </div>
                                                <div id="divRelatedAct" style="display:none;">
                                                    @Html.EditorFor(x => x.RelatedActId, "GenericDropDown")
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row" id="divActTerm">
                                        <div class="col-lg-6"></div>
                                        <div class="col-lg-6">@Html.EditorFor(x => x.ActTerm)</div>
                                    </div>
                                    <div class="row" id="divSignJudge">
                                        <div class="col-lg-12">@Html.EditorFor(x => x.SignJudgeLawUnitId, "LawUnit", null, new { lawUnitType = NomenclatureConstants.LawUnitTypes.Judge })</div>
                                    </div>
                                    <div class="row">
                                        <div class="col-lg-6">
                                            @Html.EditorFor(x => x.HasCorrectedAct, "Boolean")
                                        </div>
                                    </div>
                                    <div class="row correct-act">
                                        <div class="col-lg-12 ">
                                            @Html.EditorFor(x => x.CorrectedActsIds, "GenericDropDownMultipleArray")
                                        </div>
                                    </div>
                                }
                                @Html.HiddenFor(x => x.SecretaryUserId_list)
                                @Html.HiddenFor(x => x.SecretaryUserNamesList)
                                @if (Model.ActDeclaredDate != null)
                                {
                                    @Html.HiddenFor(x => x.SecretaryUserId)
                                    <div class="row">
                                        <div class="col-lg-6">@Html.DisplayFor(x => x.SecretaryUserNamesList, "obj")</div>
                                        <div class="col-lg-6">@Html.EditorFor(x => x.ActStateId, "GenericDropDown")</div>
                                    </div>
                                }
                                else
                                {
                                    <div class="row">
                                        <div class="col-lg-6">@Html.EditorFor(x => x.SecretaryUserId, "GenericDropDownMultiple")</div>
                                        <div class="col-lg-6">@Html.EditorFor(x => x.ActStateId, "GenericDropDown")</div>
                                    </div>
                                }
                                @if ((bool)ViewBag.isISPNcase)
                                {
                                    <div class="row">
                                        <div class="col-lg-6">@Html.EditorFor(x => x.ActISPNReasonId, "GenericDropDown")</div>
                                        <div class="col-lg-6">@Html.EditorFor(x => x.ActISPNDebtorStateId, "GenericDropDown")</div>
                                    </div>
                                }
                                @if ((bool)ViewBag.isRNFLcase)
                                {
                                    <div class="row">
                                        <div class="col-lg-6">@Html.EditorFor(x => x.ActISPNReasonId, "GenericDropDown")</div>
                                    </div>
                                    <div class="row">
                                        <div class="col-lg-6">@Html.EditorFor(x => x.RnflEffectiveImmediately, "bool")</div>
                                    </div>
                                }
                                <div class="row">
                                    <div class="col-lg-6">
                                        @if (hasEditFinishDoc)
                                        {
                                            @Html.EditorFor(x => x.IsFinalDoc, "Boolean")
                                        }
                                        else
                                        {
                                            @Html.EditorFor(x => x.IsFinalDoc, "BooleanDisabled")
                                        }
                                        @if (ViewBag.hasTDActForRegistration == true)
                                        {
                                            @Html.EditorFor(x => x.TDActForRegistration, "Boolean")
                                        }
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="row" id="divComplainResult">
                                            @if (canAccessFile || (Model.Id == 0))
                                            {
                                                <div class="col-lg-12">@Html.EditorFor(x => x.ActComplainResultId, "GenericDropDown")</div>
                                            }
                                            else
                                            {
                                                @Html.HiddenFor(x => x.ActComplainResultId)
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    @*<div class="col-lg-6">
                                    @Html.EditorFor(x => x.IsReadyForPublish, "Boolean")
                                    </div>*@
                                    <div class="col-lg-6">
                                        <div id="divInforcedDate">
                                            @Html.EditorFor(x => x.ActInforcedDate, "DateTime")
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-lg-4">
                                        @Html.EditorFor(x => x.CanAppeal, "Boolean")
                                    </div>
                                    <div class="col-lg-5">
                                        <div class="row" id="divActResult"><div class="col-lg-12">@Html.EditorFor(x => x.ActResultId, "GenericDropDown")</div></div>
                                    </div>
                                </div>
                                <div class="row" id="divAppelFastProcess">
                                    <div class="col-lg-4">
                                        @Html.EditorFor(x => x.AppealNotificationDaysFastProcess, "Int32Nullable")
                                    </div>
                                    <div class="col-lg-4">
                                        @Html.EditorFor(x => x.AppealNotificationWeeksFastProcess, "Int32Nullable")
                                    </div>
                                    <div class="col-lg-4">
                                        @Html.EditorFor(x => x.AppealNotificationMontsFastProcess, "Int32Nullable")
                                    </div>
                                </div>
                                @if (isFastProcess)
                                {
                                    <div class="row" id="divNotification">
                                        <div class="col-lg-4">@Html.EditorFor(x => x.NotificationOn, "Boolean")</div>
                                    </div>
                                    <div class="row" id="divNotificationTerm">
                                        <div class="col-lg-4">
                                            @Html.EditorFor(x => x.NotificationDays, "Int32Nullable")
                                        </div>
                                        <div class="col-lg-4">
                                            @Html.EditorFor(x => x.NotificationWeeks, "Int32Nullable")
                                        </div>
                                        <div class="col-lg-4">
                                            @Html.EditorFor(x => x.NotificationMonts, "Int32Nullable")
                                        </div>
                                    </div>
                                    <div class="row" id="divActNotification">
                                        <div class="col-lg-8">@Html.EditorFor(x => x.ActNotificationOn, "Boolean")</div>
                                    </div>
                                    <div class="row" id="divActNotificationTerm">
                                        <div class="col-lg-4">
                                            @Html.EditorFor(x => x.ActNotificationDays, "Int32Nullable")
                                        </div>
                                        <div class="col-lg-4">
                                            @Html.EditorFor(x => x.ActNotificationWeeks, "Int32Nullable")
                                        </div>
                                        <div class="col-lg-4">
                                            @Html.EditorFor(x => x.ActNotificationMonts, "Int32Nullable")
                                        </div>
                                    </div>
                                    <div class="row" id="divActNotificationDescTerm">
                                        <div class="col-lg-12">
                                            @Html.EditorFor(x => x.ActNotificationDescription, "Textarea")
                                        </div>
                                    </div>
                                }
                                <div class="row" id="divComplainIndex">
                                    <div class="col-lg-12">@Html.EditorFor(x => x.ActComplainIndexId, "GenericSelect2", null, new { wrap = true })</div>
                                </div>

                                @if (!string.IsNullOrEmpty(Model.Description))
                                {
                                    <div class="row">
                                        @if (canAccessFile)
                                        {
                                            <div class="col-lg-12">@Html.DisplayFor(x => x.Description, "obj")</div>
                                        }
                                        else
                                        {
                                            <div class="col-lg-12 text-muted">Актът е в процес на изготване.</div>
                                        }
                                    </div>
                                }

                            </fieldset>
                            @if (hasMotives && access.CanChange)
                            {
                                <fieldset class="is-fieldset">
                                    <legend class="legend_1">Мотиви</legend>
                                    <div class="row">
                                        <div class="col-lg-6">
                                            @if (Model.ActMotivesDeclaredDate.HasValue)
                                            {
                                                @Html.DisplayFor(x => x.ActMotivesDeclaredDate, "date")
                                            }
                                        </div>
                                        <div class="col-lg-6" style="margin-top:23px;">
                                            @if (!Model.ActMotivesDeclaredDate.HasValue)
                                            {
                                                <a asp-action="BlankMotives" asp-route-id="@Model.Id" class="btn btn-sm btn-def">Изготвяне</a>
                                            }
                                            @if (hasDefacedMotivesBlank && canAccessDefaceMotive)
                                            {
                                                if (!hasDefacedMotives)
                                                {
                                                    <span>&nbsp;</span>
                                                    <a asp-action="DepersonalizeMotives" asp-route-id="@Model.Id" class="btn btn-sm btn-def">Обезличаване</a>
                                                }
                                                else
                                                {
                                                    if (access.CanChangeFull)
                                                    {
                                                        <span>&nbsp;</span>
                                                        <a onclick="confirmDelete(this,'motive'); return false;" data-url="@Url.Action("RemoveDepersonalizedFile", new { sourceId = Model.Id, sourceType = SourceTypeSelectVM.CaseSessionActMotiveDepersonalized })" class="btn btn-danger" title="Премахване на обезличените мотиви"><i class="fa fa-remove"></i></a>
                                                    }
                                                }
                                            }
                                        </div>
                                    </div>
                                </fieldset>
                            }
                            @if (!activeRequest12024 && Model.ActDeclaredDate != null && ViewBag.hasCoordinationWithOpinion == true && canAccessFile && access.CanChange)
                            {
                                <div id="divCoordinationDepersonalization">
                                </div>
                            }
                        </div>
                        <div class="form-group">
                            @if (access.CanChange)
                            {
                                <input id="btnMainSubmit" type="submit" value="Запис" class="btn btn-success single-click-submit" />
                            }
                            &nbsp;
                            <a href="@Url.Action("Preview", "CaseSession", new { id = Model.CaseSessionId })#tabSessionAct" class="btn btn-danger">Назад</a>
                            @if (Model.Id > 0)
                            {
                                <span>&nbsp;</span>
                                @if (access.CanChange)
                                {
                                    if (!hasDefacedAct)
                                    {
                                        if (Model.ActDeclaredDate != null)
                                        {
                                            if (canCorrectAfterDeclare)
                                            {
                                                <a href="#" id="btnBlank" style="display:none;" onclick="editActBlank(); return false;" class="btn btn-warning">Корекция на акт</a>
                                            }
                                        }
                                        else
                                        {
                                            <a href="#" id="btnBlank" style="display:none;" onclick="editActBlank(); return false;" class="btn btn-primary">Изготвяне на акт</a>
                                        }
                                        @if (!string.IsNullOrEmpty(Model.RegNumber) || activeRequest12024)
                                        {
                                            if ((Model.ActDeclaredDate != null && canCorrectAfterDeclare) || Model.ActDeclaredDate == null)
                                            {
                                                <a href="#" id="btnBlankComplete" style="display:none;" onclick="editActBlankComplete(); return false;" class="btn btn-warning">Корекция на акт</a>
                                            }
                                        }
                                    }
                                }
                                @if (access.CanChange && hasDefacedBlank && !hasDefacedAct && canAccessDefaceAct)
                                {
                                    <span>&nbsp;</span>
                                    <a asp-action="DepersonalizeAct" asp-route-id="@Model.Id" class="btn btn-primary">Обезличаване на акт</a>
                                }
                                else
                                {
                                    if (hasDefacedAct && access.CanChangeFull)
                                    {
                                        <span>&nbsp;</span>
                                        <a onclick="confirmDelete(this,'act'); return false;" data-url="@Url.Action("RemoveDepersonalizedFile", new { sourceId = Model.Id, sourceType = SourceTypeSelectVM.CaseSessionActDepersonalized })" class="btn btn-danger" title="Премахване на обезличения акт"><i class="fa fa-remove"></i></a>
                                    }
                                }


                                if (ViewBag.isDivorce)
                                {
                                    <a asp-action="AddDivorce" asp-route-actId="@Model.Id" class="btn btn-primary">Изготвяне на съобщение</a>
                                }
                                if (ViewBag.isRegisterCompany)
                                {
                                    <a asp-action="AddCompany" asp-route-actId="@Model.Id" class="btn btn-primary">Вписване в ТРРЮЛНЦ</a>
                                }

                                if (Model.ActDeclaredDate == null && Model.DateExpired == null)
                                {
                                    @if (access.CanChangeFull)
                                    {
                                        <span>&nbsp;</span>
                                        @await Html.PartialAsync("_ExpiredInfoButton", new ExpiredInfoVM() { Id = Model.Id, DialogTitle = "Премахване на съдебен акт", ExpireSubmitUrl = Url.Action("Act_ExpiredInfo") })
                                    }
                                }
                                @if (Model.Id > 0)
                                {
                                    <div class="pull-right">
                                        @await Html.PartialAsync("_ShowLogOperation", new IOWebApplication.Core.Models.ShowLogModel() { ObjectKey = Model.Id.ToString(), IconOnly = true })
                                        &nbsp;
                                        <partial name="MqInfo" model="@(new SourceTypeSelectVM() { SourceType = SourceTypeSelectVM.CaseSessionAct, SourceId = Model.Id })" />
                                    </div>
                                }
                            }
                        </div>
                    </form>
                </div>
                @if (Model.Id > 0)
                {
                    <div class="col-lg-6">
                        <div class="cdn-files" data-label="Съдебен акт / протокол" data-sourcetype="@SourceTypeSelectVM.CaseSessionAct" data-sourceid="@Model.Id" data-editmode="none"></div>

                        <div class="cdn-files" data-label="Документи към съдебен акт / протокол" data-sourcetype="@SourceTypeSelectVM.CaseSessionActManualUpload" data-sourceid="@Model.Id" data-editmode="@(access.CanChange ? "edit" : "none")"></div>

                        @if (access.CanChange)
                        {


                            <fieldset class="is-fieldset">
                                <legend class="legend_1">
                                    Действия
                                </legend>
                                @if (quickViewEnabled)
                                {
                                    <a href="@Url.Action("QuickView", new { id = Model.Id })" class="btn btn-sm btn-warning" title="Преглед на акта преди регистриране." target="_blank">Преглед</a>
                                }
                                @if (showNoResultButton)
                                {
                                    <a href="@Url.Action("AddResult", "CaseSession", new { caseSessionId = Model.CaseSessionId, CallFromActId = Model.Id })" class="btn btn-sm btn-success" title="Отваря форма за въвеждане на резултат от проведено заседание.">Добави резултат</a>
                                }
                                @if (canRegisterAct)
                                {
                                    <a href="@Url.Action("RegisterAct", new { id = Model.Id })" class="btn btn-sm btn-primary" title="Регистрира акта с номер и дата.">Регистриране</a>
                                }
                                @if (Model.ActDeclaredDate == null)
                                {
                                    <a href="#" onclick="sendForSignCheck(this); return false;" class="btn btn-sm btn-success" title="Създава документа на акта и задачите за подпис на състава по заседанието">Изпращане за подпис</a>
                                }
                                else
                                {
                                    if (hasMotives && Model.ActMotivesDeclaredDate == null)
                                    {
                                        <a href="#" onclick="sendForSignMotivesCheck(this); return false;" class="btn btn-sm btn-success" title="Създава документа за мотивите към акта и задачите за подпис на състава по заседанието">Изпращане на мотиви за подпис</a>
                                    }
                                }
                                @if (ViewBag.nextActLabel != null && ViewBag.nextActUrl != null)
                                {
                                    <a href="@Html.Raw(ViewBag.nextActUrl)" class="btn btn-sm btn-warning">@ViewBag.nextActLabel</a>
                                }
                                <partial name="WorkTaskMyNew" model="@(new SourceTypeSelectVM(SourceTypeSelectVM.CaseSessionAct, Model.Id) { TaskRequired = true })" />
                            </fieldset>
                        }
                    </div>
                }
            </div>
        </div>
        <div class="tab-pane" id="tabWorkTask">
            <partial name="WorkTask" model="@(new SourceTypeSelectVM(SourceTypeSelectVM.CaseSessionAct, Model.Id) { TaskRequired = true })" />
        </div>
        <div class="tab-pane" id="tabCordination">
            <partial name="~/Views/CaseSessionActCoordination/_CaseSessionActCoordination.cshtml" model="@(new CaseMainDataVM() { CaseSessionActId = Model.Id })" />
        </div>
        <div class="tab-pane" id="tabDocTemplates">
            <partial name="~/Views/DocumentTemplate/_DocumentTemplate.cshtml" model="@(new SourceTypeSelectVM() { SourceType = SourceTypeSelectVM.CaseSessionAct, SourceId = Model.Id })" />
        </div>
    </div>
</div>

<partial name="_CdnScript" />

@section scripts {
    <script>
        $(document).ready(function () {
            $('.correct-act').hide();
            SH_ComplainResult();
            SH_ComplainIndex();
            SH_ActResult();
            SH_AppelFastProcess();
            SH_Notification();
            SH_ActNotification();
            SH_ActTerm();
            $('#btnBlank').hide();
            $('#btnBlankComplete').hide();
            SH_BlankButtons('');
            SH_CoordinationDepersonalization();

            initLawUnit();
            initUserAutoComplete();

            $('#IsFinalDoc').change(function () {
                SH_ComplainResult();
            });

            $('#CanAppeal').change(function () {
                SH_ActResult();
                SH_ComplainIndex();
                SH_AppelFastProcess();
            });

            $('#NotificationOn').change(function () {
                SH_Notification();
            });

            $('#ActNotificationOn').change(function () {
                SH_ActNotification();
            });

            $('#HasCorrectedAct').change(function () {
                if($(this).is(':checked')){
                    $('.correct-act').show();
                }else{
                    $('.correct-act').hide();
                }
            }).trigger('change');

            $('#CorrectedActsIds').select2({ language: "bg" });
            let s2Str = '@string.Join(',', Model.CorrectedActsIds)';
            $('#CorrectedActsIds').val(s2Str.split(",")).trigger('change');

        @if (Model.ActDeclaredDate == null)
        {
                                <text>
                                                                                                initSecretaryUser();
                                </text>
        }
                 });

        function initSecretaryUser() {
            $('#SecretaryUserId').select2({ language: "bg" });
            setTimeout(function () {
                $('#SecretaryUserId').val('@Model.SecretaryUserId_list'.split(',')).change();

            }, 250);
            $('#SecretaryUserId').change(function () {
                let s2Selection = $(this).val();
                if (s2Selection[s2Selection.length - 1] == "-1") {
                    appendSecretaryAllUsers();
                    return;
                }
                var str = '';
                if (s2Selection !== null && s2Selection.length > 0) {
                    str = s2Selection.join(',');
                }
                $('#SecretaryUserId_list').val(str);
            });
            $('#ActComplainIndexId').select2({ language: "bg" });
        }

        function SH_CoordinationDepersonalization() {
            if ($('#divCoordinationDepersonalization').length == 0) {
                return;
            }

            requestContent('@Url.Action("GetDepersonalizeCoordination")', { actId: @Model.Id}, function (html) {
                $('#divCoordinationDepersonalization').html(html);
            });
        }


        function SH_BlankButtons(processMode) {
            let _actKind = @(Model.ActKindId ?? 0);

            //Акт се изготвя само ако не е избрана специална бланка с Model.ActKindId или е Обезпечителна заповед
            if (_actKind <= 0 || processMode == 'blank_body_only') {
                $('#btnBlank').show();
                $('#btnBlankComplete').hide();
            } else {
                if (_actKind > 0) {
                    $('#btnBlank').hide();
                    $('#btnBlankComplete').show();
                }
            }
        }

        function editActBlank() {
            let editUrl = "@Url.Action("Blank", new { id = Model.Id })";
        @if (hasActPdf)
        {
                                <text>
                                                                                                swalConfirm('Има генериран файл на съдебен акт/протокол, който е в процес на съгласуване/подписване или е подписан! След промяна на съдържанието на съдебния акт/протокол е необходимо да създадете нова задача за подписване, за да се генерира нов файл на съдебния акт/протокол със същия номер.', function () {
                                                                                                    document.location.href = editUrl;
                                                                                                                                                        }, null, @(Model.ActDeclaredDate != null ? "true" : "false"));
                                </text>
        }
        else
        {
                                <text>document.location.href = editUrl; </text>
        }

                                                                                                                                                                                        }

        function editActBlankComplete() {
            let editUrl = "@Url.Action("BlankComplete", new { id = Model.Id })";
        @if (hasActPdf)
        {
                                <text>
                                                                                                swalConfirm('Има генериран файл на съдебен акт/протокол, който е в процес на съгласуване/подписване или е подписан! След промяна на съдържанието на съдебния акт/протокол е необходимо да създадете нова задача за подписване, за да се генерира нов файл на съдебния акт/протокол със същия номер.', function () {
                                                                                                    document.location.href = editUrl;
                                                                                                                                                        });
                                </text>
        }
        else
        {
                                <text>document.location.href = editUrl; </text>
        }
                                                                                                                                                                                        }

        function sendForSignCheck(sender) {
            if ($(sender).attr('disabled')) {
                return;
            }
            $(sender).attr('disabled', 'disabled');
            let editUrl = "@Url.Action("SentForSign", new { actId = Model.Id })";
        @if (Model.RegDate != null)
        {
                                <text>
                                                                                                swalConfirm('Вече има регистриран съдебен акт/протокол, който е в процес на съгласуване/подписване или е подписан! Ако го изпратите отново за подпис ще се генерира нов файл за съдебния акт/протокол със същия номер и ще се създадат нови задачи за подпис.', function () {
                                                                                                    document.location.href = editUrl;
                                                                                                                                                        }, function () {
                                                                                                    $(sender).removeAttr('disabled');
                                                                                                                                                        });
                                </text>
        }
        else
        {
                                <text>
                                                                                                setTimeout(function () {
                                                                                                    document.location.href = editUrl;
                                                                                                                                                        }, 200);
                                </text>
        }
                                                                                                                                                                                        }

        function sendForSignMotivesCheck(sender) {
            if ($(sender).attr('disabled')) {
                return;
            }
            $(sender).attr('disabled', 'disabled');
            let editUrl = "@Url.Action("SentForSignMotives", new { actId = Model.Id })";
        @if (ViewBag.hasMotives == true)
        {
                                <text>
                                                                                                swalConfirm('Вече създаден документ за мотиви, който е в процес на подписване или е подписан! Ако го изпратите отново за подпис ще се генерира нов файл за мотиви и ще се създадат нови задачи за подпис.', function () {
                                                                                                    document.location.href = editUrl;
                                                                                                                                                        }, function () {
                                                                                                    $(sender).removeAttr('disabled');
                                                                                                                                                        });
                                </text>
        }
        else
        {
                                <text>
                                                                                                setTimeout(function () {
                                                                                                    document.location.href = editUrl;
                                                                                                                                                        }, 200);
                                </text>
        }
                                                                                                                                                                                        }

        function SH_ComplainResult() {
            var isFinalDoc = $("#IsFinalDoc").is(":checked");
            if ((isFinalDoc) && ('@hasComplainResult' == 'True')) {
                $("#divComplainResult").show();
            }
            else {
                $("#divComplainResult").hide();
            }
        }

        function SH_ActResult() {
            var isCanAppeal = $("#CanAppeal").is(":checked");
            if (isCanAppeal) {
                $("#divActResult").show();
            }
            else {
                $("#divActResult").hide();
            }
        }

        function SH_ComplainIndex() {
            var isCanAppeal = $("#CanAppeal").is(":checked");
            if ((isCanAppeal) && ('@hasComplainIndex' == 'True')) {
                $("#divComplainIndex").show();
            }
            else {
                $("#divComplainIndex").hide();
            }
        }

        function SH_AppelFastProcess() {
            var isCanAppeal = $("#CanAppeal").is(":checked");
            if ((isCanAppeal) && ('@isFastProcess' == 'True')) {
                $("#divAppelFastProcess").show();
            }
            else {
                $("#divAppelFastProcess").hide();
            }
        }

        function SH_Notification() {
            var notificationOn = $("#NotificationOn").is(":checked");
            if ((notificationOn) && ('@isFastProcess' == 'True')) {
                $("#divNotificationTerm").show();
            }
            else {
                $("#divNotificationTerm").hide();
            }
        }

        function SH_ActNotification() {
            var notificationOn = $("#ActNotificationOn").is(":checked");
            if ((notificationOn) && ('@isFastProcess' == 'True')) {
                $("#divActNotificationTerm").show();
                $("#divActNotificationDescTerm").show();
            }
            else {
                $("#divActNotificationTerm").hide();
                $("#divActNotificationDescTerm").hide();
            }
        }

        function SH_ActTerm() {
            var acttype = $("#ActTypeId").val();
            if ((acttype == @NomenclatureConstants.ActType.CommandmentProtection) || (acttype == @NomenclatureConstants.ActType.CommandmentimmediatelyProtection)) {
                $("#divActTerm").show();
            }
            else {
                $("#divActTerm").hide();
            }
        }

        $(function () {
            $('select#ActTypeId').change(function () {
                requestCombo('@Url.Action("Get_ActKindsByActType")', { actTypeId: $(this).val(), caseId: @Model.CaseId }, 'select#ActKindId', '@Model.ActKindId', function (ddl) {
                    if ($(ddl).find('option').length > 1) {
                        $('#divActKind').show();
                    } else {
                        $('#divActKind').hide();
                    }
                    SH_ActTerm();
                    $('select#ActKindId').trigger('change');
                });
                let showSignJudge = '@NomenclatureConstants.ActType.HasSignJudge.ToJSstring()';
                if (showSignJudge.indexOf('|' + $(this).val() + '|') >= 0) {
                    $('#divSignJudge').show();
                } else {
                    $('#divSignJudge').hide();
                }
                if($(this).val() == '@NomenclatureConstants.ActType.ExecListPrivatePerson' ||
                    $(this).val() == '@NomenclatureConstants.ActType.ExecListForState'){
                    $('#divGenerateExecProcess').show();
                }else{
                    $('#divGenerateExecProcess').hide();
                }
                let _isEdit = '@(Model.Id == 0)';

                if (_isEdit == 'True') {
                    let defFinalActs = JSON.parse('@NomenclatureConstants.ActType.FinalByDefaultStr');
                    let isFinal = false;
                    for (var i = 0; i < defFinalActs.length; i++) {
                        if (defFinalActs[i] == $(this).val()) {
                            isFinal = true;
                        }
                    }
                    if (isFinal) {
                        $('#IsFinalDoc').prop("checked", true);
                    } else {
                        $('#IsFinalDoc').prop("checked", false);
                    }
                    let defFinalAppealActs = JSON.parse('@NomenclatureConstants.ActType.AppealByDefaultStr');
                    let isFinalAppeal = false;
                    for (var i = 0; i < defFinalActs.length; i++) {
                        if (defFinalAppealActs[i] == $(this).val()) {
                            isFinalAppeal = true;
                        }
                    }

                    if (isFinalAppeal) {
                        $('#CanAppeal').prop("checked", true);
                        if ('@hasActComplainResultRespect' == 'True')
                            $('#ActComplainResultId').val('@NomenclatureConstants.ActComplainResults.Respect');
                        else
                            $('#ActComplainResultId').val(0);
                    } else {
                        $('#CanAppeal').prop("checked", false);
                        $('#ActComplainResultId').val(0);
                    }
                    SH_ComplainResult();
                }
            }).trigger('change');
            $('select#ActStateId').change(function () {
                if ($(this).val() == '@NomenclatureConstants.SessionActState.ComingIntoForce') {
                    $('#divInforcedDate').show();
                } else {
                    $('#divInforcedDate').hide();
                }
            }).trigger('change');
            $('select#ActKindId').change(function () {
                requestGET_Json('@Url.Action("Get_ActKindInfo")', { actKindId: $(this).val() }, function (data) {
                    if (data) {
                        if (data.mustSelectRelatedAct == true) {
                            $('#divRelatedAct').show();
                        } else {
                            $('#divRelatedAct').hide();
                        }

                        if (data.actDirection == true) {
                            $('#divActDirection').show();
                        } else {
                            $('#divActDirection').hide();
                        }

                        SH_BlankButtons(data.processType);
                    } else {
                        $('#divRelatedAct').hide();
                    }
        @if (autoSave)
        {
                                <text>
                                                                                                        setTimeout(function () {$('#mainForm').trigger('submit'); }, 500);

                                </text>
        }
                                                                                                                                                                                                });
            });

            $('div.disable-controls').find('select,input').attr('disabled', 'disabled');

            var url = document.location.toString();
            if (url.match('#')) {
                $('.nav-tabs a[href="#' + url.split('#')[1] + '"]').tab('show');
            }

            // Change hash for page-reload
            $('.nav-tabs a').on('shown.bs.tab', function (e) {
                window.location.hash = e.target.hash;
            })
        });
        function confirmDelete(sender, source) {
            let confirmText = '';
            switch (source) {
                case 'act':
                    confirmText = "Потвърди премахването на обезличения акт.";
                    break;
                case 'motive':
                    confirmText = "Потвърди премахването на обезличените мотиви.";
                    break;
                case 'coordination':
                    confirmText = "Потвърди премахването на особеното мнение.";
                    break;
            }
            swalConfirm(confirmText, function () {
                document.location.href = $(sender).data('url');
            });
        }
        function appendSecretaryAllUsers() {
            requestGET_Json('@Url.Action("GetAllUsers")', {}, function (users) {
                $('#SecretaryUserId').empty();
                for (let i = 0; i < users.length; i++) {
                    $("#SecretaryUserId").append(new Option(users[i].text, users[i].value, false, false));
                }
                $('#SecretaryUserId').val($("#SecretaryUserId_list").val().split(',')).change();
                $("#SecretaryUserId").select2("open");
            })
        }
    </script>
}
