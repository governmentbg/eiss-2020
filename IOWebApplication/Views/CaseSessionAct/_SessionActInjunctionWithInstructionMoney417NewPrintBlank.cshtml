@model CaseSessionActCommandVM
@using IOWebApplication.Infrastructure.Constants
@using IOWebApplication.Infrastructure.Contracts
@using IOWebApplication.Infrastructure.Extensions
@using IOWebApplication.Infrastructure.Models.ViewModels.Case
@inject IUserContext userContext
@{
    Layout = null;
}

<style>
    div.just {
    text-align: justify;
    text-justify: inter-word;
    text-rendering: geometricPrecision;
    }
</style>

<div style="font-family: 'Times New Roman'">
    <center>
        @if (!userContext.IsSystemInFeature(NomenclatureConstants.SystemFeatures.Request1_2024))
        {
            <b>Разпореждане № @Model.CaseSessionActPrint.ActRegNumber</b><br />
        }
        else
        {
            <b>РАЗПОРЕЖДАНЕ</b><br />
        }
        <b>ЗА ИЗПЪЛНЕНИЕ НА ПАРИЧНО ЗАДЪЛЖЕНИЕ</b><br />
        <b>ВЪЗ ОСНОВА НА ДОКУМЕНТ</b><br />
        <b>по чл. 417 ГПК</b><br />
        @if (!userContext.IsSystemInFeature(NomenclatureConstants.SystemFeatures.Request1_2024))
        {
            <p>@Model.CaseSessionActPrint.CourtCity, @Model.CaseSessionActPrint.SessionDate.ToString("dd.MM.yyyy") г.</p><br />
        }
        else
        {
            <p>гр. @Model.CaseSessionActPrint.CourtCity</p><br />
        }
    </center>
    <div class="just">
        @Model.CaseSessionActPrint.CourtName, @Model.CaseSessionActPrint.DepartmentName в проведеното на @Model.CaseSessionActPrint.SessionDate.ToString("dd.MM.yyyy") г. закрито разпоредително заседание по @Model.CaseSessionActPrint.CaseTypeName.ToLower() № @Model.CaseSessionActPrint.CaseRegShortNumber по описа на съда за @Model.CaseSessionActPrint.CaseRegYear г., докладвано от @Model.CaseSessionActPrint.JudgeReporter – районен съдия, разгледа подаденото заявление за издаване на заповед за изпълнение по реда на чл. 417 и 418 ГПК и след като прецени@(!string.IsNullOrEmpty(Model.CaseSessionActPrint.RelatedActTypeName) ? " с " + Model.CaseSessionActPrint.RelatedActTypeName + " № " + Model.CaseSessionActPrint.RelatedActNumber + "/" + Model.CaseSessionActPrint.RelatedActYear + " г." : string.Empty), че са налице предпоставките за уважаване на искането за допускане на незабавно изпълнение, на основание чл. 418 ГПК<br />
    </div>
    <br />

    @if (Model.JointDistribution)
    {
        @Html.Raw("<div class='just'>");
        @Html.Raw(Model.CaseSessionActPrint.LeftWithOutRoleRightSide_410_417 + ", " + Model.SumJointDistribution + "<br />");
        @Html.Raw("</div>");
        <br />
        <br />
    }

    @if (!Model.JointDistribution)
    {
        @if (Model.SumIsNotJointDistribution.Length > 0)
        {
            @foreach (var sumPerson in Model.SumIsNotJointDistribution)
            {
                @Html.Raw("<div class='just'>");
                @Html.Raw(sumPerson + " <br />");
                @Html.Raw("</div>");
                <br />
            }
        }
        <br />
    }

    @if (Model.FastProcessRequest != null)
    {
        @if (Model.FastProcessRequest.ItemSubstitutionClaims != null && Model.FastProcessRequest.ItemSubstitutionClaims.Count() > 0)
        {
            @Html.Raw("и да върне:<br />");
            @Html.Raw("<div class='just'>");
            @foreach (var item in Model.FastProcessRequest.ItemSubstitutionClaims)
            {
                @Html.Raw($"{item.TypeName} {item.QuantityText} {(Model.IsInEuro ? item.TotalAmountEUR.ToString("### ### ##0.00") + " EUR" : item.TotalAmountBGN.ToString("### ### ##0.00") + " BGN")}");
                <br />
            }
            @Html.Raw("</div>");
            <br />
            <br />
        }

        @if (Model.FastProcessRequest.ItemClaim != null && !string.IsNullOrEmpty(Model.FastProcessRequest.ItemClaim.Description))
        {
            @Html.Raw("и да върне:<br />");
            @Html.Raw("<div class='just'>");
            @Html.Raw($"{Model.FastProcessRequest.ItemClaim.Description} на стойност {(Model.IsInEuro ? Model.FastProcessRequest.ItemClaim.TotalAmountEUR.ToString("### ### ##0.00") + " EUR" : Model.FastProcessRequest.ItemClaim.TotalAmountBGN.ToString("### ### ##0.00") + " BGN")}");
            @Html.Raw("</div>");
            <br />
            <br />
        }

        @if (Model.JointDistribution)
        {
            @if (Model.FastProcessRequest.Expenses.Any())
            {
                @Html.Raw("<div class='just'>");
                @Html.Raw("Претендират се и направените в производството разноски за заплатена/заплатени:")
                <br />
                @foreach (var expence in Model.FastProcessRequest.Expenses)
                {
                    string _row = $"{expence.Index + 1}. {Model.getNomenclature(NomenclatureConstants.FPaliases.FP_ExpenseTypes, expence.ExpenseTypeCode)} в размер на: {"<b>" + (Model.IsInEuro ? expence.TotalAmountEUR.ToString("### ### ##0.00") + " EUR" : expence.TotalAmountBGN.ToString("### ### ##0.00") + " BGN") + "</b>"}";
                    @Html.Raw(_row);
                    <br />
                }
                @Html.Raw("</div>");
                <br />
                <br />
            }
        }

    }

    <div class='just'>
    &nbsp;&nbsp;Съдът, вземайки предвид отправеното искане и представените със заявлението писмени доказателства, съобразявайки се с нормата на чл. 417, т. 2 и чл. 418, ал. 1 ГПК, намира следното:<br />
    &nbsp;&nbsp;Налице е редовен от външна страна документ, удостоверяващ подлежащо на изпълнение вземане срещу длъжника, на следващо място подаденото заявление отговаря на изискванията за редовност по смисъла на чл. 410, ал. 2 във вр. чл. 127, ал. 1 и 3 и чл. 128, т. 1 и 2 ГПК, както и липсват данни за визираните в разпоредбата на чл. 411, ал. 2, т. 2, 3 и 4 ГПК отрицателни предпоставки, поради което съдът намира, че на заявителя следва да бъде издадена заповед за изпълнение въз основа на документ, постановявайки незабавното й изпълнение и издаване на изпълнителен лист.<br />
    &nbsp;&nbsp;В полза на заявителя следва да бъдат присъдени и сторените разноски. На основание чл. 26 от НЗПП следва да бъде определено юрисконсултско възнаграждение в размер на 50.00 лева.<br />
    &nbsp;&nbsp;Воден от горното, съдът<br />
    </div>

    <center>
        <b>РАЗПОРЕДИ:</b><br />
    </center>
    <br />

    @{
        string _polza = " <b>срещу длъжника</b> ";
        if (Model.CaseSessionActPrint.RightSide_410_417_Count > 1)
            _polza = " <b>срещу длъжниците</b> ";

        string _zaiavitel = " заявителя ";
        @if (Model.CaseSessionActPrint.LeftSide_410_417_Count > 1)
            _zaiavitel = " заявители ";

        @Html.Raw("<div class='just'>");
        @Html.Raw("<b>ДА СЕ ИЗДАДЕ</b> заповед за незабавно изпълнение на парично задължение по реда на чл. 417 ГПК <b>в полза на</b>" + _zaiavitel + Model.CaseSessionActPrint.LeftSidesWithAddress + _polza + Model.CaseSessionActPrint.RightSidesWithAddress + ", съгласно която");
        @Html.Raw("</div>");
        <br />
    }

    <br />

    @if (Model.JointDistribution)
    {
        string _row = Model.CaseSessionActPrint.LeftWithOutRoleRightSide_410_417 + ", " + Model.SumJointDistributionWithoutPoint + (!string.IsNullOrEmpty(Model.FastProcessRequestExpenses) ? ", както и направените в производството разноски за: " + Model.FastProcessRequestExpenses + "." : string.Empty) + "<br />";
        @Html.Raw("<div class='just'>");
        @Html.Raw(_row);
        @Html.Raw("</div>");
        <br />
    }

    @if (!Model.JointDistribution)
    {
        @if (Model.SumIsNotJointDistribution.Length > 0)
        {
            @foreach (var sumPerson in Model.SumIsNotJointDistribution)
            {
                @Html.Raw("<div class='just'>")
                @Html.Raw(sumPerson + " <br />");
                @Html.Raw("</div>")
                <br />
            }
        }
        <br />
    }

    <br />
    &nbsp;&nbsp;<b>ПОСТАНОВЯВА</b> незабавно изпълнение на заповедта за изпълнение, на основание чл. 418, ал. 1 ГПК.<br />
    &nbsp;&nbsp;<b>ДА СЕ ИЗДАДЕ</b> на заявителя изпълнителен лист, незабавно след издаването на заповед за изпълнение. В случай че документът е по чл. 417, ал. 1, т. 3, 6 или 10 ГПК, върху оригинала му <b>ДА СЕ НАПРАВИ</b> отбелязване по чл. 406, ал. 3 ГПК и в електронната папка на делото в ЕИСС да се присъедини електронен образ на документа с отбелязването.<br />
    &nbsp;&nbsp;<b>ДА СЕ ПРЕДОСТАВИ</b> на основание чл. 418, ал. 4 и 6 ГПК чрез заявителя достъп на съдебните изпълнители до електронната партида, до заповедта за изпълнение и до документа, въз основа на който тя е издадена, с отбелязването за издаден изпълнителен лист, когато има такова.<br />
    &nbsp;&nbsp;В случай че изпълнителният лист е издаден на хартиен носител, получаването му <b>ДА СЕ УДОСТОВЕРИ</b> писмено с дата и подпис на заявителя и на деловодителя.<br />
    &nbsp;&nbsp;<b>РАЗПОРЕЖДАНЕТО</b>, в частта за допускане на незабавно изпълнение, подлежи на обжалване с частна жалба в едномесечен срок от връчване на заповедта за изпълнение пред @(Model.CaseSessionActPrint.CourtParent).<br />
    &nbsp;&nbsp;<b>РАЗПОРЕЖДАНЕТО</b>, в частта за издаване на изпълнителен лист, подлежи на обжалване с частна жалба пред @(Model.CaseSessionActPrint.CourtParent) в двуседмичен срок, който за заявителя тече от връчването на разпореждането, а за длъжника – от връчването на поканата за доброволно изпълнение.<br />
   
    <center>
        <b>Указания:</b>
    </center>
    <br />
    <div class='just'>
    1.Издадената заповед за изпълнение да бъде изпратена за връчване на посочения в
    Заявлението за издаване на заповед за изпълнение адрес.<br />
    2.В случай, че заповедта за изпълнение не бъде връчена на длъжника след като той е
    търсен на адреса по т. 1 в продължение на един месец, през който връчителят е извършил не
    по-малко от три посещения на адреса, с интервал от поне една седмица между всяко от тях,
    като най-малко едно от посещенията е в неприсъствен ден, и не е могъл да намери
    длъжника, както и не се е намерило лице, което е съгласно да получи съобщението, или
    когато връчителят е събрал данни, че длъжникът не живее на адреса, заповедта за
    изпълнение да бъде връчена чрез ЗАЛЕПВАНЕ на уведомление на вратата или на
    пощенската кутия, а когато до тях не е осигурен достъп - на входната врата или на видно
    място около нея, на всеки един на известните по делото адреси. Когато има достъп до
    пощенската кутия, връчителят да пусне уведомление и в нея.<br />
    3.В случай, че адреса по т. 1 НЕ СЪВПАДА с посочения в справката от НБД
    „Население“ НАСТОЯЩ адрес, издадената заповед за изпълнение да бъде изпратена за
    връчване на настоящия адрес.<br />
    В случай, че посоченият в заявлението адрес съвпада с настоящия адрес, да се
    изпълнят указанията в т. 5 на настоящето разпореждане.<br />
    В случай, че посоченият в заявлението адрес съвпада с настоящия и постоянния
    адрес, да се изпълнят указанията в т. 7 на настоящето разпореждане.<br />
    4.В случай, че заповедта за изпълнение не бъде връчена на длъжника, след като той е
    търсен на настоящия адрес в продължение на един месец, през който връчителят е извършил
    не по-малко от три посещения на адреса, с интервал от поне една седмица между всяко от
    тях, като най-малко едно от посещенията е в неприсъствен ден, и не е могъл да намери
    длъжника, както и не се е намерило лице, което е съгласно да получи съобщението, или
    когато връчителят е събрал данни, че длъжникът не живее на адреса, след справка от
    управителя на етажната собственост, от кмета на съответното населено място или по друг
    начин и е удостоверил това с посочване на лицето, което му е предоставило тези данни, с три
    имена в съобщението, заповедта за изпълнение да бъде връчена чрез ЗАЛЕПВАНЕ на
    уведомление на вратата или на пощенската кутия, а когато до тях не е осигурен достъп - на
    входната врата или на видно място около нея, на всеки един на известните по делото адреси.
    Когато има достъп до пощенската кутия, връчителят да пусне уведомление и в нея.<br />
    5.В случай, че длъжникът или друго упълномощено от него лице, или такова от кръга на
    домашните му не се е явило в канцеларията на съда в двуседмичен срок от залепване на
    уведомлението по настоящия адрес и този адрес НЕ СЪВПАДА с посочения в справката от
    НБД „Население“ ПОСТОЯНЕН адрес, издадената заповед за изпълнение да бъде изпратена
    за връчване на постоянния адрес.<br />
    6.В случай, че заповедта за изпълнение не бъде връчена на длъжника, след като той е
    търсен на постоянния адрес в продължение на един месец, през който връчителят е
    извършил не по-малко от три посещения на адреса, с интервал от поне една седмица между
    всяко от тях, като най-малко едно от посещенията е в неприсъствен ден, и не е могъл да
    намери длъжника, както и не се е намерило лице, което е съгласно да получи съобщението,
    или когато връчителят е събрал данни, че длъжникът не живее на адреса, след справка от
    управителя на етажната собственост, от кмета на съответното населено място или по друг
    начин и е удостоверил това с посочване на лицето, което му е предоставило тези данни, с три
    имена в съобщението, заповедта за изпълнение да бъде връчена чрез ЗАЛЕПВАНЕ на
    уведомление на вратата или на пощенската кутия, а когато до тях не е осигурен достъп - на
    входната врата или на видно място около нея, на всеки един на известните по делото адреси.
    Когато има достъп до пощенската кутия, връчителят да пусне уведомление и в нея.<br />
    7.В случай, че длъжникът или друго упълномощено от него лице, или такова от кръга на
    домашните му не се е явило в канцеларията на съда в двуседмичен срок от залепване на
    уведомлението по постоянния адрес да бъде направена „Справка трудови договори“ чрез
    модула „Справки във външни системи“ в ЕИСС.<br />
    8.В случай, че при извършената по т. 7 справка се установи, че длъжникът има
    действащи трудови договори, съобщение за връчване на заповедта за изпълнение да бъде
    изпратена за връчване по месторабота до всички работодатели, с които длъжника, видно от
    справката има действащи трудови договори.<br />
    9.В случай, че при извършване на справката по т. 7 се установи, че няма регистрирани
    действащи трудови договори, делото да се докладва на съдията докладчик.<br />
    10.Да се впише в Заповедта за изпълнение и следния текст: „Съдът указва на длъжника,
    че ако живее или замине за повече от един месец в чужбина, е длъжен да посочи лице в
    седалището на съда, на което да се връчват съобщенията - съдебен адресат, ако няма
    пълномощник по делото в Република България. Същото задължение имат законният
    представител, попечителят и пълномощникът на страната.<br />
    Съдът предупреждава длъжника, че ако не посочи съдебен адресат, всички съобщения
    се прилагат към делото и се смятат за връчени.<br />
    Съдът указва на длъжника, че когато отсъства повече от един месец от адреса, който е
    съобщил по делото или на който веднъж му е връчено съобщение, е длъжен да уведоми съда
    за новия си адрес. Същото задължение има и законният представител, попечителят и
    пълномощникът на страната.<br />
    Съдът предупреждава длъжника, че при неизпълнение на това задължение всички
    съобщения ще се прилагат към делото и ще се смятат за връчени.<br />
    Разпореждането не подлежи на обжалване.<br />
    </div>
    <br />
    <br />

    <div align="right">
        Районен съдия: ...............................................<br />
        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;( @Model.CaseSessionActPrint.JudgeReporter )
    </div>
</div>

