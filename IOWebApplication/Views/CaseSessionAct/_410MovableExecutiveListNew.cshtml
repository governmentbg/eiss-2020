@model CaseSessionActCommandVM
@using IOWebApplication.Infrastructure.Constants
@using IOWebApplication.Infrastructure.Contracts
@using IOWebApplication.Infrastructure.Extensions
@using IOWebApplication.Infrastructure.Models.ViewModels.Case
@inject IUserContext userContext
@{
    Layout = null;
}

<style>
    div.just {
        text-align: justify;
        text-justify: inter-word;
        text-rendering: geometricPrecision;
    }
</style>

<div style="font-family: 'Times New Roman'">
    <center>
        <partial name="_ExecListExecProcessInfo" model="@Model.CaseSessionActPrint" />
        <b>ИЗПЪЛНИТЕЛЕН ЛИСТ</b><br />
        <p>гр. @Model.CaseSessionActPrint.CourtCity</p><br />
        <b>В ИМЕТО НА НАРОДА</b><br />
    </center>
    <br />
    <div class="just">
        @Model.CaseSessionActPrint.CourtName, @Model.CaseSessionActPrint.DepartmentName на основание чл. 416, във връзка с чл. 410 от Гражданския процесуален кодекс, като констатира, че@(string.IsNullOrEmpty(Model.CaseSessionActPrint.RelatedActNumber) ? " " : " " + Model.CaseSessionActPrint.RelatedActTypeName + " № " + Model.CaseSessionActPrint.RelatedActNumber + "/" + Model.CaseSessionActPrint.RelatedActYear + " ")по @Model.CaseSessionActPrint.CaseTypeName № @Model.CaseSessionActPrint.CaseRegNumber/@Model.CaseSessionActPrint.CaseRegYear по описа на @Model.CaseSessionActPrint.CourtName, @Model.CaseSessionActPrint.DepartmentName подлежи на изпълнение, разпореди да се издаде следния<br />
    </div>
    <br />
    <center>
        <b>ИЗПЪЛНИТЕЛЕН ЛИСТ</b><br />
    </center>
    <br />

    @if (Model.CaseSessionActPrint.LeftSide.Any())
    {
        string _row = string.Empty;
        if (Model.CaseSessionActPrint.RightSide.Count() > 1)
        {
            _row = ", да предадат на ";
        }
        else
        {
            _row = ", да предаде на ";
        }

        @Html.Raw("<div class='just'>");
        @Html.Raw("Осъжда " + string.Join(" и ", Model.CaseSessionActPrint.RightSide) + " " + _row + string.Join(" и ", Model.CaseSessionActPrint.LeftSide) + "<br />");
        @Html.Raw("</div>");
        <br />
    }
    
    @if (Model.FastProcessRequest != null)
    {
        @if (Model.FastProcessRequest.ItemSubstitutionClaims != null && Model.FastProcessRequest.ItemSubstitutionClaims.Count() > 0)
        {
            @Html.Raw("следната/те вещ/и:<br />");
            int _number = 0;
            @Html.Raw("<div class='just'>");
            @foreach (var item in Model.FastProcessRequest.ItemSubstitutionClaims)
            {
                _number++;
                @Html.Raw($"{_number}. {item.TypeName} {item.QuantityText}, в размер на {"<b>" + (Model.IsInEuro ? item.TotalAmountEUR.ToString("### ### ##0.00") + " EUR" : item.TotalAmountBGN.ToString("### ### ##0.00") + " BGN") + "</b>"}");
                <br />
            }
            @Html.Raw("</div>");
        }

        @if (Model.FastProcessRequest.ItemClaim != null && !string.IsNullOrEmpty(Model.FastProcessRequest.ItemClaim.Description))
        {
            @Html.Raw("следната/те вещ/и:<br />");
            @Html.Raw("<div class='just'>");
            @Html.Raw($"{Model.FastProcessRequest.ItemClaim.Description} на стойност {"<b>" + (Model.IsInEuro ? Model.FastProcessRequest.ItemClaim.TotalAmountEUR.ToString("### ### ##0.00") + " EUR" : Model.FastProcessRequest.ItemClaim.TotalAmountBGN.ToString("### ### ##0.00") + " BGN") + "</b>"}");
            @Html.Raw("</div>");
            <br />
        }
        <br />
        <br />

        @if (Model.FastProcessRequest.Expenses.Any())
        {
            @if (Model.CaseSessionActPrint.RightSide.Any())
            {
                string _row = string.Empty;
                @if (Model.CaseSessionActPrint.RightSide.Count() > 1)
                {
                    _row = " да заплатят, следните разноски на ";
                }
                else
                {
                    _row = " да заплати, следните разноски на ";
                }

                @Html.Raw("<div class='just'>")
                @Html.Raw("Осъжда " + string.Join(" и ", Model.CaseSessionActPrint.RightSide) + _row + string.Join(" и ", Model.CaseSessionActPrint.LeftSide) + "<br />")
                @Html.Raw("</div>")
            }

            @foreach (var expence in Model.FastProcessRequest.Expenses)
            {
                string _row = $"{expence.Index + 1}. {Model.getNomenclature(NomenclatureConstants.FPaliases.FP_ExpenseTypes, expence.ExpenseTypeCode)} в размер на: {"<b>" + (Model.IsInEuro ? expence.TotalAmountEUR.ToString("### ### ##0.00") + " EUR" : expence.TotalAmountBGN.ToString("### ### ##0.00") + " BGN") + "</b>"}";
                @Html.Raw(_row);
                <br />
            }
            <br />
        }
    }

    <b>Този изпълнителен лист се издава в полза на</b><br />
    @Html.Raw("<div class='just'>")
    @Html.Raw(string.Join(" и ", Model.CaseSessionActPrint.LeftSide) + "<br />")
    @Html.Raw("</div>")
    <br />
    <b>Задължават се органите на държавното управление да оказват съдействие на съдебния изпълнител за привеждане в изпълнение на изпълнителния лист.</b>
    <br />
    <br />
    @if (Model.GenerateExecProcess)
    {
        <div align="right">
            <b>Изпълнителният лист е подписан с квалифициран електронен подпис от съдия:</b><br />
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;( @Model.CaseSessionActPrint.JudgeReporter )
        </div>
    }
    else
    {
        <div align="right">
            Районен съдия: ...............................................<br />
            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;( @Model.CaseSessionActPrint.JudgeReporter )
        </div>
    }
</div>

