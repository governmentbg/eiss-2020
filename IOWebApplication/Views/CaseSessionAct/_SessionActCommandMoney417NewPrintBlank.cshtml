@model CaseSessionActCommandVM
@using IOWebApplication.Infrastructure.Constants
@using IOWebApplication.Infrastructure.Contracts
@using IOWebApplication.Infrastructure.Extensions
@using IOWebApplication.Infrastructure.Models.ViewModels.Case
@inject IUserContext userContext
@{
    Layout = null;
}

<style>
    div.just {
        text-align: justify;
        text-justify: inter-word;
        text-rendering: geometricPrecision;
    }
</style>

<div style="font-family: 'Times New Roman'">
    <center>
        <b>ЗАПОВЕД</b><br />
        <b>ЗА ИЗПЪЛНЕНИЕ НА ПАРИЧНО ЗАДЪЛЖЕНИЕ</b><br />
        <b>ВЪЗ ОСНОВА НА ДОКУМЕНТ</b><br />
        <b>по чл. 417 ГПК</b><br />
        <p>гр. @Model.CaseSessionActPrint.CourtCity</p><br />
        <br />
    </center>
    <div class="just">
        @Model.CaseSessionActPrint.CourtName, @Model.CaseSessionActPrint.DepartmentName в проведеното на @Model.CaseSessionActPrint.SessionDate.ToString("dd.MM.yyyy") г. закрито разпоредително заседание по @Model.CaseSessionActPrint.CaseTypeName.ToLower() № @Model.CaseSessionActPrint.CaseRegShortNumber по описа на съда за @Model.CaseSessionActPrint.CaseRegYear г., докладвано от @Model.CaseSessionActPrint.JudgeReporter – районен съдия, като разгледа подаденото заявление за издаване на заповед за изпълнение по реда на чл. 417 и 418 ГПК и след като прецени@(!string.IsNullOrEmpty(Model.CaseSessionActPrint.RelatedActTypeName) ? " с " + Model.CaseSessionActPrint.RelatedActTypeName.ToLower() + " № " + Model.CaseSessionActPrint.RelatedActNumber + "/" + Model.CaseSessionActPrint.RelatedActYear + " г." : string.Empty), че са налице предпоставките за уважаване на искането за допускане на незабавно изпълнение, на основание чл. 418 ГПК<br />
    </div>
    <br />
    <center>
        <b>РАЗПОРЕЖДА:</b><br />
    </center>
    <br />

    @if (Model.JointDistribution)
    {
        string _row = Model.CaseSessionActPrint.LeftWithOutRoleRightSide_410_417 + ", " + Model.SumJointDistributionWithoutPoint + (!string.IsNullOrEmpty(Model.FastProcessRequestExpenses) ? ", както и направените в производството разноски за: " + Model.FastProcessRequestExpenses + "." : string.Empty) + "<br />";
        @Html.Raw("<div class='just'>");
        @Html.Raw(_row);
        @Html.Raw("</div>");
        <br />
        <br />
    }

    @if (!Model.JointDistribution)
    {
        @if (Model.SumIsNotJointDistribution.Length > 0)
        {
            @* @Html.Raw("Сумите се разделят както следва:" + " <br />"); *@
            @foreach (var sumPerson in Model.SumIsNotJointDistribution)
            {
                @Html.Raw("<div class='just'>");
                @Html.Raw(sumPerson + " <br />");
                @Html.Raw("</div>");
                <br />
            }
        }
        <br />
    }

    @if (Model.FastProcessRequest != null)
    {
        @if (Model.FastProcessRequest.ItemSubstitutionClaims != null && Model.FastProcessRequest.ItemSubstitutionClaims.Count() > 0)
        {
            @Html.Raw("и да върне:<br />");
            @Html.Raw("<div class='just'>");
            @foreach (var item in Model.FastProcessRequest.ItemSubstitutionClaims)
            {
                @Html.Raw($"{item.TypeName} {item.QuantityText} {(Model.IsInEuro ? item.TotalAmountEUR.ToString("### ### ##0.00") + " EUR" : item.TotalAmountBGN.ToString("### ### ##0.00") + " BGN")}");
                <br />
            }
            @Html.Raw("</div>");
            <br />
            <br />
        }

        @if (Model.FastProcessRequest.ItemClaim != null && !string.IsNullOrEmpty(Model.FastProcessRequest.ItemClaim.Description))
        {
            @Html.Raw("и да върне:<br />");
            @Html.Raw("<div class='just'>");
            @Html.Raw($"{Model.FastProcessRequest.ItemClaim.Description} на стойност {(Model.IsInEuro ? Model.FastProcessRequest.ItemClaim.TotalAmountEUR.ToString("### ### ##0.00") + " EUR" : Model.FastProcessRequest.ItemClaim.TotalAmountBGN.ToString("### ### ##0.00") + " BGN")}");
            @Html.Raw("</div>");
            <br />
            <br />
        }

        @if (!string.IsNullOrEmpty(Model.FastProcessRequest.ClaimCircumstances.Number) ||
             !string.IsNullOrEmpty(Model.FastProcessRequest.ClaimCircumstances.Description) ||
             (Model.FastProcessRequest.CededClaim == 1 && !string.IsNullOrEmpty(Model.FastProcessRequest.CededClaimDescription)))
        {
            @Html.Raw("<div class='just'>");
            if (!string.IsNullOrEmpty(Model.FastProcessRequest.ClaimCircumstances.Number))
            {
                string _row1 = $"Вземането произтича от следните обстоятелства: {Model.getNomenclature(NomenclatureConstants.FPaliases.FP_ClaimCircumstances, Model.FastProcessRequest.ClaimCircumstances.ClaimCircumstancesCode)} № {Model.FastProcessRequest.ClaimCircumstances.Number}{(Model.FastProcessRequest.ClaimCircumstances.Date.HasValue ? " от дата " + Model.FastProcessRequest.ClaimCircumstances.Date.ConvertDateTimeToString() + "г." : string.Empty)}:";
                @Html.Raw(_row1);
            }
            else
            {
                string _row1 = $"Вземането произтича от следните обстоятелства:";
                @Html.Raw(_row1);
            }
            @if (!string.IsNullOrEmpty(Model.FastProcessRequest.ClaimCircumstances.Description))
            {
                string _row2 = $"{Model.FastProcessRequest.ClaimCircumstances.Description}.";
                @Html.Raw("&nbsp;&nbsp;" + _row2);
            }
            @Html.Raw("</div>")
            @if (Model.FastProcessRequest.CededClaim == 1 && !string.IsNullOrEmpty(Model.FastProcessRequest.CededClaimDescription))
            {
                string _row = $"Уточнения относно цедирано вземане: {Model.FastProcessRequest.CededClaimDescription}.";
                @Html.Raw("<div class='just'>");
                @Html.Raw("&nbsp;&nbsp;" + _row);
                @Html.Raw("</div>");
            }
            <br />
            <br />
        }

        @Html.Raw("<div class='just'>");
        @if (!string.IsNullOrEmpty(Model.FastProcessRequest.BankAccount.IBAN))
        {
            string _currency = Model.FastProcessRequest.BankAccount.CurrencyCode != "-1" ? $"валута на сметката: {Model.FastProcessRequest.BankAccount.CurrencyCode}, " : string.Empty;
            string _row = $"Присъдената сума може да бъде внесена по следната банкова сметка на титуляр {Model.FastProcessRequest.BankAccount.OwnerNames} IBAN: {Model.FastProcessRequest.BankAccount.IBAN}, {_currency}име на банката (BIC) или друг подходящ банков код: {Model.FastProcessRequest.BankAccount.BankName}";
            @Html.Raw(_row);
        }
        else
        {
            string _row = $"&nbsp;&nbsp; Присъдената сума може да бъде платена по друг начин: {Model.FastProcessRequest.BankAccount.OtherPaymentDescription}";
            @Html.Raw(_row);
        }
        @Html.Raw("</div>");
        <br />
        <br />

        @* @if (Model.CaseFastProcessView.FastProcessVM.VisibleOrder ?? true)
        {
            <br />
            @Html.Raw("<div class='just'>");
            @Html.Raw("II. ДОПУСКА незабавно изпълнение на настоящата заповед на осн. чл. 418, ал. 1 ГПК.");
            <br />
            @Html.Raw("III. ДА СЕ ИЗДАДЕ на заявителя изпълнителен лист въз основа на настоящата заповед. В случай че документът е по чл. 417, ал. 1, т. 3, 6 или 10 ГПК, върху оригинала му ДА СЕ НАПРАВИ отбелязване по чл. 406, ал. 3 ГПК и в електронната папка на делото в ЕИСС да се присъедини електронен образ на документа с отбелязването.");
            <br />
            @Html.Raw("ІV. ДА СЕ ПРЕДОСТАВИ на основание чл. 418, ал. 4 и 6 ГПК чрез заявителя достъп на съдебните изпълнители до електронната партида, до заповедта за изпълнение и до документа, въз основа на който тя е издадена, с отбелязването за издаден изпълнителен лист, когато има такова.");
            <br />
            @Html.Raw("V. В случай че изпълнителният лист е издаден на хартиен носител, получаването му ДА СЕ УДОСТОВЕРИ писмено с дата и подпис на заявителя и на деловодителя.");
            @Html.Raw("</div>");
            <br />
            <br />
        } *@
    }

    <center>
        <b>ВАЖНА ИНФОРМАЦИЯ ЗА ДЛЪЖНИКА</b>
    </center>
    <br />
    <div class='just'>
    1. Предоставя Ви се възможност в едномесечен срок:<br />
    &nbsp;&nbsp;1.1. Да подадете възражение по чл. 414 ГПК по образец, приложен към заповедта, че не дължите изпълнение на вземането по издадената заповед за изпълнение. Ако оспорвате само част от претенцията, следва да посочите тази част във възражението, в противен случай заявителят може да предяви иск за цялото вземане. Възражението може да бъде подадено писмено на хартиен носител до който и да е районен съд или в електронна форма чрез Единния портал за електронно правосъдие. В случай че възражението е неоснователно, може да понесете разноски в по-висок размер от посочения в заповедта.<br />
    &nbsp;&nbsp;1.2. Да платите сумата, посочена в настоящата заповед, и да подадете възражение по чл. 414а ГПК по образец, приложен към заповедта, за изпълнение изцяло или частично на задължението Ви. Ако с поведението си не сте дали повод за предявяване на вземането, може да възразите, че не дължите разноски за производството. Към това възражение се прилагат доказателства за изпълнението на задължението с препис за заявителя.<br />
    2. Ако възражението бъде подадено в едномесечния срок, кредиторът може да предяви с иск вземането си срещу Вас. Ако иск не бъде предявен, заповедта няма да влезе в сила и ще бъде обезсилена.<br />
    3. Заповедта подлежи на незабавно изпълнение и въз основа на нея е издаден изпълнителен лист срещу Вас.<br />
    4. Подаването на писмено възражение до съда не спира изпълнението на заповедта. Изпълнението се спира само ако заповедта е издадена въз основа на запис на заповед, менителница или приравнена на тях друга ценна книга на заповед, както и облигация или купони по нея.<br />
    5. Принудителното изпълнение се спира, ако представите надлежно обезпечение пред съда по реда на чл. 180 и 181 от Закона за задълженията и договорите. Ако сте потребител, обезпечението е в размер до една трета от вземането.<br />
    6. Съдът може да спре изпълнението и без да е необходимо обезпечение, ако в срока за възражение представите писмени доказателства, че:<br />
    &nbsp;&nbsp;- вземането не се дължи;<br />
    &nbsp;&nbsp;- вземането се основава на неравноправна клауза в договор, сключен с потребител;<br />
    &nbsp;&nbsp;- неправилно е изчислен размерът на вземането по договор, сключен с потребител;<br />
    7. Съгласно чл. 41 ГПК ако длъжникът, неговият законен представител, попечител или пълномощник отсъства повече от един месец от адреса, който е съобщен по делото или на който веднъж му е връчено съобщение, той е длъжен да уведоми съда за новия си адрес. Такова задължение имате и когато е посочен електронен адрес за връчване. При неизпълнение на задължението за уведомяване на съда, както и при посочване на неверен или несъществуващ адрес, всички съобщения се прилагат към делото и се смятат за връчени.<br />
    8. Настоящата заповед е издадена въз основа на представен от кредитора документ, който е редовен от външна страна и удостоверява присъденото вземане. За издаването на изпълнителния лист съдът прави надлежна бележка върху представения в оригинал документ, която се отбелязва по електронната партида чрез Единния портал за електронно правосъдие. Препис от заповедта за изпълнение и копие от документа, въз основа на който е издадена заповедта за изпълнение с отбелязването за издаден изпълнителен лист, се връчва на длъжника от съдебния изпълнител.<br />
    9. Разпореждането за незабавно изпълнение подлежи на обжалване пред окръжен съд в едномесечен срок от връчването на заповедта. Частната жалба срещу разпореждането за незабавно изпълнение се подава заедно с възражението срещу издадената заповед.<br />
    10. Заповедта подлежи на обжалване пред @Model.CaseSessionActPrint.CourtParent само в частта за разноските в едноседмичен срок от връчването.<br />
    </div>
    <br />
    <br />
    <div align="right">
        Заповедта е подписана с квалифициран електронен подпис от районен съдия:<br />
        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;( @Model.CaseSessionActPrint.JudgeReporter )
    </div>
</div>

