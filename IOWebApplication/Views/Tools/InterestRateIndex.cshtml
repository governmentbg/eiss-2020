@model FilterInterestRate
@{
    ViewData["Title"] = "Лихвени проценти";
}

@section breadcrumb {
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")" title="Начало"><i class="fa fa-home"></i></a></li>
    </ol>
}

<div class="row">
    <div class="col-lg-3"> @Html.EditorFor(m => m.InterestType, "GenericDropDown")</div>
    <div class="col-lg-2">@Html.EditorFor(m => m.DateFrom, "DateTime")</div>
    <div class="col-lg-2">@Html.EditorFor(m => m.DateTo, "DateTime")</div>
</div>

<div class="row">
    <div class="col-md-6 text-left pb-15">
        <button type="button" class="btn btn-primary" id="btnFilter" onclick="refreshTable('#mainTable')" value="Филтриране" title="Филтриране">
            Филтриране
            <i class="fa fa-search" title="Търсене"></i>
        </button>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="row">
            <div class="col-md-12 text-right pb-15">
                <a href="#" onclick="addRate();return false;" class="btn btn-success btn-sm">
                    <i class="fa fa-plus"></i>
                    Добави
                </a>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <table id="mainTable" class="table table-hover table-striped"></table>
            </div>
        </div>

        <script>
            $(function(){
                var table = $('#mainTable').DataTable({
                    ajax: {
                        "url": "@Url.Action("InterestRate_LoadData", "Tools")",
                        "type": "POST",
                        "datatype": "json",
                        data: function (d) {
                           d.InterestType = $('#InterestType').val(),
                           d.DateFrom = $('#DateFrom').val(),
                           d.DateTo = $('#DateTo').val()
                        }
                    },
                   'order': [[0, 'desc']],
                    columns: [
                        {
                            name: 'date',
                            data: 'date',
                            title: 'Дата',
                            sortable: true,
                            searchable: true,
                            render: function (data) {
                                return moment(data).format("DD.MM.YYYY");
                            }
                        },
                        {
                            name: 'rate',
                            data: 'rate',
                            title: 'Процент',
                            sortable: true,
                            searchable: true
                        },
                        {
                            name: 'actions',
                            data: "id",
                            title: "",
                            sortable: false,
                            searchable: false,
                            className: "text-center noExport",
                            "render": function (value) {
                                return TemplateToHtml('#templateEdit', value);
                            }
                        }
                    ]
                });


            });

            function addRate(){
                let interestType = $('#InterestType').val();
                let url = `@Url.Action("InterestRateAdd", "Tools")?interestType=${interestType}`;
                document.location.href = url;
            }
        </script>

        <script id="templateEdit" type="text/x-handlebars-template">
            <a href="@Url.Action("InterestRateEdit", "Tools")?id={{this}}" class="btn btn-warning btn-sm m-b-5" title="Редакция"><i class="fa fa-edit"></i><span class="hidden-sm hidden-xs"></span></a>
        </script>



    </div>
</div>
