@using IOWebApplication.Infrastructure.Constants
@using IOWebApplication.Infrastructure.Models.ViewModels.Report
@model CaseFilterFastProcessVM

@{
    ViewData["Title"] = "Справка за дела по чл. 410 ГПК и чл. 417 ГПК";
    ViewData["ShowMenuCounts"] = true;
}

@section breadcrumb{
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index","Home")" title="Начало"><i class="fa fa-home"></i></a></li>
        <li class="active">@ViewData["Title"]</li>
    </ol>
}
<div class="filter-form">
    <div class="row">
        <div class="col-lg-3">@Html.EditorFor(m => m.CaseRegDateFrom, "DateTime")</div>
        <div class="col-lg-3">@Html.EditorFor(m => m.CaseRegDateTo, "DateTime")</div>
        <div class="col-lg-3">@Html.EditorFor(m => m.EpepDocumentRegDateFrom, "DateTime")</div>
        <div class="col-lg-3">@Html.EditorFor(m => m.EpepDocumentRegDateTo, "DateTime")</div>
    </div>
    <div class="row">
        <div class="col-lg-3">@Html.EditorFor(x => x.FastProcessRegNumber)</div>
        <div class="col-lg-3">@Html.EditorFor(x => x.RegNumber)</div>
        <div class="col-lg-3">@Html.EditorFor(x => x.DocumentRegNumEpep)</div>
        <div class="col-lg-3">@Html.EditorFor(x => x.ImporterPersonName)</div>
    </div>
    <div class="row">
        <div class="col-lg-3">@Html.EditorFor(x => x.CourtId, "GenericSelect2")</div>
        <div class="col-lg-3">@Html.EditorFor(x => x.CaseStateId, "GenericDropDown")</div>
    </div>

    <div class="row">
        <div class="col-md-6 text-left pb-15">
            <button type="button" class="btn btn-primary filter-button" id="btnFilter" onclick="LoadTable()" value="Филтриране" title="Филтриране">
                Филтриране
                <i class="fa fa-search" title="Търсене"></i>
            </button>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12 col-md-12">
        <table id="mainTable" class="table table-hover table-striped"></table>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            $('#CourtId').select2({ language: "bg" });
        });
    </script>
}

<script>
    function LoadTable() {
        if ($.fn.dataTable.isDataTable('#mainTable')) {
            refreshTable('#mainTable');
        }
        else {
            $('#mainTable').DataTable({
                ajax: {
                    "url": "@Url.Action("ListDataCaseFastProcess")",
                    "type": "POST",
                    "datatype": "json",
                    "data": function (d) {
                        d.filter = {
                            FastProcessRegNumber: $("#FastProcessRegNumber").val(),
                            RegNumber: $("#RegNumber").val(),
                            CourtId: $("#CourtId").val(),
                            CaseRegDateFrom: $("#CaseRegDateFrom").val(),
                            CaseRegDateTo: $('#CaseRegDateTo').val(),
                            EpepDocumentRegDateFrom: $('#EpepDocumentRegDateFrom').val(),
                            EpepDocumentRegDateTo: $("#EpepDocumentRegDateTo").val(),
                            ImporterPersonName: $("#ImporterPersonName").val(),
                            DocumentRegNumEpep: $("#DocumentRegNumEpep").val(),
                            CaseStateId: $("#CaseStateId").val()
                        };
                    }
                },
                filter:false,
                columns: [
                    {
                        name: 'documentRegNumValue',
                        data: 'documentRegNumValue',
                        title: 'Вх. номер',
                        sortable: true,
                        searchable: false,
                        "render": function (item, type, row, meta) {
                            return row.documentRegNum
                        }
                    },
                    {
                        name: 'caseRegNum',
                        data: 'caseRegNum',
                        title: 'Номер на дело',
                        "render": function (item, type, row, meta) {
                                var url = '@(Url.Action("CasePreview", "Case", new { id = 666 }))';
                                url = url.replace('666', row.caseId);
                                return "<a style='cursor: pointer;' data-toggle='tooltip' title='Преглед' href=" + url + ">" + row.caseRegNum + "</a>";
                        },
                        sortable: true,
                        searchable: true
                    },
                    {
                        name: 'caseCourtLabel',
                        data: 'caseCourtLabel',
                        title: 'Съд',
                        sortable: true,
                        searchable: false
                    },
                    {
                        name: 'caseCode',
                        data: 'caseCode',
                        title: 'Шифър',
                        sortable: true,
                        searchable: false
                    },
                    {
                        name: 'importerPersonFullName',
                        data: 'importerPersonFullName',
                        title: 'Заявител',
                        sortable: false,
                        searchable: true
                    },
                    {
                        name: 'documentRegNumEpep',
                        data: 'documentRegNumEpep',
                        title: 'Вх. номер от ЕПЕП',
                        sortable: true,
                        searchable: false
                    },
                    {
                        name: 'caseStateName',
                        data: 'caseStateName',
                        title: 'Статус на дело',
                        sortable: true,
                        searchable: true
                    },
                    {
                        name: 'actions',
                        data: "id",
                        title: "",
                        width: 100,
                        sortable: false,
                        searchable: false,
                        className: "text-center noExport",
                        "render": function (value) {
                            return TemplateToHtml('#templateEdit', value);
                        }
                    }
                ]
            }).order([[0, "asc"]]);
        }
    }
</script>

<script id="templateEdit" type="text/x-handlebars-template">
    <div class="row">
    </div>
</script>
