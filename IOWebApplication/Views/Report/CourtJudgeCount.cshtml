<div class="row">
    <div class="col-lg-12 col-md-12">
        <table id="mainTable" class="table table-hover table-striped"></table>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            LoadTable();
        });
    </script>
}

<script>
    function LoadTable() {
        if ($.fn.dataTable.isDataTable('#mainTable')) {
            refreshTable('#mainTable');
        }
        else {
            $('#mainTable').DataTable({
                ajax: {
                    "url": "@Url.Action("ListDataCourtJudgeCount")",
                    "type": "POST",
                    "datatype": "json",
                    "data": function (d) {
                        d.filter = {
                        };
                    }
                },
                filter:false,
                columns: [
                    {
                        className: 'col-md-10',
                        name: 'courtLabel',
                        data: 'courtLabel',
                        title: 'Съд',
                        sortable: true,
                        searchable: false
                    },
                     {
                        name: 'judgeCount',
                        data: 'judgeCount',
                        title: 'Действителен зает щат',
                        sortable: true,
                        searchable: false
                    },
                ]
            });
        }
    }
</script>
