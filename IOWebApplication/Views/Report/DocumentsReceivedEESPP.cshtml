@using IOWebApplication.Infrastructure.Models.ViewModels.Report
@model DocumentsReceivedEESPPFilterVM

@{
    ViewData["Title"] = "Документи, постъпили чрез ЕЕСПП";
}

@section breadcrumb{
<ol class="breadcrumb">
    <li><a href="@Url.Action("Index","Home")" title="Начало"><i class="fa fa-home"></i></a></li>
    <li class="active">@ViewData["Title"]</li>
</ol>
}

<div class="row">
    <div class="col-lg-2">@Html.EditorFor(m => m.DateReturnedFrom, "DateTime")</div>
    <div class="col-lg-2">@Html.EditorFor(m => m.DateReturnedTo, "DateTime")</div>
</div>

<div class="row">
    <div class="col-md-6 text-left pb-15">
        <button type="button" class="btn btn-primary" id="btnFilter" onclick="LoadTable()" value="Филтриране" title="Филтриране">
            Филтриране
            <i class="fa fa-search" title="Търсене"></i>
        </button>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <table id="mainTable" class="table table-hover table-striped"></table>
    </div>
</div>

<script>
    function LoadTable() {
        if ($.fn.dataTable.isDataTable('#mainTable')) {
            refreshTable('#mainTable');
        }
        else {
            $('#mainTable').DataTable({
                ajax: {
                    "url": "@Url.Action("ListDataDocumentsReceivedEESPP", "Report")",
                    "type": "POST",
                    "datatype": "json",
                    data: function (d) {
                        d.filter = {
                            DateReturnedFrom: $("#DateReturnedFrom").val(),
                            DateReturnedTo: $("#DateReturnedTo").val(),
                        };
                    }
                },
                filter:false,
                columns: [
                    {
                        name: 'caseNumber',
                        data: 'caseNumber',
                        title: 'Дело номер',
                        sortable: true,
                        searchable: true,
                        "render": function (item, type, row, meta) {
                            var url = '@(Url.Action("CasePreview", "Case",new { id = 666}))';
                            url = url.replace('666', row.caseId);
                            return "<a style='cursor: pointer;' data-toggle='tooltip' title='Преглед' href=" + url + ">" + row.caseNumber + "</a>";
                        }
                    },
                    {
                        className: "text-center",
                        name: 'dateReturned',
                        data: 'dateReturned',
                        title: 'Дата на постъпване на уведомителното писмо',
                        sortable: true,
                        searchable: false,
                        "render": function (value) {
                            if (value)
                                return moment(value).format("DD.MM.YYYY");
                            else
                                return "";
                        }
                    },
                    {
                        name: 'person',
                        data: 'person',
                        title: 'Лица, за които се иска правна помощ',
                        sortable: true,
                        searchable: false,
                        "render": function (item, type, row, meta) {
                            return row.persons;
                        },
                    },
                    {
                        name: 'lawyerHelpTypeLabel',
                        data: 'lawyerHelpTypeLabel',
                        title: 'Вид правна помощ',
                        sortable: true,
                        searchable: false,
                    },
                    {
                        name: 'lawyerInfo',
                        data: 'lawyerInfo',
                        title: 'Определен адвокат',
                        sortable: true,
                        searchable: false,
                    },
                    {
                        name: 'actions',
                        data: "id",
                        title: "",
                        sortable: false,
                        searchable: false,
                        className: "text-center noExport",
                        "render": function (data, type, row) {
                            return TemplateToHtml('#templateEdit', row);
                        }
                    }
                ]
            });
        }
    }
</script>

<script id="templateEdit" type="text/x-handlebars-template">
    <div class="row">
        <a href="@Url.Action("CasePreview", "Case")/{{caseId}}" class="btn btn-def btn-sm" title="Дело"><i class="fa fa-eye"></i><span class="hidden-sm hidden-xs"></span></a>
    </div>
</script>

<script>
    $(document).ready(function () {
    });
</script>