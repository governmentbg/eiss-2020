@using IOWebApplication.Infrastructure.Models.ViewModels
@model CasePersonFilterVM

@{
    ViewData["Title"] = "Информация за страни ";
}

@section breadcrumb{
<ol class="breadcrumb">
    <li><a href="@Url.Action("Index","Home")" title="Начало"><i class="fa fa-home"></i></a></li>
    <li class="active">@ViewData["Title"]</li>
</ol>
}

<div class="row">
    <div class="col-md-6 col-lg-3">@Html.EditorFor(x => x.Uic)</div>
    <div class="col-md-6 col-lg-3">@Html.EditorFor(x => x.FullName)</div>
    <div class="col-md-6 col-lg-3">@Html.EditorFor(x => x.CaseRegNumber)</div>
</div>

<div class="row">
    <div class="col-lg-3">@Html.EditorFor(m => m.DateFrom, "DateTime")</div>
    <div class="col-lg-3">@Html.EditorFor(m => m.DateTo, "DateTime")</div>
    <div class="col-lg-2">@Html.EditorFor(m => m.FinalDateFrom, "DateTime")</div>
    <div class="col-lg-2">@Html.EditorFor(m => m.FinalDateTo, "DateTime")</div>
    <div class="col-lg-2">@Html.EditorFor(m => m.WithoutFinalDateTo, "DateTime")</div>
</div>

<div class="row">
    <div class="col-lg-3">@Html.EditorFor(m => m.CaseGroupId, "GenericDropDown")</div>
    <div class="col-lg-3">@Html.EditorFor(m => m.CaseTypeId, "GenericDropDown")</div>
    <div class="col-lg-6">@Html.EditorFor(m => m.CaseCodeIds, "GenericDropDownMultipleArray")</div>
</div>

<div class="row">
    <div class="col-md-6 text-left pb-15">
        <button type="button" class="btn btn-primary" id="btnFilter" onclick="LoadTable()" value="Филтриране" title="Филтриране">
            Филтриране
            <i class="fa fa-search" title="Търсене"></i>
        </button>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <table id="casePersonMainTable" class="table table-hover table-striped"></table>
    </div>
</div>

<script>
    function LoadTable() {
        if ($("#DateFrom").val() != '') {
            if ($("#DateTo").val() == '')
                return messageHelper.ShowErrorMessage('Полпълнете дата до', messageContainer);
        }

        if ($("#DateTo").val() != '') {
            if ($("#DateFrom").val() == '')
                return messageHelper.ShowErrorMessage('Полпълнете от дата', messageContainer);
        }

        if ($("#FinalDateFrom").val() != '') {
            if ($("#FinalDateTo").val() == '')
                return messageHelper.ShowErrorMessage('Полпълнете до дата на свършване', messageContainer);
        }

        if ($("#FinalDateTo").val() != '') {
            if ($("#FinalDateFrom").val() == '')
                return messageHelper.ShowErrorMessage('Полпълнете от дата на свършване', messageContainer);
        }

        if ($.fn.dataTable.isDataTable('#casePersonMainTable')) {
            refreshTable('#casePersonMainTable');
        }
        else {
            $('#casePersonMainTable').DataTable({
                ajax: {
                    "url": "@Url.Action("ListDataCasePersonInformation", "Report")",
                    "type": "POST",
                    "datatype": "json",
                    data: function (d) {
                        d.filter = {
                            Uic: $('#Uic').val(),
                            FullName: $('#FullName').val(),
                            CaseRegnumber: $("#CaseRegNumber").val(),
                            DateFrom: $("#DateFrom").val(),
                            DateTo: $("#DateTo").val(),
                            FinalDateFrom: $("#FinalDateFrom").val(),
                            FinalDateTo: $("#FinalDateTo").val(),
                            WithoutFinalDateTo: $("#WithoutFinalDateTo").val(),
                            CaseGroupId: $("#CaseGroupId").val(),
                            CaseTypeId: $("#CaseTypeId").val(),
                            CaseCodeIds: $("#CaseCodeIds").val(),
                        }
                    }
                },
                filter: false,
                columns: [
                    {
                        name: 'caseTypeLabel',
                        data: 'caseTypeLabel',
                        title: 'Вид дело',
                        sortable: true,
                        searchable: true
                    },
                    {
                        name: 'caseNumber',
                        data: 'caseNumber',
                        title: 'Номер на дело',
                        "render": function (item, type, row, meta, data) {
                            var url = '@(Url.Action("CasePreview", "Case",new { id = 666}))';
                            url = url.replace('666', row.caseId);
                            return "<a style='cursor: pointer;' data-toggle='tooltip' title='Преглед' href=" + url + ">" + row.caseNumber + "</a>";
                        },
                        sortable: true,
                        searchable: true
                    },
                    {
                        className: 'col-md-1',
                        name: 'caseDate',
                        data: 'caseDate',
                        title: 'Дата',
                        sortable: true,
                        searchable: false,
                        "render": function (value) {
                            if (value)
                                return moment(value).format("DD.MM.YYYY");
                            else
                                return "";
                        }
                    },
                    {
                        name: 'judgeReport',
                        data: 'judgeReport',
                        title: 'Съдия-докладчик',
                        sortable: true,
                        searchable: true
                    },
                    {
                        name: 'caseCodeLabel',
                        data: 'caseCodeLabel',
                        title: 'Предмет',
                        sortable: true,
                        searchable: true
                    },
                    {
                        name: 'uic',
                        data: 'uic',
                        title: 'Идентификатор на лице',
                        sortable: true,
                        searchable: true
                    },
                    {
                        name: 'fullName',
                        data: 'fullName',
                        title: 'Имена/Наименование на лице',
                        sortable: true,
                        searchable: true
                    },
                    {
                        name: 'roleName',
                        data: 'roleName',
                        title: 'Вид лице',
                        sortable: true,
                        searchable: true
                    },
                    {
                        name: 'caseStateLabel',
                        data: 'caseStateLabel',
                        title: 'Статус на дело',
                        sortable: true,
                        searchable: false
                    },
                    {
                        name: 'actions',
                        data: "caseId",
                        title: "",
                        sortable: false,
                        searchable: false,
                        className: "text-center noExport",
                        "render": function (data, type, row) {
                            return TemplateToHtml('#casePersonTemplateEdit', row);
                        }
                    }
                ]
            }).order([[2, "asc"]]);
        }
    }
</script>

<script id="casePersonTemplateEdit" type="text/x-handlebars-template">
    <a href="@Url.Action("CasePreview", "Case")?id={{caseId}}" target="_blank" class="btn btn-dropbox btn-sm" title="Дело"><i class="fa fa-eye"></i><span class="hidden-sm hidden-xs"></span></a>
</script>

<script>
    $(document).ready(function () {
        $('#CaseCodeIds').select2({ language: "bg" });
        $('#CaseGroupId').trigger('change');
    });

    $('#CaseGroupId').change(function () {
        requestCombo('@Url.Action("GetDDL_CaseTypeFromCourtType", "Ajax")', { CaseGroupId: $(this).val() }, '#CaseTypeId', @Model.CaseTypeId, function () { $('#CaseTypeId').trigger('change') });
    });

    $('#CaseTypeId').change(function () {
        requestCombo('@Url.Action("Get_CaseCodeByLoadGroup_DropDown", "Ajax")', { caseTypeId: $(this).val() }, '#CaseCodeIds', '', function () { $('#CaseCodeIds').trigger('change') });
    });
</script>
