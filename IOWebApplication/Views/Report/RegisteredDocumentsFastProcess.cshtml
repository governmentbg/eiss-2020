@using IOWebApplication.Infrastructure.Constants
@using IOWebApplication.Infrastructure.Models.ViewModels.Report
@model RegisteredDocumentsFilterFastProcessVM

@{
    ViewData["Title"] = "Регистрираните документи за определен период по дела по чл. 410 ГПК и чл. 417 ГПК";
    ViewData["ShowMenuCounts"] = true;
}

@section breadcrumb{
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index","Home")" title="Начало"><i class="fa fa-home"></i></a></li>
        <li class="active">@ViewData["Title"]</li>
    </ol>
}
<div class="filter-form">
    <div class="row">
        <div class="col-lg-3">@Html.EditorFor(m => m.DocumentDateFrom, "DateTime")</div>
        <div class="col-lg-3">@Html.EditorFor(m => m.DocumentDateTo, "DateTime")</div>
        <div class="col-lg-3">@Html.EditorFor(m => m.DocumentDateEpepFrom, "DateTime")</div>
        <div class="col-lg-3">@Html.EditorFor(m => m.DocumentDateEpepTo, "DateTime")</div>
    </div>

    <div class="row">
        <div class="col-lg-3">@Html.EditorFor(x => x.DocumentCourtId, "GenericSelect2")</div>
        <div class="col-lg-3">@Html.EditorFor(m => m.DocumentDeliveryGroupId, "GenericDropDown")</div>
        <div class="col-lg-3">@Html.EditorFor(m => m.DocumentRegNum)</div>
        <div class="col-lg-3">@Html.EditorFor(m => m.DocumentRegNumEpep)</div>
    </div>

    <div class="row">
        <div class="col-md-6 text-left pb-15">
            <button type="button" class="btn btn-primary filter-button" id="btnFilter" onclick="LoadTable()" value="Филтриране" title="Филтриране">
                Филтриране
                <i class="fa fa-search" title="Търсене"></i>
            </button>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12 col-md-12">
        <table id="mainTable" class="table table-hover table-striped"></table>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            $('#DocumentCourtId').select2({ language: "bg" });
        });
    </script>
}

<script>
    function LoadTable() {
        if ($.fn.dataTable.isDataTable('#mainTable')) {
            refreshTable('#mainTable');
        }
        else {
            $('#mainTable').DataTable({
                ajax: {
                    "url": "@Url.Action("ListDataRegisteredDocumentsFastProcess")",
                    "type": "POST",
                    "datatype": "json",
                    "data": function (d) {
                        d.filter = {
                            DocumentDateFrom: $("#DocumentDateFrom").val(),
                            DocumentDateTo: $("#DocumentDateTo").val(),
                            DocumentCourtId: $("#DocumentCourtId").val(),
                            DocumentDateEpepFrom: $("#DocumentDateEpepFrom").val(),
                            DocumentDateEpepTo: $("#DocumentDateEpepTo").val(),
                            DocumentDeliveryGroupId: $("#DocumentDeliveryGroupId").val(),
                            DocumentRegNum: $("#DocumentRegNum").val(),
                            DocumentRegNumEpep: $("#DocumentRegNumEpep").val()
                        };
                    }
                },
                filter:false,
                columns: [
                    {
                        name: 'documentRegNum',
                        data: 'documentRegNum',
                        title: 'Вх. номер',
                        "render": function (item, type, row, meta) {
                                var url = '@(Url.Action("Edit", "Document", new { id = 666 }))';
                                url = url.replace('666', row.documentId);
                                return "<a style='cursor: pointer;' data-toggle='tooltip' title='Преглед' href=" + url + ">" + row.documentRegNum + "</a>";
                        },
                        sortable: true,
                        searchable: false
                    },
                     {
                        name: 'documentCourtLabel',
                        data: 'documentCourtLabel',
                        title: 'Съд',
                        sortable: true,
                        searchable: false
                    },
                    {
                        name: 'documentDeliveryGroupLabel',
                        data: 'documentDeliveryGroupLabel',
                        title: 'Начин на подаване',
                        sortable: true,
                        searchable: false
                    },
                    {
                        className: 'col-md-1',
                        className: "text-center",
                        name: 'documentDate',
                        data: 'documentDate',
                        title: 'Дата',
                        sortable: true,
                        searchable: true,
                        "render": function (value) {
                            if (value)
                                return moment(value).format("DD.MM.YYYY");
                            else
                                return "";
                        }
                    },
                    {
                        name: 'documentRegNumEpep',
                        data: 'documentRegNumEpep',
                        title: 'Вх. номер от ЕПЕП',
                        sortable: true,
                        searchable: false
                    },
                    {
                        className: 'col-md-1',
                        className: "text-center",
                        name: 'documentDateEpep',
                        data: 'documentDateEpep',
                        title: 'Дата на регистрация в ЕПЕП',
                        sortable: true,
                        searchable: true,
                        "render": function (value) {
                            if (value)
                                return moment(value).format("DD.MM.YYYY");
                            else
                                return "";
                        }
                    },
                    {
                        name: 'actions',
                        data: "id",
                        title: "",
                        width: 100,
                        sortable: false,
                        searchable: false,
                        className: "text-center noExport",
                        "render": function (value) {
                            return TemplateToHtml('#templateEdit', value);
                        }
                    }
                ]
            }).order([[3, "asc"]]);
        }
    }
</script>

<script id="templateEdit" type="text/x-handlebars-template">
    <div class="row">
    </div>
</script>
