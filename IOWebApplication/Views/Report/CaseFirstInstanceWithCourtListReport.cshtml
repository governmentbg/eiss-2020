@using IOWebApplication.Infrastructure.Models.ViewModels.Report
@using IOWebApplication.Infrastructure.Constants
@model CaseFirstInstanceListFilterReportVM

@{
    ViewData["Title"] = "Справка постъпили дела за период – първоинстанционни дела";
}

@section breadcrumb{
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index","Home")" title="Начало"><i class="fa fa-home"></i></a></li>
        <li class="active">@ViewData["Title"]</li>
    </ol>
}
<form name="formFilter" id="formFilter" action="@Url.Action("CaseFirstInstanceListReportExportExcel")" method="post">
    <div class="row">
        <div class="col-lg-3">@Html.EditorFor(m => m.DateFrom, "DateTime")</div>
        <div class="col-lg-3">@Html.EditorFor(m => m.DateTo, "DateTime")</div>
        <div class="col-lg-3">@Html.EditorFor(m => m.LifeCycleDateFrom, "DateTime")</div>
        <div class="col-lg-3">@Html.EditorFor(m => m.LifeCycleDateTo, "DateTime")</div>
    </div>
    <div class="row">
        <div class="col-lg-3">@Html.EditorFor(x => x.CaseGroupId, "GenericDropDown")</div>
        <div class="col-lg-3">@Html.EditorFor(x => x.CaseTypeId, "GenericDropDown")</div>
        <div class="col-lg-3">@Html.EditorFor(m => m.CaseCodeIds, "GenericDropDownMultipleArray")</div>
        <div class="col-lg-3">@Html.EditorFor(x => x.CourtId, "GenericSelect2")</div>
    </div>
    <div class="row">
        <div class="col-lg-2">@Html.EditorFor(x => x.CourtDepartmentId, "GenericDropDown")</div>
        <div class="col-lg-2">@Html.EditorFor(x => x.ProcessPriorityId, "GenericDropDown")</div>
        <div class="col-lg-2">@Html.EditorFor(x => x.DocumentTypeId, "GenericDropDown")</div>
        <div class="col-lg-4">@Html.EditorFor(x => x.JudgeReporterId, "LawUnit", null, new { selectMode = NomenclatureConstants.LawUnitSelectMode.AllWithHistoryNoVAS, lawUnitType = NomenclatureConstants.LawUnitTypes.Judge })</div>
        <div class="col-lg-2">@Html.EditorFor(x => x.CaseCreateFromId, "GenericDropDown")</div>
    </div>
    <div class="row">
    </div>
</form>

<div class="row">
    <div class="col-md-6 text-left pb-15">
        <button type="button" class="btn btn-primary" id="btnFilter" onclick="ValidateData()" value="Филтриране" title="Филтриране">
            Филтриране
            <i class="fa fa-search" title="Търсене"></i>
        </button>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <table id="mainTable" class="table table-hover table-striped"></table>
    </div>
</div>

<script>
    function LoadTable() {
        if ($.fn.dataTable.isDataTable('#mainTable')) {
            refreshTable('#mainTable');
        }
        else {
            $('#mainTable').DataTable({
                ajax: {
                    "url": "@Url.Action("ListDataCaseFirstInstanceListReport", "Report")",
                    "type": "POST",
                    "datatype": "json",
                    data: function (d) {
                        d.filter = {
                            DateFrom: $("#DateFrom").val(),
                            DateTo: $("#DateTo").val(),
                            LifeCycleDateFrom: $("#LifeCycleDateFrom").val(),
                            LifeCycleDateTo: $("#LifeCycleDateTo").val(),
                            CaseGroupId: $("#CaseGroupId").val(),
                            CaseTypeId: $("#CaseTypeId").val(),
                            DocumentTypeId: $("#DocumentTypeId").val(),
                            JudgeReporterId: $("#JudgeReporterId").val(),
                            CaseCreateFromId: $("#CaseCreateFromId").val(),
                            CaseCodeIds: $("#CaseCodeIds").val(),
                            CourtDepartmentId: $("#CourtDepartmentId").val(),
                            CourtId: $("#CourtId").val(),
                            ProcessPriorityId: $("#ProcessPriorityId").val(),
                        };
                    }
                },
                  filter:false,
                columns: [
                    {
                        name: 'courtLabel',
                        data: 'courtLabel',
                        title: 'Съд',
                        sortable: true,
                        searchable: true
                    },
                    {
                        name: 'caseTypeName',
                        data: 'caseTypeName',
                        title: 'Точен вид дело',
                        sortable: true,
                        searchable: true
                    },
                    {
                        name: 'caseRegNumber',
                        data: 'caseRegNumber',
                        title: 'Номер на дело',
                        "render": function (item, type, row, meta) {
                            var url = '@(Url.Action("CasePreview", "Case",new { id = 666}))';
                            url = url.replace('666', row.caseId);
                            return "<a style='cursor: pointer;' data-toggle='tooltip' title='Преглед' href=" + url + ">" + row.caseRegNumber + "</a>";
                        },
                        sortable: true,
                        searchable: true
                    },
                    {
                        className: "text-center",
                        name: 'caseRegDate',
                        data: 'caseRegDate',
                        title: 'Дата на образуване',
                        sortable: true,
                        searchable: false,
                        "render": function (value) {
                            if (value)
                                return moment(value).format("DD.MM.YYYY");
                            else
                                return "";
                        }
                    },
                    {
                        className: "text-center",
                        name: 'dateFinishCase',
                        data: 'dateFinishCase',
                        title: 'Дата на свършване на делото',
                        sortable: false,
                        searchable: false,
                        "render": function (value) {
                            if (value)
                                return moment(value).format("DD.MM.YYYY");
                            else
                                return "";
                        }
                    },
                    {
                        className: "text-center",
                        name: 'dateFromNewLifeCycle',
                        data: 'dateFromNewLifeCycle',
                        title: 'Нов интервал',
                        sortable: false,
                        searchable: false,
                        "render": function (value) {
                            if (value)
                                return moment(value).format("DD.MM.YYYY");
                            else
                                return "";
                        }
                    },
                    {
                        name: 'judgeReporterName',
                        data: 'judgeReporterName',
                        title: 'Съдия докладчик',
                        sortable: true,
                        searchable: true
                    },
                    {
                        name: 'caseCodeName',
                        data: 'caseCodeName',
                        title: 'Предмет и шифър',
                        sortable: true,
                        searchable: false,
                    },
                    {
                        name: 'caseCreateFromName',
                        data: 'caseCreateFromName',
                        title: 'Източник на постъпване',
                        sortable: false,
                        searchable: false,
                    },
                ]
            }).order([[1, "asc"]]);
        }
    }
    let createTbl = true;
    function ValidateData() {
        var datefrom = $("#DateFrom").val();
        var dateto = $("#DateTo").val();
        postContent('@Url.Action("IsValidateDateMonth", "Report")'
            , { dateFrom: datefrom, dateTo: dateto }
            , function (data) {
                if (!data.result)
                {
                    if (createTbl) {
                        LoadTable();
                        createTbl = false;
                    } else {
                        $('#mainTable').DataTable().ajax.reload(
                            function () {
                        });
                    }
                }
                else
                {
                    return messageHelper.ShowErrorMessage('Периодът е по-голям от месец.', messageContainer);
                }
            });
    }
</script>

<script>
    $(document).ready(function () {
        $('#CaseCodeIds').select2({ language: "bg" });
        $('#CourtId').select2({ language: "bg" });
        $('#CaseGroupId').trigger('change');
        $('#CaseTypeId').trigger('change');

        $.fn.dataTable.ext.buttons.io_excel.action = function () {
            $("#formFilter").submit();
        };
    });

    $('#CaseGroupId').change(function () {
        requestCombo('@Url.Action("GetDDL_CaseTypeFromCourtType", "Ajax")', { CaseGroupId: $(this).val()}, '#CaseTypeId', @Model.CaseTypeId);
    });

    $('#CaseTypeId').change(function () {
        requestCombo('@Url.Action("GetDDL_DocumentTypeByCaseType", "Ajax")', { caseTypeId: $(this).val(), documentKind: @DocumentConstants.DocumentKind.InitialDocument }, '#DocumentTypeId', @Model.DocumentTypeId);
        requestCombo('@Url.Action("Get_CaseCodeByLoadGroup_DropDown", "Ajax")', { caseTypeId: $(this).val() }, '#CaseCodeIds', '', function () { $('#CaseCodeIds').trigger('change') });
    });
</script>

<script>
    $(function () {
        initLawUnit();
    });
</script>
