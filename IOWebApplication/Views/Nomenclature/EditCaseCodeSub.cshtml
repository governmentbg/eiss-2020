@using IOWebApplication.Infrastructure.Models.ViewModels.Nomenclatures
@model CaseCodeSubVM

@{
    if (Model.Id > 0)
    {
        ViewData["Title"] = "Редакция на подшифър";
    }
    else
    {
        ViewData["Title"] = "Добавяне на подшифър";
    }
}

@section breadcrumb {
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")" title="Начало"><i class="fa fa-home"></i></a></li>
        <li><a href="@Url.Action("IndexCaseCodeSub", "Nomenclature")">Подшифри</a></li>
        <li class="active">@ViewData["Title"]</li>
    </ol>
}

<div class="row">
    <div class="col-md-6">
        <form asp-action="EditCaseCodeSub" method="post">
            @Html.HiddenFor(x => x.Id)

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div id="saveContainer">
                <partial name="_SaveFormContent" model="@("#saveContainer")" />

                <div class="row">
                    <div class="col-lg-12">@Html.EditorFor(x => x.CaseCodeId, "GenericSelect2")</div>
                </div>

                <div class="row">
                    <div class="col-lg-4">@Html.EditorFor(x => x.OrderNumber, "Int32Nullable")</div>
                    <div class="col-lg-4">@Html.EditorFor(x => x.Code)</div>
                    <div class="col-lg-4">@Html.EditorFor(x => x.Label)</div>
                </div>

                <div class="row">
                    <div class="col-lg-4">@Html.EditorFor(x => x.IsActive)</div>
                </div>

                <div class="row">
                    <div class="col-lg-4">@Html.EditorFor(x => x.DateFrom, "DateTime")</div>
                    <div class="col-lg-4">@Html.EditorFor(x => x.DateTo, "DateTime")</div>
                </div>

                <div class="row">
                    <div class="col-lg-12">@Html.EditorFor(x => x.Description, "Textarea")</div>
                </div>
            </div>

            <div class="form-group">
                <input type="submit" value="Запис" class="btn btn-success single-click-submit" />
                <a asp-controller="Nomenclature" asp-action="IndexCaseCodeSub" class="btn btn-danger">Назад</a>
                @if (Model.Id > 0)
                {
                    <div class="pull-right">
                        @await Html.PartialAsync("_ShowLogOperation", new IOWebApplication.Core.Models.ShowLogModel() { ObjectKey = Model.Id.ToString() })
                    </div>
                }
            </div>
        </form>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            $('#CaseCodeId').select2({ language: "bg" });
        });
    </script>
}
