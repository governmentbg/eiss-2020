@model CaseSessionActSelectionProtocolFilterVM
@using IOWebApplication.Infrastructure.Models.ViewModels
@using IOWebApplication.Infrastructure.Constants
@{
    ViewData["Title"] = "Протоколи от направен случаен избор на актове за атестация";
    ViewData["ShowMenuCounts"] = true;
}

@section breadcrumb{
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index","Home")" title="Начало"><i class="fa fa-home"></i></a></li>
        <li class="active">@ViewData["Title"]</li>
    </ol>
}

<div class="row">
    <div class="col-md-12 text-right pb-15">
        <a asp-controller="CaseSessionActSelection" asp-action="ActList" class="btn btn-success">
            <i class="fa fa-plus"></i>
            Добави
        </a>
    </div>
</div>
<div class="row">
    <div class="col-md-12">





<div class="row">
            <div class="col-lg-3">@Html.EditorFor(x => x.JudgeReporterId, "LawUnit", null, new { selectMode = NomenclatureConstants.LawUnitSelectMode.AllWithHistoryNoVAS, lawUnitType = NomenclatureConstants.LawUnitTypes.Judge })</div>
          <div class="col-lg-3">@Html.EditorFor(m => m.DateFrom, "DateTime")</div>
            <div class="col-lg-3">@Html.EditorFor(m => m.DateTo, "DateTime")</div>
  
</div>

<div class="row">
       <div class="col-lg-3">@Html.EditorFor(m => m.IsFinal, "Boolean")</div>
            <div class="col-lg-3">@Html.EditorFor(m => m.IsCanceling, "Boolean")</div>
       <div class="col-lg-3">@Html.EditorFor(m => m.IsBeacameFinal, "Boolean")<br />
                           @Html.EditorFor(x => x.ActResultId, "GenericDropDown")
                </div>
       </div>
</div>


<div class="row">
    <div class="col-md-6 text-left pb-15">
        <button type="button" class="btn btn-primary" id="btnFilter" onclick="LoadTableCaseSessionAct()" value="Филтриране" title="Филтриране">
            Филтриране
            <i class="fa fa-search" title="Търсене"></i>
        </button>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <table id="caseSessionActMainTable" class="table table-hover table-striped"></table>
    </div>
</div>

   
    </div>
</div>




<script>
    function LoadTableCaseSessionAct() {
        if ($.fn.dataTable.isDataTable('#caseSessionActMainTable')) {
            refreshTable('#caseSessionActMainTable');
        }
        else {
            $('#caseSessionActMainTable').DataTable({
                ajax: {
                    "url": "@Url.Action("ListDataSpr", "CaseSessionActSelection")",
                    "type": "POST",
                    "datatype": "json",
                    data: function (d) {
                        d.model = {
                            DateFrom: $('#DateFrom').val(),
                            DateTo: $('#DateTo').val(),
                            JudgeReporterId: $('#JudgeReporterId').val(),
                            IsFinal: $("#IsFinal").is(":checked"),
                            IsCanceling: $("#IsCanceling").is(":checked"),
                            IsBeacameFinal: $("#IsBeacameFinal").is(":checked"),
                            ActResultId: $('#ActResultId').val()
                        };
                    }
                },
                columns: [
                    {
                        name: 'id',
                        data: 'id',
                        title: 'Протокол',
                        "render": function (item, type, row, meta) {
                            var url = '@(Url.Action("CasePreview", "Case", new { id = 666 }))';
                            url = url.replace('666', row.caseId);
                            return "<a style='cursor: pointer;' data-toggle='tooltip' title='Преглед' href=" + url + ">" + row.id + "</a>";
                        },
                        sortable: true,
                        searchable: true
                    },
                    {
                        name: 'selectedLawUnitName',
                        data: 'selectedLawUnitName',
                        title: 'Съдия-докладчик',
                        sortable: true,
                        searchable: true
                    },
                    {
                        name: 'isFinalStr',
                        data: 'isFinalStr',
                        title: '',
                        sortable: true,
                        searchable: true
                    },
                    {
                        name: 'isCancelingstr',
                        data: 'isCancelingstr',
                        title: '',
                        sortable: true,
                        searchable: true
                    },
                    {
                        name: 'isBeacameFinalStr',
                        data: 'isBeacameFinalStr',
                        title: '',
                        sortable: true,
                        searchable: true
                    },
                    {
                      
                        name: 'selectionDate',
                        data: 'selectionDate',
                        title: 'Дата',
                        sortable: true,
                        searchable: false,
                        "render": function (value) {
                            if (value)
                                return moment(value).format("DD.MM.YYYY");
                            else
                                return "";
                        }
                    },
                    {
                        name: 'selectionProtocolStateName',
                        data: 'selectionProtocolStateName',
                        title: '',
                        sortable: true,
                        searchable: true
                    },
                    {
                        name: 'actions',
                        data: "id",
                        title: "",
                        sortable: false,
                        searchable: false,
                        className: "text-center noExport",
                        "render": function (value) {
                            return TemplateToHtml('#caseSelectionProtokolTemplateEdit', value);
                        }
                    }
                ]
            }).order([[5, "desc"]]);
        }
    }
</script>

<script id="caseSelectionProtokolTemplateEdit" type="text/x-handlebars-template">
    <a href="@Url.Action("PreviewDoc", "CaseSessionActSelection")?id={{this}}" class="btn btn-warning btn-sm" title="Преглед"><i class="fa fa-eye"></i><span class="hidden-sm hidden-xs"></span></a>
</script>





<script>
    // $(document).ready(function () {
    //     $('#CaseGroupIds').select2({
    //     });
    //     $('#CaseTypeIds').select2({
    //     });
    //     $('#ActTypeIds').select2({
    //     });
    // });







    $(function () {
        initActLawBaseAutoComplete();
        initLawUnit();
        LoadTableCaseSessionAct();


        function toggleActResult() {
            var show = $("#IsBeacameFinal").is(":checked");

           
            var $wrapper = $("#ActResultId").closest(".form-group");

           
            if ($wrapper.length === 0) {
                $("#ActResultId, label[for='ActResultId']").toggle(show);
            } else {
                $wrapper.toggle(show);
            }
        }

            $("#IsBeacameFinal").on("change", toggleActResult);

          
            toggleActResult();
    
    })
</script>



