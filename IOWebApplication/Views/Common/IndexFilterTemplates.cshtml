@using IOWebApplication.Infrastructure.Models.ViewModels.Report
@model FilterTemplatesFilterVM

@{
    ViewData["Title"] = "Шаблони";
}

@section breadcrumb{
<ol class="breadcrumb">
    <li><a href="@Url.Action("Index","Home")" title="Начало"><i class="fa fa-home"></i></a></li>
    <li><a href="@Url.Action("SpecializedReport", "Report")" title="Специализирана справка"><i class="fa fa-user-secret"></i> Специализирана справка</a></li>
    <li class="active">@ViewData["Title"]</li>
</ol>
}

<form name="formFilter" id="formFilter" method="post">
    @Html.HiddenFor(x => x.FilterTemplateTypeId)

    <div class="row">
        <div class="col-md-12 text-right pb-15">
            <a asp-controller="Common" asp-action="AddFilterTemplatesSpecializedReport" class="btn btn-success btn-sm m-b-5">
                <i class="fa fa-plus"></i>
                Добави
            </a>
        </div>
    </div>

</form>

<div class="row">
    <div class="col-md-12">
        <table id="mainTable" class="table table-hover table-striped"></table>
    </div>
</div>

<script>
    function LoadTable() {
        if ($.fn.dataTable.isDataTable('#mainTable')) {
            refreshTable('#mainTable');
        }
        else {
            $('#mainTable').DataTable({
                ajax: {
                    "url": "@Url.Action("ListDataFilterTemplates")",
                    "type": "POST",
                    "datatype": "json",
                    "data": function (d) {
                        d.filter = {
                            FilterTemplateTypeId: $("#FilterTemplateTypeId").val()
                        };
                    }
                },
                filter:false,
                columns: [
                    {
                        name: 'filterTemplateTypeLabel',
                        data: 'filterTemplateTypeLabel',
                        title: 'Вид шаблон',
                        sortable: true,
                        searchable: false
                    },
                    {
                        name: 'label',
                        data: 'label',
                        title: 'Име на шаблона',
                        sortable: true,
                        searchable: false
                    },
                    {
                        name: 'isActiveLabel',
                        data: 'isActiveLabel',
                        title: 'Активен',
                        sortable: true,
                        searchable: false
                    },
                    {
                        name: 'actions',
                        data: "id",
                        title: "",
                        width: 100,
                        sortable: false,
                        searchable: false,
                        className: "text-center noExport",
                        "render": function (value) {
                            return TemplateToHtml('#templateEdit', value);
                        }
                    }
                ]
            });
        }
    }

    $(document).ready(function () {
        LoadTable();
    });
</script>

<script id="templateEdit" type="text/x-handlebars-template">
    <div class="row">
        <a href="@Url.Action("EditFilterTemplatesSpecializedReport", "Common")/{{this}}" class="btn btn-warning btn-sm" title="Редакция"><i class="fa fa-edit"></i><span class="hidden-sm hidden-xs"></span></a>
    </div>
</script>

@section scripts {
<script>
    
</script>
}