@model CasePersonMeasureEditVM
@using IOWebApplication.Infrastructure.Constants
@using IOWebApplication.Infrastructure.Contracts
@using IOWebApplication.Infrastructure.Models.ViewModels.Case
@inject IUserContext userContext

@{
    IAccessControl access = (IAccessControl)ViewBag.AccessControl;
    if (Model.Id > 0)
    {
        ViewData["Title"] = access.CanChange ? "Редакция на мерки" : "Преглед на мерки";
    }
    else
    {
        ViewData["Title"] = "Добавяне на мерки";
    }

    bool is92024 = userContext.IsSystemInFeature(NomenclatureConstants.SystemFeatures.Request9_2024);
}

@section breadcrumb {
    @if (ViewBag.breadcrumbs != null)
    {
        <partial name="Breadcrumbs" model="@(List<IOWebApplication.Infrastructure.Models.ViewModels.Common.BreadcrumbsVM>)ViewBag.breadcrumbs" />
    }
}

<div class="row">
    <div class="col-md-12">
        <form asp-action="EditCasePersonMeasure" method="post">
            @Html.HiddenFor(x => x.Id)
            @Html.HiddenFor(x => x.CaseId)
            @Html.HiddenFor(x => x.CourtId)
            @Html.HiddenFor(x => x.CasePersonId)

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div id="saveContainer">
                <partial name="_SaveFormContent" model="@("#saveContainer")" />

                <div class="row">
                    <div class="col-lg-6">
                        <fieldset class="is-fieldset">
                            <legend class="legend_1"> Основни данни</legend>
                            <div class="row">
                                <div class="col-lg-6">@Html.EditorFor(x => x.MeasureCourtId, "SelectCourt")</div>
                            </div>
                            <div class="row">
                                <div class="col-lg-6">@Html.EditorFor(x => x.MeasureInstitutionTypeId, "GenericDropDown")</div>
                                <div class="col-lg-6">@Html.EditorFor(x => x.MeasureInstitutionId, "SelectInstitution", null, new { institutionTypeContainer = "#MeasureInstitutionTypeId" })</div>
                            </div>
                            <div class="row">
                                <div class="col-lg-4">@Html.EditorFor(x => x.MeasureKindId, "GenericDropDown")</div>
                                <div class="col-lg-8">@Html.EditorFor(x => x.MeasureType, "GenericDropDownString")</div>
                            </div>
                            <div class="row">
                                <div class="col-lg-12">@Html.EditorFor(x => x.MeasureStatusDate, "DateTime")</div>
                            </div>
                            <div class="row">
                                <div class="col-lg-12">@Html.EditorFor(x => x.BailAmount, "Double")</div>
                            </div>
                            <div class="row" id="divMD" style="display:none">
                                <div class="col-lg-7">@Html.EditorFor(x => x.MeasureQuantity, "Int32Nullable")</div>
                                <div class="col-lg-5">@Html.EditorFor(x => x.MeasureUnit, "GenericDropDownString")</div>
                            </div>
                            <div class="row">
                                <div class="col-lg-12">@Html.EditorFor(x => x.MeasureStatus, "GenericDropDownString")</div>
                            </div>
                        </fieldset>
                        <fieldset class="is-fieldset" id="divTime">
                            <legend class="legend_1"> Време</legend>
                            <div class="col-lg-3">@Html.EditorFor(x => x.MeasureDays, "Int32")</div>
                            <div class="col-lg-3">@Html.EditorFor(x => x.MeasureWeeks, "Int32")</div>
                            <div class="col-lg-3">@Html.EditorFor(x => x.MeasureMonths, "Int32")</div>
                            <div class="col-lg-3">@Html.EditorFor(x => x.MeasureYears, "Int32")</div>
                        </fieldset>
                        <fieldset class="is-fieldset">
                            <legend class="legend_1"> Наказания, към мярката</legend>
                            <div class="col-lg-12">@Html.EditorFor(x => x.Punishments)</div>
                        </fieldset>
                    </div>
                </div>

            </div>

            <div class="form-group">
                @if (access.CanChange)
                {
                    <input type="submit" value="Запис" class="btn btn-success" />
                }
                <a asp-action="IndexCasePersonMeasure" asp-route-casePersonId="@Model.CasePersonId" class="btn btn-danger">Назад</a>
                @if (Model.Id > 0)
                {
                    <div class="pull-right">
                        @if (Model.DateExpired == null && access.CanChangeFull)
                        {
                            @await Html.PartialAsync("_ExpiredInfoButton", new ExpiredInfoVM() { Id = Model.Id, ReturnUrl = @Url.Action("IndexCasePersonMeasure", "CasePerson", new { casePersonId = @Model.CasePersonId }), DialogTitle = "Премахване на мярка за процесуална принуда", ExpireSubmitUrl = Url.Action("CasePersonMeasure_ExpiredInfo") })
                            <span>&nbsp;</span>
                        }
                        @await Html.PartialAsync("_ShowLogOperation", new IOWebApplication.Core.Models.ShowLogModel() { ObjectKey = Model.Id.ToString() })
                    </div>
                }
            </div>
        </form>
    </div>
</div>

@section scripts {
    <script>

        $(function () {
            initInstitution();
            initCourts();
            MeasureKindIdChange();
            SHMdata();

            $('#MeasureInstitutionTypeId').change(function () {
                let _inst = '@Model.MeasureInstitutionId';
                if ($(this).val().toString() != '@Model.MeasureInstitutionTypeId') {
                    _inst = '0';
                }
                let instControl = $('#MeasureInstitutionId_institution:first')[0];
                console.log(instControl);
                loadInstitution(instControl, _inst);
            }).trigger('change');
        });

        function MeasureKindIdChange() {
            requestCombo('@Url.Action("GetDDLMeasureType", "CasePerson")', { measureKindId: $('#MeasureKindId').val() }, '#MeasureType', @(Model.MeasureType == string.Empty ? "0" : Model.MeasureType), function () { $('#MeasureType').trigger('change') });
        }

        $('#MeasureKindId').change(function () {
            MeasureKindIdChange();
            SHMdata();
        });

        function SHMdata() {
            var measureKindId = $('#MeasureKindId').val();
            $("#divMD").hide();
            $("#divTime").hide();
            if ((measureKindId == '2') && ('@is92024' == 'True')) {
                $("#divMD").show();
                $("#divTime").show();
            }
        }
    </script>
}

