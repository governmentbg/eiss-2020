@using IOWebApplication.Infrastructure.Models.ViewModels.Common;
@using IOWebApplication.Core.Helper.GlobalConstants;
@model WorkNotificationFilterVM;
@{
    ViewData["Title"] = "Моите известия";
}
@section breadcrumb{
    @if (ViewBag.breadcrumbs != null)
    {
        <partial name="Breadcrumbs" model="@((List<IOWebApplication.Infrastructure.Models.ViewModels.Common.BreadcrumbsVM>)ViewBag.breadcrumbs)" />
    }
}
<form id="formFilter" asp-action="Edit" method="post">
    @Html.HiddenFor(x => x.Id)
    @Html.HiddenFor(x => x.NotificationKind)
    <div class="row">
        <div class="col-md-3">@Html.EditorFor(x => x.WorkNotificationTypeId, "GenericDropDown")</div>
        <div class="col-md-3">@Html.EditorFor(x => x.UserCourtDepartmentId, "GenericDropDown")</div>
        <div class="col-md-3">@Html.EditorFor(x => x.CaseRegNumber)</div>
    </div>
    <div class="row">
        <div class="col-md-2">@Html.EditorFor(x => x.DateCreate)</div>
        <div class="col-md-3">@Html.EditorFor(x => x.ReadTypeId, "GenericDropDown")</div>
        <div class="col-md-2"><div id="divDateFrom">@Html.EditorFor(x => x.DateFrom)</div></div>
        <div class="col-md-2"><div id="divDateTo">@Html.EditorFor(x => x.DateTo)</div></div>
    </div>
    <div class="row">
        <div class="col-md-2 text-left pb-15">
            <button type="button" class="btn btn-primary" id="btnFilter" onclick="LoadWorkNotifications()" value="Филтриране" title="Филтриране">
                Филтриране
                <i class="fa fa-search" title="Търсене"></i>
            </button>
        </div>
    </div>
</form>
<div class="row">
    <div class="col-md-12">
        <table id="mainTable" class="table table-hover table-striped"></table>
    </div>
</div>
<form name="formPostEdit" id="formPostEdit" action="@Url.Action("Edit")" method="post">
    <input type="hidden" id="filterJson" name="filterJson" value="">
</form>
<script>
    $('#ReadTypeId').change(function () {
        var showDates = ($('#ReadTypeId').val() != "1");
        if (showDates) {
            $('#divDateFrom').show();
            $('#divDateTo').show();
        } else {
            $('#divDateFrom').hide();
            $('#divDateTo').hide();
        }
    });
    $('#ReadTypeId').change();
        $(function () {
            var table = $('#mainTable').DataTable({
                'order': [[0, 'asc']],
                ajax: {
                    "url": "@Url.Action("ListData")",
                    "type": "POST",
                    "datatype": "json",
                     data: function (d) {
                         if ($('#filterJson').val() == "") {
                            console.log('initial set filterData');
                            $('#filterJson').val(JSON.stringify(getFormData($('#formFilter'))));
                        }
                        d.filterData = JSON.parse($('#filterJson').val());
                     }
                 },
                columns: [
                    {
                        className: 'col-md-2',
                        name: 'dateCreated',
                        data: 'dateCreated',
                        title: 'Дата на получаване',
                        sortable: true,
                        searchable: false,
                        width: 70,
                        "render": function (value) {
                            if (value)
                                return moment(value).format("@FormattingConstant.NormalDateFormatJS");
                            else
                                return "";
                    }
                    },
                    {
                        className: 'col-md-3',
                        name: 'title',
                        data: 'title',
                        title: 'Нотификация',
                        width: 300,
                        sortable: true,
                        searchable: true
                    },
                    {
                        className: 'col-md-2',
                        name: 'dateRead',
                        data: 'dateRead',
                        title: 'Прочетено',
                        sortable: true,
                        searchable: false,
                        width: 120,
                        "render": function (value) {
                            if (value)
                                return moment(value).format("@FormattingConstant.DateFormatJS");
                            else
                                return "";
                        }
                    },
                    {
                        className: 'col-md-3',
                        name: 'description',
                        data: 'description',
                        title: 'Съобщение',
                        width: 400,
                        sortable: true,
                        searchable: true
                    },
                    {
                        className: 'col-md-2',
                        name: 'actions',
                        data: "id",
                        title: "",
                        sortable: false,
                        searchable: false,
                        className: "text-right noExport",
                        width: 205,
                        "render": function (data, type, row) {
                            return TemplateToHtml('#templateEdit', row);
                        }
                    }
                ]
            });
        });

    function LoadWorkNotifications() {
        var filter = getFormData($('#formFilter'));
        $('#filterJson').val(JSON.stringify(filter));
        $('#mainTable').DataTable().ajax.reload();
    }

    function WorkNotificationIsRead(id) {
        $.ajax({
            method: "POST",
            url: '@Url.Action("SaveReaded")',
            dataType: "json",
            data: {id:id}
        }).fail(function (jqXHR, status, message) {
            if (jqXHR.responseText) {
                console.log(jqXHR.responseText);
            }
        }).always(function () {
          $('#mainTable').DataTable().ajax.reload();
        });
    };

    function manage(manageUrl, title) {
        let _data = {
            notificationIds: getNotificationIds()
        };
        if (_data) {
            requestContent(manageUrl, _data, function (html) {
                ShowModalDialog(title, html);
            });
        }
    }

    function getNotificationIds() {
        var result = '';
        $('.task-check').each(function (i, e) {
            if ($(e).is(':checked')) {
                result += ',' + $(e).data('id');
            }
        });
        if (result.length > 0) {
            return result.substr(1);
        } else {
            return undefined;
        }
    }
</script>

<script id="templateEdit" type="text/x-handlebars-template">
    {{#if isUnRead}}
    <a onclick="WorkNotificationIsRead({{this.id}})" class="btn btn-warning btn-sm m-b-5" title="Маркирай като прочетено">
        <i class="fa fa-edit"></i>
        <span class="hidden-sm hidden-xs">Маркирай като прочетено</span>
    </a>
    {{/if}}
    {{#if isEdit}}
        <a href="@Url.Action("EditDateCreated", "WorkNotification")?id={{this.id}}" class="btn btn-warning btn-sm m-b-5" title="Повтори по-късно известието"><i class="fa fa-clock-o"></i><span class="hidden-sm hidden-xs"></span></a>
    {{/if}}
    <a href='@Url.Action("RedirectToSource")/{{this.id}}' class="btn btn-def btn-sm m-b-5" title="{{this.linkLabel}}">
        <i class="fa fa-eye"></i>
    </a>
</script>

<script id="templateCheck" type="text/x-handlebars-template">
    {{#if isUnRead}}
    <input type="checkbox" class="task-check" data-id="{{id}}" />
    {{/if}}
</script>
