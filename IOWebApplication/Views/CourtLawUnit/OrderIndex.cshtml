@using IOWebApplication.Infrastructure.Constants

@{
    ViewData["Title"] = $"Ред на старшинство на съдии";
}
@section breadcrumb {
    @if (ViewBag.breadcrumbs != null)
    {
        <partial name="Breadcrumbs" model="@(List<IOWebApplication.Infrastructure.Models.ViewModels.Common.BreadcrumbsVM>)ViewBag.breadcrumbs" />
    }
}

<div class="row">
    <div class="col-md-6 text-right pb-15">
        <a asp-action="OrderIndex" asp-route-actualize="@true" class="btn btn-def">
            <i class="fa fa-refresh"></i>
            Обнови
        </a>
    </div>
</div>
<div class="row">
    <div class="col-md-6">
        <table id="mainTable" class="table table-hover table-striped"></table>
    </div>
</div>

@section scripts {
    <script>
        $(function () {
            var table = $('#mainTable').DataTable({
                ajax: {
                    "url": "@Url.Action("ListData_OrderIndex")",
                    "type": "POST",
                    "datatype": "json"
                },
                sortable: false,
                filter: false,
                paging: false,
                pageLength: 0,
                columns: [
                    {
                        name: 'rowNo',
                        data: 'rowNo',
                        title: 'No по ред',
                        width: 40,
                        sortable: false
                    },
                    {
                        name: 'lawUnitName',
                        data: 'lawUnitName',
                        title: 'Имена',
                        sortable: false
                    },
                    {
                        name: 'actions',
                        className: "text-right",
                        title: "",
                        sortable: false,
                        width: 120,
                        "render": function (a,b,row,c) {
                            return TemplateToHtml('#templateEdit', row);
                        }
                    }
                ]
            });
        });
        function changeOrder(id, moveUp) {
            requestGET_Json('@Url.Action("OrderChange")', { id: id, moveUp: moveUp }, function () {
                $('#mainTable').DataTable().ajax.reload();
            });
        }
        function showOrderCombo(currentRowNo) {
            requestContent('@Url.Action("OrderChangeCombo")', { currentRowNo: currentRowNo }, function (html) {
                ShowModalDialog("Изберете нова позиция", html);
            });
        }
    </script>

    <script id="templateEdit" type="text/x-handlebars-template">
        <a href="#" onclick="changeOrder({{id}}, true); return false;" class="orderButton btn btn-info btn-sm" title="Премести нагоре"><i class="fa fa-angle-up"></i></a>
        <a href="#" onclick="changeOrder({{id}}, false); return false;" class="orderButton btn btn-primary btn-sm" title="Премести надолу"><i class="fa fa-angle-down"></i></a>
        &nbsp;&nbsp;&nbsp;
        <a href="#" onclick="showOrderCombo({{rowNo}}, false); return false;" class="orderButton btn btn-warning btn-sm" title="Избери нова позиция"><i class="fa fa-angle-left"></i></a>
    </script>

}
