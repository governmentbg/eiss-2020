<form name="formFilter" id="formFilter" action="@Url.Action("CaseWithoutFinalExportExcel")" method="post">
    @Html.HiddenFor(m => m.CourtGroupKind)
    <div class="row">
        <div class="col-lg-3">@Html.EditorFor(x => x.CourtId, "GenericSelect2")</div>
        <div class="col-lg-3">@Html.EditorFor(x => x.LawUnitName)</div>
    </div>
</form>

<div class="row">
    <div class="col-md-6 text-left pb-15">
        <button type="button" class="btn btn-primary" id="btnFilter" onclick="LoadTable()" value="Филтриране" title="Филтриране">
            Филтриране
            <i class="fa fa-search" title="Търсене"></i>
        </button>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <table id="mainTable" class="table table-hover table-striped"></table>
    </div>
</div>

<script>
    function LoadTable() {
        if ($.fn.dataTable.isDataTable('#mainTable')) {
            refreshTable('#mainTable');
        }
        else {
            $('#mainTable').DataTable({
                ajax: {
                    "url": "@Url.Action("ListDataCentralDistribution")",
                    "type": "POST",
                    "datatype": "json",
                    "data": function (d) {
                        d.filter = {
                            CourtId: $("#CourtId").val(),
                            LawUnitName: $("#LawUnitName").val(),
                            CourtGroupKind:  $("#CourtGroupKind").val()
                        };
                    }
                },
                filter:false,
                columns: [
                    {
                        className: 'col-md-2',
                        name: 'courtName',
                        data: 'courtName',
                        title: 'От съд',
                        sortable: true,
                        searchable: false
                    },
                    {
                        className: 'col-md-3',
                        name: 'lawUnitName',
                        data: 'lawUnitName',
                        title: 'Име',
                        sortable: true,
                        searchable: false
                    },
                    {
                        className: 'col-md-3',
                        name: 'courtDepartmentLabel',
                        data: 'courtDepartmentLabel',
                        title: 'Състав',
                        sortable: true,
                        searchable: false
                    },
                    {
                        className: 'col-md-1',
                        className: "text-center",
                        name: 'loadIndex',
                        data: 'loadIndex',
                        title: 'Натовареност',
                        sortable: true,
                        searchable: false
                    },
                    {
                        className: 'col-md-1',
                        className: "text-center",
                        name: 'dateFrom',
                        data: 'dateFrom',
                        title: 'От дата',
                        sortable: true,
                        searchable: true,
                        render: function (data) {
                            return moment(data).format("DD.MM.YYYY");
                        }
                    },
                    {
                        className: 'col-md-1',
                        className: "text-center",
                        name: 'dateTo',
                        data: 'dateTo',
                        title: 'До дата',
                        sortable: true,
                        searchable: true,
                        "render": function (value) {
                            if (value)
                                return moment(value).format("DD.MM.YYYY");
                            else
                                return "";
                        }
                    },
                    // {
                    //     className: 'col-md-1',
                    //     name: 'actions',
                    //     data: "id",
                    //     title: "",
                    //     width: 100,
                    //     sortable: false,
                    //     searchable: false,
                    //     className: "text-center noExport",
                    //     "render": function (item, type, row, meta) {
                    //         return TemplateToHtml('#templateEdit', row);
                    //     }
                    // }
                ]
            });
        }
    }
</script>


