@model CaseSessionFilterVM
@using IOWebApplication.Infrastructure.Models.ViewModels
@using IOWebApplication.Infrastructure.Constants

<form name="formFilter" id="formFilter" action="@Url.Action("ListDataSprExportExcel")" method="post">
    @Html.HiddenFor(m => m.ColumnVisibility)
    @Html.HiddenFor(m => m.CaseGroupIds_text)
    @Html.HiddenFor(m => m.CaseTypeIds_text)
    @Html.HiddenFor(m => m.CaseSessionTypeIds_text)
    @Html.HiddenFor(m => m.SessionResultIds_text)
    <div class="row">
        <div class="col-lg-3">
            @Html.EditorFor(m => m.DateFrom, "DateTimeWithTime")
        </div>
        <div class="col-lg-3">
            @Html.EditorFor(m => m.DateTo, "DateTimeWithTime")
        </div>
        <div class="col-lg-3">
            @Html.EditorFor(m => m.Year, "DateTimeYear")
        </div>
    </div>
    <div class="row">
        <div class="col-lg-3">
            @Html.EditorFor(m => m.CaseSessionTypeIds, "GenericDropDownMultiple")
        </div>
        <div class="col-lg-3">
            @Html.EditorFor(m => m.HallId, "GenericDropDown")
        </div>
        <div class="col-lg-3">
            @Html.EditorFor(x => x.SessionResultIds, "GenericDropDownMultiple")
        </div>
        <div class="col-lg-3">
            @Html.EditorFor(x => x.SessionStateId, "GenericDropDown")
        </div>
    </div>
    <div class="row">
        <div class="col-lg-3">
            @Html.EditorFor(x => x.SecretaryUserId, "SelectUser")
        </div>
        <div class="col-lg-3">@Html.EditorFor(x => x.CaseGroupIds, "GenericDropDownMultiple")</div>
        <div class="col-lg-3">@Html.EditorFor(x => x.CaseTypeIds, "GenericDropDownMultiple")</div>
        <div class="col-lg-3">@Html.EditorFor(x => x.RegNumber)</div>
    </div>

    <div class="row">
        <div class="col-lg-3">@Html.EditorFor(x => x.JudgeReporterId, "LawUnit", null, new { selectMode = NomenclatureConstants.LawUnitSelectMode.CurrentWithHistoryNoVAS, lawUnitType = NomenclatureConstants.LawUnitTypes.Judge })</div>
        <div class="col-lg-3">@Html.EditorFor(x => x.CourtDepartmentId, "GenericDropDown")</div>
        <div class="col-lg-3">@Html.EditorFor(x => x.CourtDepartmentOtdelenieId, "GenericDropDown")</div>
    </div>

    <div class="row">
        <div class="col-lg-4">@Html.EditorFor(x => x.IsCalendar, "Boolean")</div>
    </div>
</form>


<div class="row">
    <div class="col-md-6 text-left pb-15">
        <button type="button" class="btn btn-primary" id="btnFilter" onclick="LoadTable()" value="Филтриране" title="Филтриране">
            Филтриране
            <i class="fa fa-search" title="Търсене"></i>
        </button>
    </div>
</div>

<div id="divTable" class="row">
    <div class="col-lg-12 col-md-12">
        <table id="caseSessionMainTable" class="table table-hover table-striped"></table>
    </div>
</div>

<div id="divCalendar" class="col-md-12">
</div>

<script>
    function LoadTable() {
        if ($("#DateFrom").val() == '' && $("#DateTo").val() == '' && $("#Year").val() == '') {
            return messageHelper.ShowErrorMessage('Попълнете от дата до дата или година', messageContainer);
        }

        var isCalendar = $("#IsCalendar").is(":checked");
        if (isCalendar) {
            var _DateFrom = $('#DateFrom').val();
            var _DateTo = $('#DateTo').val();
            var _Year = $('#Year').val();
            var _CaseSessionTypeId = $('#CaseSessionTypeId').val();
            var _HallId = $('#HallId').val();
            var _SecretaryUserId = $('#SecretaryUserId').val();
            var _CaseGroupIds_text = $('#CaseGroupIds_text').val();
            var _CaseTypeIds_text = $('#CaseTypeIds_text').val();
            var _RegNumber = $('#RegNumber').val();
            var _SessionResultId = $('#SessionResultId').val();
            var _SessionStateId = $('#SessionStateId').val();
            var _JudgeReporterId = $('#JudgeReporterId').val();
            var _CourtDepartmentId = $('#CourtDepartmentId').val();
            var _CourtDepartmentOtdelenieId = $('#CourtDepartmentOtdelenieId').val();
            var _CaseSessionTypeIds_text = $('#CaseSessionTypeIds_text').val();
            var _SessionResultIds_text = $('#SessionResultIds_text').val();
            var data = {
                dateFrom: _DateFrom,
                dateTo: _DateTo,
                year: _Year,
                caseSessionTypeId: _CaseSessionTypeId,
                hallId: _HallId,
                secretaryUserId: _SecretaryUserId,
                caseGroupIds_text: _CaseGroupIds_text,
                caseTypeIds_text: _CaseTypeIds_text,
                regNumber: _RegNumber,
                sessionResultId: _SessionResultId,
                sessionStateId: _SessionStateId,
                judgeReporterId: _JudgeReporterId,
                courtDepartmentId: _CourtDepartmentId,
                courtDepartmentOtdelenieId: _CourtDepartmentOtdelenieId,
                caseSessionTypeIds_text: _CaseSessionTypeIds_text,
                sessionResultIds_text: _SessionResultIds_text
            };
            requestContent('@Url.Action("CaseSessionSprCalendar", "CaseSession")', data, function (html) {
                $('#divCalendar').html(html);
            });
        }
        else {
            if ($.fn.dataTable.isDataTable('#caseSessionMainTable')) {
                refreshTable('#caseSessionMainTable');
            }
            else {
                $('#caseSessionMainTable').DataTable({
                    ajax: {
                        "url": "@Url.Action("ListDataSpr", "CaseSession")",
                        "type": "POST",
                        "datatype": "json",
                        data: function (d) {
                            d.model = {
                                DateFrom: $('#DateFrom').val(),
                                DateTo: $('#DateTo').val(),
                                Year: $('#Year').val(),
                                CaseSessionTypeId: $('#CaseSessionTypeId').val(),
                                HallId: $('#HallId').val(),
                                SecretaryUserId: $('#SecretaryUserId').val(),
                                CaseGroupIds_text: $('#CaseGroupIds_text').val(),
                                CaseTypeIds_text: $('#CaseTypeIds_text').val(),
                                RegNumber: $('#RegNumber').val(),
                                SessionResultId: $('#SessionResultId').val(),
                                SessionStateId: $('#SessionStateId').val(),
                                JudgeReporterId: $('#JudgeReporterId').val(),
                                CourtDepartmentId: $('#CourtDepartmentId').val(),
                                CourtDepartmentOtdelenieId: $('#CourtDepartmentOtdelenieId').val(),
                                CaseSessionTypeIds_text: $('#CaseSessionTypeIds_text').val(),
                                SessionResultIds_text: $('#SessionResultIds_text').val()
                            };
                        }

                    },
                    filter: false,
                    columns: [
                        {
                            className: 'col-md-1',
                            name: 'caseTypeLabel',
                            data: 'caseTypeLabel',
                            title: 'Вид дело',
                            sortable: true,
                            searchable: true
                        },
                        {
                            className: 'col-md-1',
                            name: 'caseName',
                            data: 'caseName',
                            title: 'Номер на дело',
                            "render": function (item, type, row, meta) {
                                var url = '@(Url.Action("CasePreview", "Case",new { id = 666}))';
                                url = url.replace('666', row.caseId);
                                return "<a style='cursor: pointer;' data-toggle='tooltip' title='Преглед' href=" + url + ">" + row.caseName + "</a>";
                            },
                            sortable: true,
                            searchable: true
                        },
                        {
                            className: 'col-md-1',
                            name: 'dateFrom',
                            data: 'dateFrom',
                            title: 'Дата',
                            sortable: true,
                            searchable: true,
                            render: function (data) {
                                if (data)
                                    return moment(data).format("DD.MM.YYYY");
                                else
                                    return "";
                            }
                        },
                        {
                            className: 'col-md-1',
                            name: 'dateFromTime',
                            data: 'dateFromTime',
                            title: 'Час',
                            sortable: true,
                            searchable: true,
                            render: function (data) {
                                if (data)
                                    return moment(data).format("HH:mm");
                                else
                                    return "";
                            }
                        },
                        {
                            className: 'col-md-1',
                            name: 'courtHallName',
                            data: 'courtHallName',
                            title: 'Зала',
                            sortable: true,
                            searchable: true
                        },
                        {
                            className: 'col-md-1',
                            name: 'judgeReporterLabel',
                            data: 'judgeReporterLabel',
                            title: 'Съдия-докладчик',
                            sortable: true,
                            searchable: true
                        },
                        {
                            name: 'departmentOtdelenieText',
                            data: 'departmentOtdelenieText',
                            title: 'Отделение/Състав',
                            sortable: true,
                            searchable: true
                        },
                        {
                            className: 'col-md-1',
                            name: 'judgeCompositionLabel',
                            data: 'judgeCompositionLabel',
                            title: 'Членове на състав',
                            sortable: true,
                            searchable: true,
                            visible: false
                        },
                        {
                            className: 'col-md-1',
                            name: 'sessionTypeLabel',
                            data: 'sessionTypeLabel',
                            title: 'Вид заседание',
                            sortable: true,
                            searchable: true
                        },
                        {
                            className: 'col-md-1',
                            name: 'sessionStateLabel',
                            data: 'sessionStateLabel',
                            title: 'Статус',
                            sortable: true,
                            searchable: true
                        },
                        // {
                        //     className: 'col-md-1',
                        //     name: 'sessionResultLabel',
                        //     data: 'sessionResultLabel',
                        //     title: 'Резултат',
                        //     sortable: true,
                        //     searchable: true
                        // },
                        {
                            className: 'col-md-1',
                            name: 'sessionResultIds',
                            data: 'sessionResultIds',
                            title: 'Резултат',
                            sortable: true,
                            searchable: true,
                            "render": function (item, type, row, meta) {
                                return row.sessionResultLabel;
                            }
                        },
                        {
                            className: 'col-md-1',
                            name: 'actions',
                            data: "id",
                            title: "",
                            sortable: false,
                            searchable: false,
                            className: "text-center noExport",
                            "render": function (value) {
                                return TemplateToHtml('#caseSessionTemplateEdit', value);
                            }
                        }
                    ]
                });
            }
        }
    }
</script>

<script id="caseSessionTemplateEdit" type="text/x-handlebars-template">
    <a href="@Url.Action("Preview", "CaseSession")?id={{this}}" class="btn btn-def btn-sm" title="Преглед"><i class="fa fa-eye"></i><span class="hidden-sm hidden-xs"></span></a>
</script>

<script>
    $(document).ready(function () {
        $('#CaseGroupIds').select2({
        });
        $('#CaseTypeIds').select2({
        });
        $('#CaseSessionTypeIds').select2({
        });
        $('#SessionResultIds').select2({
        });
        $('#CaseGroupIds').trigger('change');
        SH_DivElements();
    });

    $('#IsCalendar').change(function () {
        SH_DivElements();
    });

    function SH_DivElements() {
        var isCalendar = $("#IsCalendar").is(":checked");
        if (isCalendar) {
            $("#divCalendar").show();
            $("#divTable").hide();
        }
        else {
            $("#divCalendar").hide();
            $("#divTable").show();
        }
    }

    $('#CaseGroupIds').change(function () {
        var str = '';
        if ($('#CaseGroupIds').val() !== null && $('#CaseGroupIds').val().length > 0) {
            str = $('#CaseGroupIds').val().join(',');
        }
        $('#CaseGroupIds_text').val(str);
        requestCombo('@Url.Action("GetDDL_CaseTypes", "Ajax")', { caseGroupIds: str }, '#CaseTypeIds', @(Model.CaseTypeIds ?? "0"), function () { $('#CaseTypeIds').trigger('change') });
    });

    $('#CaseTypeIds').change(function () {
        var str = '';
        if ($('#CaseTypeIds').val() !== null && $('#CaseTypeIds').val().length > 0) {
            str = $('#CaseTypeIds').val().join(',');
        }
        $('#CaseTypeIds_text').val(str);
    });

    $('#CaseSessionTypeIds').change(function () {
        var str = '';
        if ($('#CaseSessionTypeIds').val() !== null && $('#CaseSessionTypeIds').val().length > 0) {
            str = $('#CaseSessionTypeIds').val().join(',');
        }
        $('#CaseSessionTypeIds_text').val(str);
    });

    $('#SessionResultIds').change(function () {
        var str = '';
        if ($('#SessionResultIds').val() !== null && $('#SessionResultIds').val().length > 0) {
            str = $('#SessionResultIds').val().join(',');
        }
        $('#SessionResultIds_text').val(str);
    });

    $(function () {
        initUserAutoComplete();
        initLawUnit();
    })
</script>
