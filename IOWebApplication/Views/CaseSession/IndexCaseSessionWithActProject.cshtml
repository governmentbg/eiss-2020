@using IOWebApplication.Infrastructure.Models.ViewModels
@using IOWebApplication.Infrastructure.Constants
@model CaseFilterReport

@{
    ViewData["Title"] = "Заседания с ненаписани съдебни актове от всички съдии";
}

@section breadcrumb{
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index","Home")" title="Начало"><i class="fa fa-home"></i></a></li>
        <li class="active">@ViewData["Title"]</li>
    </ol>
}

<div class="row">
    <div class="col-lg-3">@Html.EditorFor(m => m.DateFrom, "DateTime")</div>
    <div class="col-lg-3">@Html.EditorFor(m => m.ActDateToSpr, "DateTime")</div>
    <div class="col-lg-3">@Html.EditorFor(m => m.SessionTypeIds, "GenericDropDownMultipleArray")</div>
    <div class="col-lg-3">@Html.EditorFor(x => x.JudgeReporterId, "LawUnit", null, new { selectMode = NomenclatureConstants.LawUnitSelectMode.AllWithHistoryNoVAS, lawUnitType = NomenclatureConstants.LawUnitTypes.Judge })</div>
</div>

<div class="row">
    <div class="col-lg-3">@Html.EditorFor(m => m.CaseGroupId, "GenericDropDown")</div>
    <div class="col-lg-3">@Html.EditorFor(m => m.CaseTypeId, "GenericDropDown")</div>
    <div class="col-lg-6">@Html.EditorFor(m => m.CaseCodeIds, "GenericDropDownMultipleArray")</div>
</div>

<div class="row">
    <div class="col-md-6 text-left pb-15">
        <button type="button" class="btn btn-primary" id="btnFilter" onclick="LoadTable()" value="Филтриране" title="Филтриране">
            Филтриране
            <i class="fa fa-search" title="Търсене"></i>
        </button>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <table id="mainTableCaseSessionWithActProject" class="table table-hover table-striped"></table>
    </div>
</div>

<script>
    function LoadTable() {
        if ($.fn.dataTable.isDataTable('#mainTableCaseSessionWithActProject')) {
            refreshTable('#mainTableCaseSessionWithActProject');
        }
        else {
            $('#mainTableCaseSessionWithActProject').DataTable({
                ajax: {
                    "url": "@Url.Action("ListDataCaseSessionWithActProject")",
                    "type": "POST",
                    "datatype": "json",
                    "data": function (d) {
                        d.filter = {
                            DateFrom: $("#DateFrom").val(),
                            ActDateToSpr: $("#ActDateToSpr").val(),
                            CaseGroupId: $("#CaseGroupId").val(),
                            CaseTypeId: $("#CaseTypeId").val(),
                            CaseCodeIds: $("#CaseCodeIds").val(),
                            JudgeReporterId: $("#JudgeReporterId").val(),
                            SessionTypeIds: $("#SessionTypeIds").val()
                        };
                    }
                },
                filter:false,
                columns: [
                    {
                        name: 'judgeReport',
                        data: 'judgeReport',
                        title: 'Съдия',
                        sortable: true,
                        searchable: true
                    },
                    {
                        name: 'caseTypeLabel',
                        data: 'caseTypeLabel',
                        title: 'Вид дело',
                        sortable: true,
                        searchable: true
                    },
                    {
                        name: 'caseRegNum',
                        data: 'caseRegNum',
                        title: 'Номер на дело',
                        sortable: true,
                        searchable: true,
                        "render": function (item, type, row, meta) {
                            var url = '@(Url.Action("CasePreview", "Case",new { id = 666}))';
                            url = url.replace('666', row.id);
                            return "<a style='cursor: pointer;' data-toggle='tooltip' title='Преглед' href=" + url + ">" + row.caseRegNum + "</a>";
                        },
                    },
                    {
                        name: 'caseCodeLabel',
                        data: 'caseCodeLabel',
                        title: 'Предмет',
                        sortable: true,
                        searchable: true
                    },
                    {
                        name: 'sessionTypeLabel',
                        data: 'sessionTypeLabel',
                        title: 'Вид заседание',
                        sortable: true,
                        searchable: true
                    },
                    {
                        name: 'sessionDateFrom',
                        data: 'sessionDateFrom',
                        title: 'Проведено',
                        sortable: true,
                        searchable: false,
                        "render": function (value) {
                            if (value)
                                return moment(value).format("DD.MM.YYYY HH:mm");
                            else
                                return "";
                        }
                    },
                    {
                        name: 'sessionActDate',
                        data: 'sessionActDate',
                        title: 'Дата на постановяване на акта/протокола',
                        sortable: true,
                        searchable: false,
                        "render": function (value) {
                            if (value)
                                return moment(value).format("DD.MM.YYYY");
                            else
                                return "";
                        }
                    },
                    {
                        name: 'sessionResult',
                        data: 'sessionResult',
                        title: 'Резултат от заседание',
                        sortable: true,
                        searchable: true,
                        visible: false
                    },
                    {
                        name: 'actions',
                        data: "id",
                        title: "",
                        sortable: false,
                        searchable: false,
                        className: "text-center noExport",
                        "render": function (data, type, row) {
                            return TemplateToHtml('#templateEdit', row);
                        }
                    }
                ]
            }).order([[2, "asc"]]);
        }
    }
</script>

<script id="templateEdit" type="text/x-handlebars-template">
    <div class="row">
        <a href="@Url.Action("CasePreview", "Case")/{{id}}" class="btn btn-def btn-sm" title="Дело"><i class="fa fa-eye"></i><span class="hidden-sm hidden-xs"></span></a>
    </div>
</script>

<script>
    $(document).ready(function () {
        $('#CaseGroupId').trigger('change');
        $('#SessionTypeIds').select2({ language: "bg" });
        $('#CaseCodeIds').select2({ language: "bg" });
    });

    $('#CaseGroupId').change(function () {
        requestCombo('@Url.Action("GetDDL_CaseTypeFromCourtType", "Ajax")', { CaseGroupId: $(this).val() }, '#CaseTypeId', @Model.CaseTypeId, function () { $('#CaseTypeId').trigger('change') });
    });

    $('#CaseTypeId').change(function () {
        requestCombo('@Url.Action("Get_CaseCodeByLoadGroup_DropDown", "Ajax")', { caseTypeId: $(this).val() }, '#CaseCodeIds', '', function () { $('#CaseCodeIds').trigger('change') });
    });

    $(function () {
        initLawUnit();
    });
</script>
