@model string
<div class="row">
    <div class="col-lg-12 col-md-12">
        <table id="mainTable" class="table table-hover table-striped"></table>
    </div>
</div>

<style>
    .dataTables_buttons {
        display: none;
    }
</style>
<script>
    var lastFilter;
    function LoadTable() {
        if ($("#DateFrom").val() == '' && $("#DateTo").val() == '') {
            return messageHelper.ShowErrorMessage('Попълнете от дата до дата или година', messageContainer);
        }

        if ($('#CourtGroupId').val() == '-1') {
            return messageHelper.ShowErrorMessage('Изберете група за разпределяне', messageContainer);
        }
        if ($.fn.dataTable.isDataTable('#mainTable')) {
            refreshTable('#mainTable');
        }
        else {
            $('#mainTable').DataTable({
                ajax: {
                    "url": "@Url.Action(Model)",
                    "type": "POST",
                    "datatype": "json",
                    "data": function (d) {
                        getFilter(d);
                        lastFilter = JSON.stringify(d.filter);
                    }
                },
                filter: false,
                paging: false,
                pageLength: 0,
                columns: [
                    {
                        title: "",
                        sortable: false,
                        searchable: false,
                        className: "text-right noExport",
                        "render": function (a, b, item, d) {
                            return TemplateToHtml('#templateCheck', item);
                        }
                    },
                    {
                        name: 'regNumber',
                        data: 'regNumber',
                        title: 'Номер на дело',
                        "render": function (item, type, row, meta) {
                            var url = '@(Url.Action("CasePreview", "Case",new { id = 666}))';
                            url = url.replace('666', row.caseId);
                            return "<a style='cursor: pointer;' data-toggle='tooltip' title='Преглед' target='_blank' href=" + url + ">" + row.regNumber + "</a>";
                        },
                        sortable: true,
                        searchable: true
                    },
                    {
                        name: 'regDate',
                        data: 'regDate',
                        title: 'Дата',
                        sortable: true,
                        searchable: true,
                        render: function (data) {
                            return JsonBGdate(data);
                        }
                    },
                    {
                        name: 'caseTypeLabel',
                        data: 'caseTypeLabel',
                        title: 'Точен вид',
                        sortable: true,
                        searchable: false
                    },
                    {
                        name: 'lawunits',
                        data: 'lawunits',
                        title: 'Съдийски състав',
                        sortable: true,
                        searchable: true,
                        "render": function (value) {
                            return TemplateToHtml('#templateItems', value);
                        }
                    },
                    {
                        name: 'departmentOtdelenieText',
                        data: 'departmentOtdelenieText',
                        title: 'Отделение/Състав',
                        sortable: true,
                        searchable: true
                    },
                    //{
                    //    name: 'caseCodeLabel',
                    //    data: 'caseCodeLabel',
                    //    title: 'Шифри',
                    //    sortable: true,
                    //    searchable: false
                    //},
                    {
                        name: 'processPriorityLabel',
                        data: 'processPriorityLabel',
                        title: 'Вид производство',
                        sortable: true,
                        searchable: false
                    },
                    {
                        name: 'caseStateLabel',
                        data: 'caseStateLabel',
                        title: 'Статус',
                        sortable: true,
                        searchable: false
                    },
                    {
                        name: 'actions',
                        data: "caseId",
                        title: "",
                        width: 100,
                        sortable: false,
                        searchable: false,
                        className: "text-center noExport",
                        "render": function (value) {
                            return TemplateToHtml('#templateEdit', value);
                        }
                    }
                ]
            });
        }
    }

    function getCaseIds() {
        var result = '';
        $('.case-check').each(function (i, e) {
            if ($(e).is(':checked')) {
                result += ',' + $(e).data('id');
            }
        });
        if (result.length > 0) {
            return result.substr(1);
        } else {
            return undefined;
        }
    }
</script>

<script id="templateCheck" type="text/x-handlebars-template">
    <input type="checkbox" class="case-check" data-id="{{caseId}}" />
</script>
<script id="templateItems" type="text/x-handlebars-template">
    {{#each this}}
    <div>{{this}}</div>
    {{/each}}
</script>
<script id="templateEdit" type="text/x-handlebars-template">
    <div class="row">
        <a href="@Url.Action("CasePreview","Case")/{{this}}" class="btn btn-def btn-sm m-b-5" title="Преглед" target="_blank"><i class="fa fa-eye"></i><span class="hidden-sm hidden-xs"></span></a>
    </div>
</script>
