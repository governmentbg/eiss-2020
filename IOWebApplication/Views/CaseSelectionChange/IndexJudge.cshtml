@using IOWebApplication.Infrastructure.Models.ViewModels.Case
@using IOWebApplication.Infrastructure.Constants
@model CaseSelectionChangeFilterVM

@{
    ViewData["Title"] = "Масово преразпределение на съдия член на състав";
}

@section breadcrumb{
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index","Home")" title="Начало"><i class="fa fa-home"></i></a></li>
        <li class="active">@ViewData["Title"]</li>
    </ol>
}
<div class="filter-form">
    @Html.HiddenFor(m => m.CaseList)
    <div class="row">
        <div class="col-lg-3">
            @Html.EditorFor(x => x.ChangeTypeId, "GenericDropDown")
        </div>
        <div class="col-lg-3">
            @Html.EditorFor(m => m.DateFrom, "DateTime")
        </div>
        <div class="col-lg-3">
            @Html.EditorFor(m => m.DateTo, "DateTime")
        </div>
        <div class="col-lg-3">
            @Html.EditorFor(x => x.FromLawunitId, "LawUnit", null, new { selectMode = NomenclatureConstants.LawUnitSelectMode.AllWithHistoryNoVAS, lawUnitType = NomenclatureConstants.LawUnitTypes.Judge })
        </div>
    </div>
    <div class="row">
        <div class="col-lg-6">
            @Html.EditorFor(x => x.CourtGroupId, "GenericDropDown")
        </div>
        <div class="col-lg-3">
            @Html.EditorFor(x => x.ToLawunitId, "GenericDropDown")
        </div>
        <div class="col-lg-3">
            @Html.EditorFor(x => x.ToLawunitDepartmentId, "GenericDropDown")
        </div>
    </div>
    

    <div class="row">
        <div class="col-md-6 text-left pb-15">
            <button type="button" class="btn btn-primary filter-button" id="btnFilter" onclick="LoadTable()" value="Филтриране" title="Филтриране">
                Търсене
                <i class="fa fa-search" title="Търсене"></i>
            </button>

        </div>
        <div class="col-md-6 text-right pb-15">
            <a href="@Url.Action("ReplacejudgeJudge")" class="btn btn-success">Ново преразпределение</a>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12 col-md-12">
        <table id="mainTable" class="table table-hover table-striped"></table>
    </div>
</div>


<script>
    function LoadTable() {
        if ($("#DateFrom").val() == '' && $("#DateTo").val() == '' && $("#CaseYear").val() == '') {
            return messageHelper.ShowErrorMessage('Попълнете от дата до дата или година', messageContainer);
        }
        if ($.fn.dataTable.isDataTable('#mainTable')) {
            refreshTable('#mainTable');
        }
        else {
            let tbl = $('#mainTable').DataTable({
                ajax: {
                    "url": "@Url.Action("ListData")",
                    "type": "POST",
                    "datatype": "json",
                    "data": function (d) {
                        getFilter(d);
                    }
                },
                filter: false,                
                columns: [
                    
                    {
                        name: 'dateWrt',
                        data: 'dateWrt',
                        title: 'Дата',
                        sortable: true,
                        searchable: true,
                        render: function (data) {
                            return JsonBGdateTime(data);
                        }
                    },
                    {
                        name: 'userName',
                        data: 'userName',
                        title: 'Извършил преразпределението',
                        sortable: true,
                        searchable: true
                    },
                    {
                        name: 'changeTypeLabel',
                        data: 'changeTypeLabel',
                        title: 'Тип',
                        sortable: true,
                        searchable: false
                    },
                    {
                        name: 'courtGroupLabel',
                        data: 'courtGroupLabel',
                        title: 'Група за разпределяне',
                        sortable: true,
                        searchable: false
                    },
                    {
                        name: 'toLawunitName',
                        data: 'toLawunitName',
                        title: 'Нов съдия',
                        sortable: true,
                        searchable: true
                    },
                    
                    {
                        name: 'stateName',
                        data: 'stateName',
                        title: 'Статус',
                        sortable: true,
                        searchable: false
                    },
                    {
                        name: 'actions',
                        data: "id",
                        title: "",
                        width: 100,
                        sortable: false,
                        searchable: false,
                        className: "text-center noExport",
                        "render": function (value) {
                            return TemplateToHtml('#templateEdit', value);
                        }
                    }
                ]
            });
            tbl.order([0, 'desc']);
        }
    }

    
</script>

<script id="templateItems" type="text/x-handlebars-template">
    {{#each this}}
    <div>{{this}}</div>
    {{/each}}
</script>
<script id="templateEdit" type="text/x-handlebars-template">
    <div class="row">
        <a href="@Url.Action("View")/{{this}}" class="btn btn-def btn-sm m-b-5" title="Преглед" target="_blank"><i class="fa fa-eye"></i><span class="hidden-sm hidden-xs"></span></a>
    </div>
</script>

@section scripts {
    <script>
        $(document).ready(function () {
            $('#CourtGroupId').change(function () {
                requestCombo('@Url.Action("Get_LawunitsByCourtGroup")', { courtGroupId: $(this).val() }, '#ToLawunitId', null, function () {
                    $('#ToLawunitId').trigger('change');
                });
            });

            $('#ToLawunitId').change(function () {
                requestCombo('@Url.Action("Get_DepartmentsByLawunit")', { lawunitId: $(this).val(),noChange:true }, '#ToLawunitDepartmentId');
            });
        });

        function getFilter(d) {
            d.filter = {
                DateFrom: $("#DateFrom").val(),
                DateTo: $("#DateTo").val(),
                FromLawunitId: $("#FromLawunitId").val(),
                ToLawunitId: $("#ToLawunitId").val(),
                CourtGroupId: $('#CourtGroupId').val(),
                //CaseGroupIds_text: $('#CaseGroupIds_text').val(),
                ChangeTypeId: $('#ChangeTypeId').val(),
                CaseList: $('#CaseList').val()
            };
        }



    </script>

}


<script>
    $(function () {
        initLawUnit();
    });

</script>
