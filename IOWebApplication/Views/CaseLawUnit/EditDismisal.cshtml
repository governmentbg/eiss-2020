@model CaseLawUnitDismisal
@using IOWebApplication.Infrastructure.Data.Models.Cases
@using IOWebApplication.Infrastructure.Constants

@{
    if (Model.Id > 0)
    {
        ViewData["Title"] = "Преглед на основание за извеждане от състав по дело";
    }
    else
    {
        ViewData["Title"] = "Добавяне на основание за извеждане от състав по дело";
    }

    var caseId = @ViewBag.caseId;
    IAccessControl access = (IAccessControl)ViewBag.AccessControl;
    if (Model.Id > 0)
    {
        access.CanChange = false;
    }
}

@section breadcrumb{
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index","Home")" title="Начало"><i class="fa fa-home"></i></a></li>
        <li><a href="@Url.Action("Index","Case")">Съдебни дела</a></li>
        <li><a href="@Url.Action("CasePreview","Case", new { id = caseId})">Дело @ViewBag.CaseName</a></li>
        <li class="active">@ViewData["Title"]</li>
    </ol>
}

<div class="row">
    <div class="col-md-8">
        <form asp-action="EditDismisal" method="post">
            @Html.HiddenFor(x => x.Id)
            @Html.HiddenFor(x => x.CourtId)
            @Html.HiddenFor(x => x.CaseId)
            @Html.HiddenFor(x => x.CaseLawUnitId)
            @Html.HiddenFor(x => x.DismisalKindId)

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <fieldset class="is-fieldset">
                <div id="saveContainer">
                    <partial name="_SaveFormContent" model="@("#saveContainer")" />

                    <div class="row">

                        <div class="col-lg-6">@Html.EditorFor(x => x.DismisalTypeId, "GenericDropDown")</div>
                    </div>
                    @if (ViewBag.DismisalKind == NomenclatureConstants.LawUnitTypes.Judge)
                    {
                        <div class="row">
                            <div id="act">
                                <div class="col-lg-6">
                                    @Html.EditorFor(x => x.CaseSessionActId, "GenericDropDown")
                                    <div id="signersInfo" class="text-info"></div>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="row">
                        <div class="col-lg-6">@Html.EditorFor(x => x.DismisalDate, "DateTimeDivided")</div>
                    </div>

                    <div class="dt-otvod">
                        <div class="row">
                            <div class="col-lg-12">
                                <label>
                                    @Html.RadioButtonFor(x => x.DismissalRequestType, NomenclatureConstants.DismissalRequestTypes.Document)
                                    &nbsp;
                                    Искане за отвод, подадено на регистратура
                                </label>
                                &nbsp;
                                &nbsp;
                                &nbsp;
                                <label>
                                    @Html.RadioButtonFor(x => x.DismissalRequestType, NomenclatureConstants.DismissalRequestTypes.Session)
                                    &nbsp;
                                    Искане за отвод, подадено в заседание
                                </label>
                            </div>
                        </div>
                        <br />
                        <div class="row drt-document">
                            <div class="col-lg-6">@Html.EditorFor(x => x.DocumentId, "GenericDropDownLong")</div>
                            <div class="col-lg-6">@Html.EditorFor(x => x.DocumentPersonId, "GenericDropDownLong")</div>
                        </div>
                        <div class="row drt-session">
                            <div class="col-lg-6">@Html.EditorFor(x => x.DismissalSessionActId, "GenericDropDown")</div>
                            <div class="col-lg-6">@Html.EditorFor(x => x.DismissalCasePersonId, "GenericDropDown")</div>
                        </div>
                        <div class="row">
                            <div class="col-lg-6">@Html.EditorFor(x => x.DismissalStateId, "GenericDropDown")</div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-lg-12">
                            @Html.EditorFor(x => x.Description, "Textarea")
                            <span class="text-danger" style="display:block; margin-top:-15px;" @*style="font-style:italic;font-weight:bold;color:#666;"*@>
                                Моля, проверете дали всички данни в полето са обезличени.
                                <br />
                                Полето трябва да съдържа само обезличени данни.
                            </span>
                        </div>
                    </div>
                </div>
            </fieldset>
            <div class="form-group">
                @if (access.CanChange)
                {
                    <input type="submit" value="Запис" class="btn btn-success single-click-submit" />
                    <input type="submit" value="Преразпределение" class="btn btn-success single-click-submit" name="btnRedirectSelection" />
                }
                <a asp-controller="Case" asp-action="CasePreview" asp-route-id="@caseId" class="btn btn-danger">Назад</a>
                @if (Model.Id > 0)
                {
                    <div class="pull-right">
                        @await Html.PartialAsync("_ShowLogOperation", new IOWebApplication.Core.Models.ShowLogModel() { ObjectKey = Model.Id.ToString(), Action = "EditDismisal" })

                        <partial name="MqInfo" model="@(new SourceTypeSelectVM() { SourceType = SourceTypeSelectVM.CaseLawUnitDismisal, SourceId = Model.Id })" />

                    </div>
                }
            </div>

        </form>
    </div>
</div>

@section scripts{
    <script>
        var signerInfo = {};
        $(function () {
            $('#DismisalTypeId').change(function () {
                var typeId = $(this).val();
                if ((typeId == '@NomenclatureConstants.DismisalType.Otvod') || (typeId == '@NomenclatureConstants.DismisalType.SamoOtvod')) {
                    $("#act").show();
                }
                else {
                    $("#act").hide();
                }
            }).trigger('change');

            $('#DismisalTypeId').change(function () {
                let dt = $(this).val();
                if (dt == @(NomenclatureConstants.DismisalType.Otvod)) {
                    $('div.dt-otvod').show();
                } else {
                    $('div.dt-otvod').hide();
                }
            }).trigger('change');

            $('#CaseSessionActId').change(function () {
                requestGET_Json('@Url.Action("CheckActSignersForDismissal")'
                    , { lawUnitId:@(Model.CaseLawUnitId), actId: $(this).val() }
                    , function (res) {
                        signerInfo = res;
                        if (signerInfo.result == true) {
                            let signerText = 'Подписали акта: ' + signerInfo.signers;
                            if (!signerInfo.dismisalSigner) {
                                signerText += '. Актът не е подписан от ' + signerInfo.dissmissedJudgeName + ' !';
                                $('#signersInfo').addClass('text-danger').removeClass('text-info');
                            } else {
                                $('#signersInfo').removeClass('text-danger').addClass('text-info');
                            }
                            $('#signersInfo').text(signerText);

                        }
                    });
                CaseSessionActId
            }).trigger('change');

            $('#DocumentId').change(function () {
                requestCombo('@Url.Action("Get_PersonsByDocument", "Document")', { documentId: $(this).val() }, '#DocumentPersonId');
            }).trigger('change');

            $('#DismissalSessionActId').change(function () {
                requestCombo('@Url.Action("GetDDL_CasePersonByActId", "CasePerson")', { actId: $(this).val() }, '#DismissalCasePersonId');
            }).trigger('change');

            $('input[name="DismissalRequestType"]').change(function () {
                if (!$(this).is(':checked')) {
                    return;
                }
                debugger;
                var drt = $(this).val();
                switch (drt) {
                    case '@NomenclatureConstants.DismissalRequestTypes.Document':
                        $('.drt-document').show();
                        $('.drt-session').hide();
                        break;
                    case '@NomenclatureConstants.DismissalRequestTypes.Session':
                        $('.drt-document').hide();
                        $('.drt-session').show();
                        break;
                }
            });

            $('input[name="DismissalRequestType"]:checked').trigger('change');


        });


    </script>
}
