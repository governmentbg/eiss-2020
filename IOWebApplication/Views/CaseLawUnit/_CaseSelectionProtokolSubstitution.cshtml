@model CaseMainDataVM
@using IOWebApplication.Infrastructure.Models.ViewModels
@{
    IAccessControl access = (IAccessControl)ViewBag.AccessControl;
}
<div class="row">
    <div class="col-lg-12 col-md-12">
        <table id="caseSelectionProtokolSubstitutionMainTable" class="table table-hover table-striped"></table>
    </div>
</div>
<script>
    $(function () {
        var table = $('#caseSelectionProtokolSubstitutionMainTable').DataTable({
            ajax: {
                "url": "@Url.Action("LoadDataCaseSelectionProtokolSubstitution", "CaseLawUnit")",
                "type": "POST",
                "datatype": "json",
                data: function (d) {
                    d.caseSessionId = @(Model.CaseSessionId ?? 0);
                }
            },
            deferLoading: deferLoadingOnTab('#caseSelectionProtokolSubstitutionMainTable'),
            columns: [
                {
                    name: 'lawUnitName',
                    data: 'lawUnitName',
                    title: 'Съдия',
                    sortable: false,
                    searchable: true
                },
                {
                    name: 'substituteLawUnitName',
                    data: 'substituteLawUnitName',
                    title: 'Заместник',
                    sortable: false,
                    searchable: true
                },
                {
                    name: 'actions',
                    title: "",
                    sortable: false,
                    searchable: false,
                    className: "text-center noExport",
                    "render": function (a, b, item, d) {
                        return TemplateToHtml('#substOCTemplateEdit', item);
                    }
                }
            ]
        });
    });

    function applySubstC(sender) {
        swalConfirm('Потвърди заместването на съдията!', function () {

            postContent('@Url.Action("CaseSelectionProtokolSubstitutionApply", "CaseLawUnit")',
                {
                    protokolId: $(sender).data('protokol'),
                    caseSessionId: $(sender).data('session')
                },
                function (res) {
                    if (res.isOk == true) {
                        $('#caseLawUnitMainTable').DataTable().ajax.reload();
                        $('#caseLawUnitSubstMainTable').DataTable().ajax.reload();
                        $('#caseSelectionProtokolSubstitutionMainTable').DataTable().ajax.reload();
                        messageHelper.ShowSuccessMessage('Съдията е заместен успешно.');
                    }
                });
        });
    }
</script>

<script id="substOCTemplateEdit" type="text/x-handlebars-template">
    @if (access.CanChange)
    {
        <text>
            {{#if isSubstituted}}
            Заместен
            {{else}}
            <a href="#" onclick="applySubstC(this); return false;"
               data-session="@Model.CaseSessionId"
               data-protokol="{{id}}"
               class="btn btn-def btn-sm" title="Замести съдия {{lawUnitName}} със съдия {{substituteLawUnitName}}"><i class="fa fa-repeat"></i> Замести</a>
            {{/if}}
        </text>
    }
</script>