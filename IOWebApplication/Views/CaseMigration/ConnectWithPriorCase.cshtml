@model CaseMigrationPriorVM
@using IOWebApplication.Infrastructure.Models.ViewModels.Case

@inject IOWebApplication.Infrastructure.Contracts.IUserContext userContext;
@{
    ViewData["Title"] = "Свързване с предходно дело";
    IAccessControl access = (IAccessControl)ViewBag.AccessControl;
}

@section breadcrumb {
    @if (ViewBag.breadcrumbs != null)
    {
        <partial name="Breadcrumbs" model="@(List<IOWebApplication.Infrastructure.Models.ViewModels.Common.BreadcrumbsVM>)ViewBag.breadcrumbs" />
    }
}

<div class="row">
    <div class="col-md-6">
        <form asp-action="ConnectWithPriorCase" method="post">
            @Html.HiddenFor(x => x.CaseId)
            @Html.HiddenFor(x => x.PriorCaseId)
            @Html.HiddenFor(x => x.CaseInfo)
            @Html.HiddenFor(x => x.CourtName)
            <div asp-validation-summary="ModelOnly" class="text-info"></div>
            <p>
                Забележка: Делото ще бъде присъединено към текущото производство
            </p>
            <div id="saveContainer">
                <partial name="_SaveFormContent" model="@("#saveContainer")" />
                @Html.DisplayFor(x => x.CaseInfo, "obj")
                @Html.DisplayFor(x => x.CourtName, "obj")
                @Html.EditorFor(x => x.CaseMigrationTypeId, "GenericDropDown")
            </div>
            <div class="form-group">
                @if (access.CanChange)
                {
                    <input type="submit" value="Запис" class="btn btn-success" />
                }
                <a asp-action="Index" asp-route-caseId="@Model.CaseId" class="btn btn-danger">Назад</a>
            </div>
        </form>
    </div>
</div>

