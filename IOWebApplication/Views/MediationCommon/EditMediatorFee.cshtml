@using IOWebApplication.Infrastructure.Models.ViewModels.Common.Mediation
@model MediatorFeeVM

@{
    if (Model.Id > 0)
    {
        ViewData["Title"] = "Редакция на ставка за заплащане на медиатор";
    }
    else
    {
        ViewData["Title"] = "Добавяне на ставка за заплащане на медиатор";
    }

    string d = ViewBag.desc;
}

@section breadcrumb {
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")" title="Начало"><i class="fa fa-home"></i></a></li>
        <li><a href="@Url.Action("IndexMediatorFee", "MediationCommon")">Ставки за заплащане на медиатори</a></li>
        <li class="active">@ViewData["Title"]</li>
    </ol>
}

<div class="row">
    <div class="col-md-6">
        <form asp-action="EditMediatorFee" method="post">
            @Html.HiddenFor(x => x.Id)

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div id="saveContainer">
                <partial name="_SaveFormContent" model="@("#saveContainer")" />

                <div class="row">
                    <div class="col-lg-6">@Html.EditorFor(x => x.MediationTypeId, "GenericDropDown")</div>
                </div>

                <div class="row">
                    <div class="col-lg-6">@Html.EditorFor(x => x.HourFee)</div>
                    <div class="col-lg-6">@Html.EditorFor(x => x.HourFeeEUR)</div>
                </div>

                <div class="row">
                    <div class="col-lg-4">@Html.EditorFor(x => x.DateFrom, "DateTime")</div>
                    <div class="col-lg-4">@Html.EditorFor(x => x.DateTo, "DateTime")</div>
                </div>
            </div>

            <div class="form-group">
                <input type="submit" value="Запис" class="btn btn-success single-click-submit" />
                <a asp-controller="MediationCommon" asp-action="IndexMediatorFee" class="btn btn-danger">Назад</a>
                @if (Model.Id > 0)
                {
                    <div class="pull-right">
                        @await Html.PartialAsync("_ShowLogOperation", new IOWebApplication.Core.Models.ShowLogModel() { ObjectKey = Model.Id.ToString() })
                    </div>
                }
            </div>
        </form>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            
        });
    </script>
}
