@using IOWebApplication.Infrastructure.Models.ViewModels.Common.Mediation
@model MediationCoordinatorVM

@{
    if (Model.Id > 0)
    {
        ViewData["Title"] = "Редакция на координатор";
    }
    else
    {
        ViewData["Title"] = "Добавяне на координатор";
    }

    string d = ViewBag.desc;
}

@section breadcrumb {
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")" title="Начало"><i class="fa fa-home"></i></a></li>
        <li><a href="@Url.Action("IndexMediationCoordinator", "MediationCommon")">Центрове за медиация</a></li>
        <li class="active">@ViewData["Title"]</li>
    </ol>
}

<div class="row">
    <div class="col-md-6">
        <form asp-action="EditMediationCoordinator" method="post">
            @Html.HiddenFor(x => x.Id)

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div id="saveContainer">
                <partial name="_SaveFormContent" model="@("#saveContainer")" />

                <div class="row">
                    <div class="col-lg-12">@Html.EditorFor(x => x.LawUnitId, "LawUnit", null, new { lawUnitTypes = "5,6" })</div>
                </div>

                <div class="row">
                    <div class="col-lg-6">@Html.EditorFor(x => x.Position)</div>
                </div>

                <div class="row">
                    <div class="col-lg-4">@Html.EditorFor(x => x.DateFrom, "DateTime")</div>
                    <div class="col-lg-4">@Html.EditorFor(x => x.DateTo, "DateTime")</div>
                </div>

                <div class="row">
                    <div class="col-lg-12">@Html.EditorFor(x => x.Description, "Textarea")</div>
                </div>

                <div class="row">
                    <div class="col-lg-12">@Html.EditorFor(x => x.CenterIds, "GenericDropDownMultipleArray")</div>
                </div>
            </div>

            <div class="form-group">
                <input type="submit" value="Запис" class="btn btn-success single-click-submit" />
                <a asp-controller="MediationCommon" asp-action="IndexMediationCoordinator" class="btn btn-danger">Назад</a>
                @if (Model.Id > 0)
                {
                    <div class="pull-right">
                        @await Html.PartialAsync("_ShowLogOperation", new IOWebApplication.Core.Models.ShowLogModel() { ObjectKey = Model.Id.ToString() })
                    </div>
                }
            </div>
        </form>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            initLawUnit();
            $('#CenterIds').select2({ language: "bg" });

            cStr = '@Model.StringCenterIds';
            var cSelectedValues = cStr.split(",");
            $('#CenterIds').val(cSelectedValues).trigger('change');
        });
    </script>
}
