                        const targetValue = parseFloat(rowData['bazovKoefSredenALLVkraqCourtJudge']);
                        const thisValue = parseFloat(cellData);

                        if (!isNaN(thisValue) && !isNaN(targetValue) && thisValue < targetValue) {
                            $(td).css('background-color', '#f8d7da');  // Light red
                            $(td).css('color', '#721c24');             // Dark red text
                        }

                    }
                }
                    ]
                    

            // initComplete: function () {
            //     const table = $('#fastSelectionMainTable').DataTable();

            //     // List of day column names from d01 to d31
