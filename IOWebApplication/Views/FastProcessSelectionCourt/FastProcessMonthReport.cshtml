        });
       
        setTimeout(function(){
            let indexesToKeep=reportData.listOfDates;
                    //alert(indexesToKeep.join(", "));
                    for (let i = 1; i <= 31; i++) {
                        if (!indexesToKeep.includes(i)) {
                            table.column(i+3).visible(false);
                        } else {
                            table.column(i+3).visible(true);
                        }
                    }
        },300);
    }
</script>
