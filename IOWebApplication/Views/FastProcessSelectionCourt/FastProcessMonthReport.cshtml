@using IOWebApplication.Infrastructure.Models.ViewModels
@model FastProcessSelectionCourtReportFilterVM

@{
    ViewData["Title"] = "Справка Заповедни дела";
}

@section breadcrumb{
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index","Home")" title="Начало"><i class="fa fa-home"></i></a></li>
        <li class="active">@ViewData["Title"]</li>
    </ol>
}

<div class="row">

    <div class="col-lg-3">@Html.EditorFor(x => x.YearId, "GenericDropDown")</div>
    <div class="col-lg-3">@Html.EditorFor(x => x.MonthId, "GenericDropDown")</div>
    
</div>

<div class="row">
    <div class="col-md-6 text-left pb-15">
        <button type="button" class="btn btn-primary" id="btnFilter" onclick="getData()" value="Филтриране" title="Филтриране">
            Филтриране
            <i class="fa fa-search" title="Търсене"></i>
        </button>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <table id="fastSelectionMainTable" class="table table-hover table-striped"></table>
    </div>
</div>
