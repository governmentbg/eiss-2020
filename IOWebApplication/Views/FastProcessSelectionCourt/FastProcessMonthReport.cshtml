<script>
    function getData(){
        postContent("@Url.Action("GetDataReport", "FastProcessSelectionCourt")",{ model:{ yearId: $('#YearId').val(),
                        monthId: $('#MonthId').val()}},function(data){
                 loadTable(data);
        });
    }
    function loadTable(reportData) {

        const tableSelector = '#fastSelectionMainTable';

     
        if ($.fn.DataTable.isDataTable(tableSelector)) {
            $(tableSelector).DataTable().clear().destroy();
        }

        let table = $('#fastSelectionMainTable').DataTable({
                paging: false,
                scrollX:true,
                data:reportData.rows,
                processing: false,
                serverSide: false,                
                filter: false,
                columns: [           
                { name: 'courtName', data: 'courtName',title: 'СЪД', sortable: true,searchable: true},
                { name: 'judgeCount', data: 'judgeCount', title: 'Щат', sortable: false, searchable: true },
                    {
                        name: 'bazovKoefCourt',
                        data: 'bazovKoefCourt',
                        title: 'Базов коефициент на Съд',
                        sortable: false,
                        searchable: true,
                        "render": function (value) {
                            if (value)
                                return parseFloat(value).toFixed(2);
                            else
                                return "0.00";
                        }
                    }
                ,
                {
                    name: 'bazovKoefCourtJudge',
                    data: 'bazovKoefCourtJudge',
                    title: 'Базов коефициент на Съдия',
                    sortable: false,
                    searchable: true,
                    "render": function (value) {
                        if (value)
                            return parseFloat(value).toFixed(2);
                        else
                            return "0.00";

                    },
                    "createdCell": function (td, cellData, rowData, row, col) {
                        const targetValue = parseFloat(rowData['bazovKoefSredenALLCourtJudge']);
                        const thisValue = parseFloat(cellData);

                        if (!isNaN(thisValue) && !isNaN(targetValue) && thisValue < targetValue) {
                            $(td).css('background-color', '#f8d7da');  // Light red
                            $(td).css('color', '#721c24');             // Dark red text
                        }
                        
                    }
                },

                { name: 'd01', data: 'd01', title: '01', sortable: false, searchable: true, className: 'text-end' },
                { name: 'd02', data: 'd02', title: '02', sortable: false, searchable: true, className: 'text-end' },
