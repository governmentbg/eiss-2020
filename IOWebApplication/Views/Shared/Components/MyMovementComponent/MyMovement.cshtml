@using IOWebApplication.Infrastructure.Models.ViewModels;
@model IEnumerable<CaseMovementVM>
@{
    int maxTasks = 5;
}
@if (Model.Count() > 0)
{
    <div class="box">
        <div class="box-header with-border">
            <h3 class="box-title">Дела към мен</h3>
        </div>
        <div class="box-body">
            <div id="cmContainer">
                @foreach (var movementVM in Model)
                {
                    <div class="worktask-item">
                        <div class="row">
                            <div class="col-lg-4">
                                <b>@movementVM.CaseName</b>
                                @if (!string.IsNullOrEmpty(movementVM.Description))
                                {
                                    <br />
                                    <span class="remark">
                                        @movementVM.Description
                                    </span>
                                }                               
                            </div>
                            <div class="col-lg-5">
                                Изпратено от: @movementVM.UserLawUnitName
                                <br />
                                <span class="remark">Изпратена на: @movementVM.DateSend.ToString("dd.MM.yyyy")</span>
                                @if (movementVM.DateAccept.HasValue)
                                {
                                    <br />
                                    <span class="date-end">
                                        <b>Прието на: @movementVM.DateAccept.Value.ToString("dd.MM.yyyy")</b>
                                    </span>
                                }
                            </div>
                            <div class="col-lg-3">
                                <a href="@Url.Action("Index", "CaseMovement", new { CaseId = movementVM.CaseId })" class="btn btn-sm btn-primary"><i class="fa fa-map-marker"></i> Преглед</a>
                            </div>
                        </div>
                    </div>
                }
                @if (Model.Count() > maxTasks)
                {
                    int restTasks = Model.Count() - maxTasks;
                    <div class="pull-left">
                        Показани <b>@maxTasks</b> от <b>@Model.Count()</b> неприети движения.
                        <a asp-action="MyMovement" asp-controller="CaseMovement" asp-route-userMode="1">Преглед на неприетите движения</a>
                    </div>
                }
            </div>
        </div>
    </div>
}
