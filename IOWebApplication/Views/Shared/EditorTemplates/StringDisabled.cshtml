@model string
@using IOWebApplication.Infrastructure.Extensions
@{
    var label = "";
    if (ViewData["label"] != null)
    {
        label = (string)ViewData["label"];
    }
    var reqClass = ViewData.ModelMetadata.GetIOReqClass();
}

<div class="form-group>
    @if (!string.IsNullOrEmpty(label))
    {
        <label class="control-label">@label</label>
    }
    else
    {
        <label class="control-label">@Html.DisplayNameFor(model => model)</label>
    }
    @Html.TextBox("", Model.Decode(), new { @class = "form-control", disabled = true })
    @Html.HiddenFor(model => model)
    <span asp-validation-for="@Model" class="text-danger"></span>
</div>