@model EisppEventVM
@using IOWebApplication.Infrastructure.Models.ViewModels.Eispp
<div class="col-lg-10">
    @for (int i = 0; i < Model.PersonMeasures?.Count; i++)
    {
        <div class="row">
            <div class="col-md-12">
                <label><input asp-for="PersonMeasures[i].IsChecked" type="checkbox">&nbsp;&nbsp;@Model.PersonMeasures[i].Label.Decode()</label>
            </div>
        </div>
    }
</div>