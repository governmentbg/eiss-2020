@model ExpiredInfoVM
<form id="frmExpireObject" action="@Html.Raw(Model.ExpireSubmitUrl)" method="post">
    @Html.HiddenFor(x => x.Id)
    @Html.HiddenFor(x => x.LongId)
    @Html.HiddenFor(x => x.StringId)
    @Html.HiddenFor(x => x.FileContainerName)
    @Html.HiddenFor(x => x.ExpireSubmitUrl)
    @Html.HiddenFor(x => x.ReturnUrl)
    @Html.HiddenFor(x => x.OtherBool, "Boolean")
    @Html.HiddenFor(x => x.OtherId, "Int32Nullable")
    @Html.EditorFor(x => x.DescriptionExpired, "Textarea")
    <div class="form-group">
        <input type="submit" id="btnExpireObjectSubmit" value="Премахване" class="btn btn-danger submit" />
    </div>
</form>
<div id="modalMessageContainer">
</div>
<script>
    $(function () {

        let frm = $('#frmExpireObject');
        frm.submit(function (evt) {
            let validateText = validationCheck();
            if(validateText){
                swal({
                    title: 'Грешка',
                    text: validateText,
                    icon: "warning"
                });
                //debugger;
                evt.preventDefault();
                return false;
            }
            
        });

        attachAjaxForm('#frmExpireObject', function (data) {
            if (data.responseJSON.result == true) {
                if (data.responseJSON.fileContainer) {
                    LoadFiles(data.responseJSON.fileContainer);
                    HideModal();
                } else {
                    if (data.responseJSON.redirectUrl.indexOf("()") !== -1) {
                        let funcName = data.responseJSON.redirectUrl.replace("()", "");
                        //console.log(funcName);
                        if (typeof window[funcName] == "function") {
                            window[funcName]();
                        }
                    } else {
                        document.location.href = data.responseJSON.redirectUrl;
                    }
                }
            } else {
                messageHelper.ShowErrorMessage(data.responseJSON.message, '#modalMessageContainer');
                $('#btnExpireObjectSubmit').removeAttr('disabled');
            }
        }, function (error) {
            //console.log(error);
            $('#modalMessageContainer').html('Проблем при запис.');
            $('#btnExpireObjectSubmit').removeAttr('disabled');
        }, function () {
            $('#modalMessageContainer').html('');
        });

        
    })
    function validationCheck() {
        if ($('#DescriptionExpired').val().length < 5) {
            return 'Моля, въведете Причина за премахването';
        }

        return null;
        //    swal({
        //        title: 'Грешка',
        //        text: 'Моля, въведете Причина за премахването',
        //        icon: "warning"
        //    });
        //    debugger;
        //    e.preventDefault();
        //    $(e.target).find('input[type="submit"]').removeAttr('disabled');
        //    return false;
        //}

        //return true;
    }
</script>