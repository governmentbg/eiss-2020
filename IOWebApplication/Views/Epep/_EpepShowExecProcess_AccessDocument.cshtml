@using IOWebApplication.Infrastructure.Models.ViewModels.Epep
@model ExecAccessDocumentVM
@{
    Layout = null;
}
<div style="font-family: 'Times New Roman';">
    <center style="font-family: 'Arial';">
        <b>ПРЕДОСТАВЕН ДОСТЪП</b>
    </center>
    <br />
    <br />

    Съгласно @Model.DocumentType @(Model.DocumentNumber)г. подадено от @Model.ApplicantName @Model.CourtName следва да се предостави код за достъп до Електронна партида на изпълнителния лист No @Model.ActNumber по дело @Model.CaseType @Model.CaseNumber
    <br />
    <br />
    Код за достъп: <strong>@Html.Raw(Model.AccessKey)</strong>
    <br />
    <br />
    Генериран на: @(Model.AccessDate.ToString("dd.MM.yyyyг. HH:mm:ss"))
    <br />
    Отпечатано на: @(DateTime.Now.ToString("dd.MM.yyyyг. HH:mm:ss"))
    <br />
    <br />
    <table border="0">
        <tr>
            <td width="40%">
            </td>
            <td>
                Предоставил кода:
            </td>
            <td>
                @Model.UserName
            </td>
        </tr>
    </table>
</div>

