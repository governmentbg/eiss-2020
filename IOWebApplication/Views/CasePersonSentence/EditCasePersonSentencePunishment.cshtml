@model CasePersonSentencePunishment
@using IOWebApplication.Infrastructure.Constants
@using IOWebApplication.Infrastructure.Contracts
@using IOWebApplication.Infrastructure.Data.Models.Cases
@using IOWebApplication.Infrastructure.Models.ViewModels
@inject IUserContext userContext

@{
    IAccessControl access = (IAccessControl)ViewBag.AccessControl;
    if (Model.Id > 0)
    {
        ViewData["Title"] = access.CanChange ? "Редакция на наказание" : "Преглед на наказание";
    }
    else
    {
        ViewData["Title"] = "Добавяне на наказание";
    }

    bool is92024 = userContext.IsSystemInFeature(NomenclatureConstants.SystemFeatures.Request9_2024);
    bool isViewBGN = (bool?)ViewBag.IsViewBGN ?? false;
}

@section breadcrumb {
    @if (ViewBag.breadcrumbs != null)
    {
        <partial name="Breadcrumbs" model="@(List<IOWebApplication.Infrastructure.Models.ViewModels.Common.BreadcrumbsVM>)ViewBag.breadcrumbs" />
    }
}

<div class="row">
    <div class="col-md-12">
        <form asp-action="EditCasePersonSentencePunishment" method="post">
            @Html.HiddenFor(x => x.Id)
            @Html.HiddenFor(x => x.CourtId)
            @Html.HiddenFor(x => x.CaseId)
            @Html.HiddenFor(x => x.CasePersonSentenceId)

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div id="saveContainer">
                <partial name="_SaveFormContent" model="@("#saveContainer")" />

                <div class="row">
                    <div class="col-lg-6">
                        <div class="col-lg-12">
                            <fieldset class="is-fieldset">
                                <legend class="legend_1"> Основни данни</legend>
                                <div class="col-lg-12">@Html.EditorFor(x => x.SentenceTypeId, "GenericDropDown")</div>
                                @if (is92024)
                                {
                                    <div class="col-lg-12">@Html.EditorFor(x => x.PunishmentGeneralCategoryId, "GenericDropDown")</div>
                                }
                                <div class="col-lg-12">@Html.EditorFor(x => x.SentenceRegimeTypeId, "GenericDropDown")</div>
                                <div class="col-lg-12">@Html.EditorFor(x => x.SentenceText, "Textarea")</div>
                                <div class="col-lg-12">@Html.EditorFor(x => x.Description, "Textarea")</div>
                                <div class="col-lg-12">@Html.EditorFor(x => x.IsSummaryPunishment, "Boolean")</div>
                                <div class="col-lg-12">@Html.EditorFor(x => x.IsMainPunishment, "Boolean")</div>
                                <div class="col-lg-6">@Html.EditorFor(x => x.DateFrom, "DateTime")</div>
                                <div class="col-lg-6">@Html.EditorFor(x => x.DateTo, "DateTime")</div>
                            </fieldset>
                        </div>
                        <div class="col-lg-12" id="divTime">
                            <fieldset class="is-fieldset">
                                <legend class="legend_1"> Време</legend>
                                <div class="col-lg-3">@Html.EditorFor(x => x.SentenseDays, "Int32")</div>
                                <div class="col-lg-3">@Html.EditorFor(x => x.SentenseWeeks, "Int32")</div>
                                <div class="col-lg-3">@Html.EditorFor(x => x.SentenseMonths, "Int32")</div>
                                <div class="col-lg-3">@Html.EditorFor(x => x.SentenseYears, "Int32")</div>
                            </fieldset>
                        </div>
                        <div class="col-lg-12" id="divPreliminaryDetention">
                            <fieldset class="is-fieldset">
                                <legend class="legend_1"> Приспадането и зачитането на предварителното задържане</legend>
                                <div class="col-lg-3">@Html.EditorFor(x => x.PreliminaryDetentionDays, "Int32")</div>
                                <div class="col-lg-3">@Html.EditorFor(x => x.PreliminaryDetentionWeeks, "Int32")</div>
                                <div class="col-lg-3">@Html.EditorFor(x => x.PreliminaryDetentionMonths, "Int32")</div>
                                <div class="col-lg-3">@Html.EditorFor(x => x.PreliminaryDetentionYears, "Int32")</div>
                            </fieldset>
                        </div>
                        <div id="divProbation" class="col-lg-12">
                            <fieldset class="is-fieldset">
                                <legend class="legend_1"> Изпитателен срок</legend>
                                <div class="col-lg-12">@Html.EditorFor(x => x.ProbationStartDate, "DateTime")</div>
                                <div class="col-lg-3">@Html.EditorFor(x => x.ProbationDays, "Int32Nullable")</div>
                                <div class="col-lg-3">@Html.EditorFor(x => x.ProbationWeeks, "Int32Nullable")</div>
                                <div class="col-lg-3">@Html.EditorFor(x => x.ProbationMonths, "Int32Nullable")</div>
                                <div class="col-lg-3">@Html.EditorFor(x => x.ProbationYears, "Int32Nullable")</div>
                            </fieldset>
                        </div>
                        <div class="col-lg-12" id="divMoney">
                            <fieldset class="is-fieldset">
                                <legend class="legend_1"> Сума</legend>
                                <div class="col-lg-6">@Html.EditorFor(x => x.SentenseMoney, "Decimal")</div>
                                @if (isViewBGN && Model.Id > 0)
                                {
                                    <div class="col-lg-6">@Html.EditorFor(x => x.SentenseMoneyBGN, "Decimal")</div>
                                }
                            </fieldset>
                        </div>
                        
                    </div>
                    @if (Model.Id > 0)
                    {
                        <div class="col-lg-6">
                            <partial name="../CasePersonSentence/_CasePersonSentencePunishmentCrime.cshtml" model="@Model.Id" />
                        </div>
                    }
                </div>
            </div>

            <div class="form-group">
                @if (access.CanChange)
                {
                    <input type="submit" value="Запис" class="btn btn-success" />
                }
                <a asp-action="IndexCasePersonSentencePunishment" asp-route-casePersonSentenceId="@Model.CasePersonSentenceId" class="btn btn-danger">Назад</a>
                @if (Model.Id > 0)
                {
                    <div class="pull-right">
                        @if (Model.DateExpired == null && access.CanChangeFull)
                        {
                            @await Html.PartialAsync("_ExpiredInfoButton", new ExpiredInfoVM() { Id = Model.Id, ReturnUrl = @Url.Action("IndexCasePersonSentencePunishment", "CasePersonSentence", new { casePersonSentenceId = @Model.CasePersonSentenceId }), DialogTitle = "Премахване на наказание", ExpireSubmitUrl = Url.Action("CasePersonPunishment_ExpiredInfo") })
                            <span>&nbsp;</span>
                        }

                        @await Html.PartialAsync("_ShowLogOperation", new IOWebApplication.Core.Models.ShowLogModel() { ObjectKey = Model.Id.ToString() })
                    </div>
                }
            </div>
        </form>
    </div>
</div>

<script>

    $(document).ready(function () {
        Is_PeriodProbation();
        $('#SentenseMoneyBGN').attr("disabled", true);
    });

    $('#SentenceTypeId').change(function () {
        Is_PeriodProbation();
    });

    function Is_PeriodProbation() {
        $("#divTime").hide();
        $("#divMoney").hide();
        $("#divProbation").hide();
        $("#divPreliminaryDetention").hide();

        var sentenceTypeId = $("#SentenceTypeId").val();

        if (sentenceTypeId > 0) {

            postContent('@Url.Action("GetSentenceTypeHas", "CasePersonSentence")'
                , { sentenceTypeId }
                , function (data) {
                    if (data.result.hasPeriod) {
                        $("#divTime").show();
                    }

                    if (data.result.hasMoney) {
                        $("#divMoney").show();
                    }

                    if (data.result.hasProbation) {
                        $("#divProbation").show();
                    }

                    if ((data.result.hasPreliminaryDetention) && ('@is92024' == 'True')) {
                        $("#divPreliminaryDetention").show();
                    }
                });
        };
    }

</script>