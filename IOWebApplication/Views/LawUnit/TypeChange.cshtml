@model LawUnit
@using IOWebApplication.Infrastructure.Data.Models.Common
@using IOWebApplication.Infrastructure.Constants

@{
    ViewData["Title"] = "Смяна на типа на лице";

    bool readonlyEgn = (Model.Id > 0) && string.IsNullOrEmpty(Model.Uic);
}

@section breadcrumb {
    @if (ViewBag.breadcrumbs != null)
    {
        <partial name="Breadcrumbs" model="@(List<IOWebApplication.Infrastructure.Models.ViewModels.Common.BreadcrumbsVM>)ViewBag.breadcrumbs" />
    }
}

<div class="row">
    <div class="col-md-6">
        <form asp-action="TypeChange" method="post">
            @Html.HiddenFor(x => x.Id)

            <fieldset class="is-fieldset">
                <legend class="legend_1">Изберете тип лице</legend>
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                @Html.DisplayFor(x => x.FullName, "obj", new { label = "Имена" })
                @Html.LabelFor(x=>x.LawUnitTypeId)
                <div>
                    <label style="font-size:12pt;">@Html.RadioButtonFor(x => x.LawUnitTypeId, NomenclatureConstants.LawUnitTypes.Judge) Съдия</label>
                    &nbsp;
                    &nbsp;
                    <label style="font-size:12pt;">@Html.RadioButtonFor(x => x.LawUnitTypeId, NomenclatureConstants.LawUnitTypes.OtherEmployee) Служител</label>
                    &nbsp;
                    &nbsp;
                    <label style="font-size:12pt;">@Html.RadioButtonFor(x => x.LawUnitTypeId, NomenclatureConstants.LawUnitTypes.MessageDeliverer) Призовкар</label>
                    &nbsp;
                    &nbsp;
                    <label style="font-size:12pt;">@Html.RadioButtonFor(x => x.LawUnitTypeId, NomenclatureConstants.LawUnitTypes.Jury) Заседател</label>
                </div>
                <br />
                <div class="row">
                    <div class="col-lg-6">
                        <strong>Важно:</strong>
                        Промяната на типа на лицето, може ще доведе до промяна при достъпването на ресурси в ЕИСС: дела, документи и процеси. Тази промяна следва да е съгласувана с всички заинтересовани лица  от страна на съда и ВСС.
                    </div>
                </div>
                <br />
                <br />
                <div class="form-group">
                    <input type="submit" value="Запис" class="btn btn-success" />
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-danger">Назад</a>
                </div>
            </fieldset>
        </form>
    </div>

</div>
