@using IOWebApplication.Infrastructure.Models.ViewModels.Delivery
@model NotificationPrintFilterVM
<form id="formNotificationPrintFilter" action="@Url.Action("PrintNotificationInListOnFilter", "CaseNotification")" method="post">
    @Html.HiddenFor(x => x.CaseId)
    @Html.HiddenFor(x => x.CaseSessionId)
    @Html.HiddenFor(x => x.CaseSessionActId)
    @Html.HiddenFor(x => x.IsList)
    @Html.HiddenFor(x => x.NotificationListTypeId)
    <div class="row">
        <div class="col-lg-4">@Html.EditorFor(x => x.FromRowNumber)</div>
        <div class="col-lg-4">@Html.EditorFor(x => x.ToRowNumber)</div>
        <div style="display:none">
            <button id="btnNotificationItemLoadSubmit" formnovalidate formaction="@Url.Action("NotificationGroup", "CaseNotification")"></button>
        </div>
        <div class="col-lg-4">
            <br>
            <button type="submit" id="btnNotificatioPrintLoad" class="btn btn-primary" onclick="HideModal()">Печат</button>
        </div>
    </div>
</form>