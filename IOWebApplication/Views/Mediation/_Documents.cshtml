@using IOWebApplication.Infrastructure.Models.ViewModels.Case.Mediation
@model MediationCaseNavigationVM

@{
   
}

<div id="myDiv">
    @Html.HiddenFor(x => x.CaseId)
    @Html.HiddenFor(x => x.MediationCaseSessionId)

    <div class="row">
        <div class="col-md-12 text-right pb-15">
            <a asp-controller="Mediation" asp-action="AddMediationCaseSessionDocument" asp-route-mediationCaseSessionId="@Model.MediationCaseSessionId" class="btn btn-success btn-sm">
                <i class="fa fa-plus"></i>
                Добави документ
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12 col-md-12">
            <table id="documentMainTable" class="table table-hover table-striped"></table>
        </div>
    </div>
</div>


<script>
        $(function () {
        var table = $('#documentMainTable').DataTable({
                ajax: {
                    "url": "@Url.Action("ListDataDocuments", "Mediation")",
                    "type": "POST",
                    "datatype": "json",
                    "data": function (d) {
                        d.filter = {
                            MediationCaseSessionId: $("#MediationCaseSessionId").val()
                        };
                    }
                },
                dom: 'rt',
                deferLoading: deferLoadingOnTab('#documentMainTable'),
                columns: [
                    {
                        className: 'col-md-5',
                        name: 'description',
                        data: 'description',
                        title: 'Описание',
                        sortable: true,
                        searchable: true
                    },
                    {
                        className: 'col-md-1',
                        className: 'text-center',
                        name: 'dateUpload',
                        data: 'dateUpload',
                        title: 'Дата на качване',
                        sortable: true,
                        searchable: true,
                        "render": function (value) {
                            if (value)
                                return moment(value).format("DD.MM.YYYY");
                            else
                                return "";
                        }
                    },
                    {
                        className: 'col-md-1',
                        name: 'actions',
                        data: "id",
                        title: "",
                        sortable: false,
                        searchable: false,
                        className: "text-center noExport",
                        "render": function (value) {
                            return TemplateToHtml('#documentTemplateEdit', value);
                        }
                    }
                ]
            });
        });
</script>

<script id="documentTemplateEdit" type="text/x-handlebars-template">
    <a href="@Url.Action("EditMediationCaseSessionDocument", "Mediation")?id={{this}}" class="btn btn-warning btn-sm" title="Редакция"><i class="fa fa-edit"></i><span class="hidden-sm hidden-xs"></span></a>
</script>


