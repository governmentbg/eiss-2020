@using IOWebApplication.Infrastructure.Models.ViewModels.Case.Mediation
@model MediationCaseMediatorAppraisalVM

@{
    if (Model.Id > 0)
    {
        ViewData["Title"] = "Редакция на оценка";
    }
    else
    {
        ViewData["Title"] = "Добавяне на оценка";
    }
}

@section breadcrumb {
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")" title="Начало"><i class="fa fa-home"></i></a></li>
        <li><a href="@Url.Action("IndexCaseMediation", "Mediation")">Съдебни дела подлежащи на медиация</a></li>
        <li><a href="@Url.Action("CasePreviewMediation", "Mediation", new { id = Model.CaseId } )">Съдебно дело - медиация</a></li>
        <li><a href="@Url.Action("SessionPreviewMediation", "Mediation", new { id = Model.MediationCaseSessionId } )">Среща за медиация</a></li>
        <li class="active">@ViewData["Title"]</li>
    </ol>
}

<div class="row">
    <div class="col-md-6">
        <form asp-action="EditMediationCaseMediatorAppraisal" method="post">
            @Html.HiddenFor(x => x.Id)
            @Html.HiddenFor(x => x.CourtId)
            @Html.HiddenFor(x => x.CaseId)
            @Html.HiddenFor(x => x.MediationCaseSessionId)
            @Html.HiddenFor(x => x.TypeAppraisal)

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div id="saveContainer">
                <partial name="_SaveFormContent" model="@("#saveContainer")" />

                <div class="row">
                    <div class="col-lg-4">@Html.EditorFor(x => x.MediationCaseMediatorId, "GenericSelect2")</div>
                    <div class="col-lg-4">@Html.EditorFor(x => x.MediationCasePersonId, "GenericSelect2")</div>
                    <div class="col-lg-4">@Html.EditorFor(x => x.DateAppraisal)</div>
                </div>

                <div class="row">
                    <div class="col-lg-12">@Html.EditorFor(x => x.Appraisals)</div>
                </div>

                <div class="row">
                    <div class="col-lg-12">@Html.EditorFor(x => x.Description, "Textarea")</div>
                </div>
            </div>

            <div class="form-group">
                <input type="submit" value="Запис" class="btn btn-success single-click-submit" />
                <a asp-controller="Mediation" asp-action="SessionPreviewMediation" asp-route-id="@Model.MediationCaseSessionId" class="btn btn-danger">Назад</a>
                @if (Model.Id > 0)
                {
                    <div class="pull-right">
                        @await Html.PartialAsync("_ExpiredInfoButton", new ExpiredInfoVM() { Id = Model.Id, DialogTitle = "Премахване на оценка", ExpireSubmitUrl = Url.Action("MediationCaseMediatorAppraisal_ExpiredInfo") })
                        <span>&nbsp;</span>
                        @await Html.PartialAsync("_ShowLogOperation", new IOWebApplication.Core.Models.ShowLogModel() { ObjectKey = Model.Id.ToString() })
                    </div>
                }
            </div>
        </form>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            $('#MediationCaseMediatorId').select2({ language: "bg" });
        });
    </script>
}
