@using IOWebApplication.Infrastructure.Models.ViewModels.Case.Mediation
@model MediationCaseNavigationVM

@{
   
}

<div id="myDiv">
    @Html.HiddenFor(x => x.CaseId)
    @Html.HiddenFor(x => x.MediationCaseSessionId)

    <div class="row">
        <div class="col-md-12 text-right pb-15">
            <a asp-controller="Mediation" asp-action="AddMediationCaseMediatorAppraisal" asp-route-mediationCaseSessionId="@Model.MediationCaseSessionId" class="btn btn-success btn-sm">
                <i class="fa fa-plus"></i>
                Добави подробна оценка
            </a>
            <a asp-controller="Mediation" asp-action="AddMediationCaseMediatorAppraisalSummary" asp-route-mediationCaseSessionId="@Model.MediationCaseSessionId" class="btn btn-success btn-sm">
                <i class="fa fa-plus"></i>
                Добави обобщена оценка
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12 col-md-12">
            <table id="appraisalMainTable" class="table table-hover table-striped"></table>
        </div>
    </div>
</div>


<script>
        $(function () {
            var table = $('#appraisalMainTable').DataTable({
                ajax: {
                    "url": "@Url.Action("ListDataAppraisals", "Mediation")",
                    "type": "POST",
                    "datatype": "json",
                    "data": function (d) {
                        d.filter = {
                            MediationCaseSessionId: $("#MediationCaseSessionId").val()
                        };
                    }
                },
                dom: 'rt',
                deferLoading: deferLoadingOnTab('#appraisalMainTable'),
                columns: [
                    {
                        className: 'col-md-1',
                        name: 'typeAppraisalText',
                        data: 'typeAppraisalText',
                        title: 'Вид оценка',
                        sortable: false,
                        searchable: false
                    },
                    {
                        className: 'col-md-4',
                        name: 'mediationCaseMediatorFullName',
                        data: 'mediationCaseMediatorFullName',
                        title: 'Медиатор',
                        sortable: true,
                        searchable: true
                    },
                    {
                        className: 'col-md-4',
                        name: 'mediationCasePersonFullName',
                        data: 'mediationCasePersonFullName',
                        title: 'Страна дала оценката',
                        sortable: true,
                        searchable: true
                    },
                    {
                        className: 'col-md-1',
                        className: 'text-center',
                        name: 'textAppraisal',
                        data: 'textAppraisal',
                        title: 'Крайна оценка',
                        sortable: true,
                        searchable: true
                    },
                    {
                        className: 'col-md-1',
                        className: 'text-center',
                        name: 'dateAppraisal',
                        data: 'dateAppraisal',
                        title: 'Дата',
                        sortable: true,
                        searchable: true,
                        render: function (data) {
                            return moment(data).format("DD.MM.YYYY");
                        }
                    },
                    {
                        className: 'col-md-1',
                        name: 'actions',
                        data: "id",
                        title: "",
                        sortable: false,
                        searchable: false,
                        className: "text-center noExport",
                        "render": function (value) {
                            return TemplateToHtml('#appraisalTemplateEdit', value);
                        }
                    }
                ]
            });
        });
</script>

<script id="appraisalTemplateEdit" type="text/x-handlebars-template">
    <a href="@Url.Action("EditMediationCaseMediatorAppraisal", "Mediation")?id={{this}}" class="btn btn-warning btn-sm" title="Редакция"><i class="fa fa-edit"></i><span class="hidden-sm hidden-xs"></span></a>
</script>


