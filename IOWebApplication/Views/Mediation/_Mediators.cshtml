@using IOWebApplication.Infrastructure.Models.ViewModels.Case.Mediation
@model MediationCaseNavigationVM

@{
   
}

<div id="myDiv">
    @Html.HiddenFor(x => x.CaseId)

    <div class="row">
        <div class="col-md-12 text-right pb-15">
            <a asp-controller="Mediation" asp-action="AddMediationCaseMediator" asp-route-caseId="@Model.CaseId" class="btn btn-success btn-sm">
                <i class="fa fa-plus"></i>
                Добави медиатор
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12 col-md-12">
            <table id="mediatorMainTable" class="table table-hover table-striped"></table>
        </div>
    </div>
</div>


<script>
        $(function () {
            var table = $('#mediatorMainTable').DataTable({
                ajax: {
                    "url": "@Url.Action("ListDataMediators", "Mediation")",
                    "type": "POST",
                    "datatype": "json",
                    "data": function (d) {
                        d.filter = {
                            CaseId: $("#CaseId").val()
                        };
                    }
                },
                dom: 'rt',
                deferLoading: deferLoadingOnTab('#mediatorMainTable'),
                columns: [
                    {
                        className: 'col-md-6',
                        name: 'mediationMediatorName',
                        data: 'mediationMediatorName',
                        title: 'Медиатор',
                        sortable: true,
                        searchable: true
                    },
                    {
                        className: 'col-md-3',
                        name: 'mediationTypeChoiceMediatorLabel',
                        data: 'mediationTypeChoiceMediatorLabel',
                        title: 'Избран от',
                        sortable: true,
                        searchable: true
                    },
                    {
                        className: 'col-md-1',
                        className: 'text-center',
                        name: 'dateFrom',
                        data: 'dateFrom',
                        title: 'От дата',
                        sortable: true,
                        searchable: true,
                        render: function (data) {
                            return moment(data).format("DD.MM.YYYY");
                        }
                    },
                    {
                        className: 'col-md-1',
                        className: 'text-center',
                        name: 'dateTo',
                        data: 'dateTo',
                        title: 'До дата',
                        sortable: true,
                        searchable: true,
                        "render": function (value) {
                            if (value)
                                return moment(value).format("DD.MM.YYYY");
                            else
                                return "";
                        }
                    },
                    // {
                    //     className: 'col-md-1',
                    //     className: 'text-center',
                    //     name: 'textAppraisal',
                    //     data: 'textAppraisal',
                    //     title: 'Средана крайна оценка',
                    //     sortable: true,
                    //     searchable: true
                    // },
                    {
                        className: 'col-md-1',
                        name: 'actions',
                        data: "id",
                        title: "",
                        sortable: false,
                        searchable: false,
                        className: "text-center noExport",
                        "render": function (value) {
                        return TemplateToHtml('#mediatorTemplateEdit', value);
                        }
                    }
                ]
            });
        });
</script>

<script id="mediatorTemplateEdit" type="text/x-handlebars-template">
    <a href="@Url.Action("EditMediationCaseMediator", "Mediation")?id={{this}}" class="btn btn-warning btn-sm" title="Редакция"><i class="fa fa-edit"></i><span class="hidden-sm hidden-xs"></span></a>
</script>


