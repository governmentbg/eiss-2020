@using IOWebApplication.Infrastructure.Models.ViewModels.Case.Mediation
@model MediationCaseNavigationVM

@{
   
}

<div id="myDiv">
    @Html.HiddenFor(x => x.CaseId)
    @Html.HiddenFor(x => x.MediationCaseSessionId)
    <div class="row">
        <div class="col-lg-12 col-md-12">
            <table id="peopleMainTable" class="table table-hover table-striped"></table>
        </div>
    </div>
</div>


<script>
        $(function () {
            var table = $('#peopleMainTable').DataTable({
                ajax: {
                    "url": "@Url.Action("ListDataPeople", "Mediation")",
                    "type": "POST",
                    "datatype": "json",
                    "data": function (d) {
                        d.filter = {
                            MediationCaseSessionId: $("#MediationCaseSessionId").val()
                        };
                    }
                },
                dom: 'rt',
                deferLoading: deferLoadingOnTab('#peopleMainTable'),
                columns: [
                    {
                        className: 'col-md-3',
                        name: 'casePersonFullName',
                        data: 'casePersonFullName',
                        title: 'Наименование',
                        sortable: true,
                        searchable: true
                    },
                    {
                        className: 'col-md-1',
                        name: 'casePersonRoleName',
                        data: 'casePersonRoleName',
                        title: 'Вид лице',
                        sortable: true,
                        searchable: true
                    },
                    {
                        className: 'col-md-4',
                        name: 'casePersonLinkForPerson',
                        data: 'casePersonLinkForPerson',
                        title: 'Връзки лица',
                        sortable: true,
                        searchable: true
                    },
                    {
                        className: 'col-md-1',
                        className: 'text-center',
                        name: 'casePersonDateFrom',
                        data: 'casePersonDateFrom',
                        title: 'От дата',
                        sortable: true,
                        searchable: true,
                        render: function (data) {
                            return moment(data).format("DD.MM.YYYY");
                        }
                    },
                    {
                        className: 'col-md-1',
                        className: 'text-center',
                        name: 'casePersonDateTo',
                        data: 'casePersonDateTo',
                        title: 'До дата',
                        sortable: true,
                        searchable: true,
                        "render": function (value) {
                            if (value)
                                return moment(value).format("DD.MM.YYYY");
                            else
                                return "";
                        }
                    },
                    {
                        className: 'col-md-1',
                        name: 'mediationPersonSessionStateLabel',
                        data: 'mediationPersonSessionStateLabel',
                        title: 'Статус',
                        sortable: true,
                        searchable: true
                    },
                    {
                        className: 'col-md-1',
                        name: 'actions',
                        data: "id",
                        title: "",
                        sortable: false,
                        searchable: false,
                        className: "text-center noExport",
                        "render": function (value) {
                            return TemplateToHtml('#peopleTemplateEdit', value);
                        }
                    }
                ]
            });
        });
</script>

<script id="peopleTemplateEdit" type="text/x-handlebars-template">
    <a href="@Url.Action("EditMediationCasePerson", "Mediation")?id={{this}}" class="btn btn-warning btn-sm" title="Редакция"><i class="fa fa-edit"></i><span class="hidden-sm hidden-xs"></span></a>
</script>


