@using IOWebApplication.Infrastructure.Models.ViewModels.Case
@model MergerCaseFastProcessVM

@{
    ViewData["Title"] = "Обединяване на делo: " + Model.CaseLabel + (Model.IsExistsDocumentCaseInfo ? " - делото е обединено" : string.Empty);
}

@section breadcrumb {
    @* <ol class="breadcrumb">
        <li><a href="@Url.Action("Index","Home")" title="Начало"><i class="fa fa-home"></i></a></li>
        <li><a href="@Url.Action("Index","Case")">Съдебни дела</a></li>
        <li><a href="@Url.Action("CasePreview","Case", new { id = caseId})">Дело @ViewBag.CaseName</a></li>
        <li><a href="@Url.Action("IndexMovement", "CaseEvidence", new { CaseEvidenceId = Model.CaseEvidenceId })">Разпоредителни действия за доказателство @ViewBag.CaseEvidenceName</a></li>
    </ol> *@
}

<div class="row">
    <div class="col-md-12">
        <form id="frmMergerCasesFastProcess" asp-action="MergerCasesFastProcess" method="post" onsubmit="checkOnSubmit(event);">
            @Html.HiddenFor(x => x.CaseId)
            @Html.HiddenFor(x => x.CourtId)
            @Html.HiddenFor(x => x.DocumentId)
            @Html.HiddenFor(x => x.CaseLabel)
            @Html.HiddenFor(x => x.IsExistsDocumentCaseInfo)

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div id="saveContainer">
                <partial name="_SaveFormContent" model="@("#saveContainer")" />

                <div class="row">
                    <div class="col-lg-3 col-md-6 eiss-case-select">@Html.EditorFor(x => x.FromCourtId, "SelectCourt", new { onChange = "courtSelect();" })</div>
                    <div class="col-lg-3 col-md-6 eiss-case-select">@Html.EditorFor(x => x.FromCaseId, "SelectCase")</div>
                </div>
            </div>

            <div class="form-group">
                @if (!Model.IsExistsDocumentCaseInfo)
                {
                    <input type="submit" value="Запис" class="btn btn-success single-click-submit" />
                }
                <a href="@Url.Action("Index", "CaseMigration", new { caseId = Model.CaseId })" class="btn btn-danger">Назад</a>
            </div>
        </form>
    </div>
</div>

@section scripts {
    <script>
        $(function () {
            initCourts();
            initCase();
        });

        function courtSelect() {
            let courtId = $('#FromCourtId').val();
            $('.case-container:first').data('court', courtId);
        }

        var checkSubmitValidations = true;

        function checkOnSubmit(e) {
            if (!checkSubmitValidations) {
                return true;
            }

            var caseId = $("#FromCaseId").val();
            e.preventDefault();

            postContent('@Url.Action("GetFromCaseInfoForMergerCaseFastProcess", "Case")'
            , {
                caseId: caseId
            }, function (data) {
                swalConfirm("Сигурни ли сте, че искате да обедините делото с дело: " + data.result + "?", function () {
                    checkSubmitValidations = false;
                    $('#frmMergerCasesFastProcess').trigger('submit');
                }, function () {
                    singleClickSubmitEnable();
                });
                return false;
              }
            );
        }
    </script>
}