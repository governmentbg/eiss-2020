@using IOWebApplication.Infrastructure.Models.ViewModels.Case
@using IOWebApplication.Infrastructure.Constants
@model CaseLoadIndexFilterVM

@{
    ViewData["Title"] = "Натовареност - извън и в дело";
}

@section breadcrumb{
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index","Home")" title="Начало"><i class="fa fa-home"></i></a></li>
        <li class="active">@ViewData["Title"]</li>
    </ol>
}

<div class="row">
    <div class="col-lg-3">@Html.EditorFor(m => m.DateFrom, "DateTime")</div>
    <div class="col-lg-3">@Html.EditorFor(m => m.DateTo, "DateTime")</div>
    <div class="col-lg-3">@Html.EditorFor(x => x.CourtId, "GenericSelect2")</div>
    <div class="col-lg-3">@Html.EditorFor(x => x.LawUnitId, "LawUnit", null, new { selectMode = NomenclatureConstants.LawUnitSelectMode.AllWithHistoryNoVAS, lawUnitType = NomenclatureConstants.LawUnitTypes.Judge })</div>
</div>

<div class="row">
    <div class="col-md-6 text-left pb-15">
        <button type="button" class="btn btn-primary" id="btnFilter" onclick="ValidateData()" value="Филтриране" title="Филтриране">
            Филтриране
            <i class="fa fa-search" title="Търсене"></i>
        </button>
    </div>
</div>

<div class="row">
    <div class="col-lg-12 col-md-12">
        <table id="mainTable" class="table table-hover table-striped"></table>
    </div>
</div>

<script>
    function LoadTable() {
        if ($.fn.dataTable.isDataTable('#mainTable')) {
            refreshTable('#mainTable');
        }
        else {
            $('#mainTable').DataTable({
                ajax: {
                    "url": "@Url.Action("ListDataLawUnitActivitySprSpr")",
                    "type": "POST",
                    "datatype": "json",
                    data: function (d) {
                        d.DateFrom = $("#DateFrom").val();
                        d.DateTo = $("#DateTo").val();
                        d.LawUnitId = $("#LawUnitId").val();
                        d.CourtId = $("#CourtId").val();
                    }
                },
                filter:false,
                columns: [
                    {
                        name: 'courtLabel',
                        data: 'courtLabel',
                        title: 'Съд',
                        sortable: true,
                        searchable: true
                    },
                    {
                        name: 'lawUnitLabel',
                        data: 'lawUnitLabel',
                        title: 'Име',
                        sortable: true,
                        searchable: false
                    },
                    {
                        name: 'caseLoadIndex',
                        data: 'caseLoadIndex',
                        title: 'Натоварване в дела',
                        sortable: true,
                        searchable: false
                    },
                    {
                        name: 'sumLoadIndex',
                        data: 'sumLoadIndex',
                        title: 'Натоварване извън дела',
                        sortable: true,
                        searchable: false
                    },
                    {
                        name: 'loadIndex',
                        data: 'loadIndex',
                        title: 'Общо',
                        sortable: true,
                        searchable: false
                    },
                    {
                        name: 'actions',
                        data: "id",
                        title: "",
                        width: 100,
                        sortable: false,
                        searchable: false,
                        className: "text-center noExport",
                        "render": function (value) {
                            return TemplateToHtml('#templateEdit', value);
                        }
                    }
                ]
            });
        }
    }

    let createTbl = true;
    function ValidateData() {
        var datefrom = $("#DateFrom").val();
        var dateto = $("#DateTo").val();
        postContent('@Url.Action("IsValidateDateMonth", "Report")'
            , { dateFrom: datefrom, dateTo: dateto }
            , function (data) {
                if (!data.result)
                {
                    if (createTbl) {
                        LoadTable();
                        createTbl = false;
                    } else {
                        $('#mainTable').DataTable().ajax.reload(
                            function () {
                        });
                    }
                }
                else
                {
                    return messageHelper.ShowErrorMessage('Периодът е по-голям от месец.', messageContainer);
                }
            });
    }
</script>

<script id="templateEdit" type="text/x-handlebars-template">

</script>

<script>
    $(function () {
        initLawUnit();
        $('#CourtId').select2({ language: "bg" });
    });
</script>