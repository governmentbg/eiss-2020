@using IOWebApplication.Infrastructure.Models.ViewModels.Case
@using IOWebApplication.Infrastructure.Constants
@model CaseLoadIndexFilterVM

@{
    ViewData["Title"] = "Натовареност по групи: основни и допълнителни дейности";
}

@section breadcrumb{
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index","Home")" title="Начало"><i class="fa fa-home"></i></a></li>
        <li class="active">@ViewData["Title"]</li>
    </ol>
}

<div class="filter-form">
    <div class="row">
        <div class="col-lg-3">@Html.EditorFor(m => m.DateFrom, "DateTime")</div>
        <div class="col-lg-3">@Html.EditorFor(m => m.DateTo, "DateTime")</div>
        <div class="col-lg-3">@Html.EditorFor(x => x.CourtId, "GenericSelect2")</div>
    </div>

    <div class="row">
        <div class="col-lg-6">@Html.EditorFor(x => x.CourtGroupId, "GenericDropDown")</div>
    </div>

    <div class="row">
        <div class="col-lg-6">@Html.EditorFor(x => x.LawUnitId, "LawUnit", null, new { selectMode = NomenclatureConstants.LawUnitSelectMode.AllWithHistoryNoVAS, lawUnitType = NomenclatureConstants.LawUnitTypes.Judge })</div>
    </div>

    <div class="row">
        <div class="col-md-6 text-left pb-15">
            <button type="button" class="btn btn-primary" id="btnFilter" onclick="ValidateData()" value="Филтриране" title="Филтриране">
                Филтриране
                <i class="fa fa-search" title="Търсене"></i>
            </button>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12 col-md-12">
        <table id="mainTable" class="table table-hover table-striped"></table>
    </div>
</div>



<script>
    function LoadTable() {
        if ($.fn.dataTable.isDataTable('#mainTable')) {
            refreshTable('#mainTable');
        }
        else {
            $('#mainTable').DataTable({
                ajax: {
                    "url": "@Url.Action("ListDataCourtGroupeSpr")",
                    "type": "POST",
                    "datatype": "json",
                    "data": function (d) {
                        d.model = {
                            DateFrom: $("#DateFrom").val(),
                            DateTo: $("#DateTo").val(),
                            LawUnitId: $("#LawUnitId").val(),
                            CourtGroupId: $("#CourtGroupId").val(),
                            CourtId: $("#CourtId").val()
                        };
                    }
                },
                filter:false,
                columns: [
                    {
                        name: 'courtLabel',
                        data: 'courtLabel',
                        title: 'Съд',
                        sortable: true,
                        searchable: true
                    },
                    {
                        name: 'lawUnitName',
                        data: 'lawUnitName',
                        title: 'Съдия-докладчик',
                        sortable: true,
                        searchable: false
                    },
                    {
                        name: 'courtGroupLabel',
                        data: 'courtGroupLabel',
                        title: 'Група за разпределяне',
                        sortable: true,
                        searchable: false
                    },
                    {
                        name: 'calcValue',
                        data: 'calcValue',
                        render: $.fn.dataTable.render.number('', '.', 2),
                        title: 'Обща натовареност за група',
                        sortable: true,
                        searchable: false
                    },
                    {
                        name: 'calcValueAll',
                        data: 'calcValueAll',
                        render: $.fn.dataTable.render.number('', '.', 2),
                        title: 'Обща натовареност за съдия',
                        sortable: true,
                        searchable: false
                    },
                ]
            });
        }
    }

    let createTbl = true;
    function ValidateData() {
        var datefrom = $("#DateFrom").val();
        var dateto = $("#DateTo").val();
        postContent('@Url.Action("IsValidateDateMonth", "Report")'
            , { dateFrom: datefrom, dateTo: dateto }
            , function (data) {
                if (!data.result)
                {
                    if (createTbl) {
                        LoadTable();
                        createTbl = false;
                    } else {
                        $('#mainTable').DataTable().ajax.reload(
                            function () {
                        });
                    }
                }
                else
                {
                    return messageHelper.ShowErrorMessage('Периодът е по-голям от месец.', messageContainer);
                }
            });
    }
</script>

<script>
    $(function () {
        initLawUnit();
        initCaseCode();
        $('#CourtId').select2({ language: "bg" });
    });
</script>

@section scripts {
    
}
