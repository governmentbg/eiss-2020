@model  CaseSelectionProtocolSubstitutionFilterVM 

@using IOWebApplication.Infrastructure.Models.ViewModels
@using IOWebApplication.Infrastructure.Constants
@{
    ViewData["Title"] = "Протоколи за заместване";
    ViewData["ShowMenuCounts"] = true;
}

@section breadcrumb{
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index","Home")" title="Начало"><i class="fa fa-home"></i></a></li>
        <li class="active">@ViewData["Title"]</li>
    </ol>
}

<div class="row">
    <div class="col-md-12 text-right pb-15">
        <a asp-controller="CaseSelectionProtocolSubstitution" asp-action="Edit" class="btn btn-success">
            <i class="fa fa-plus"></i>
            Добави
        </a>
    </div>
</div>
<div class="row">
    <div class="col-md-12">





<div class="row">
        
            <div class="col-lg-3">@Html.EditorFor(x => x.CourtGroupId, "GenericDropDown")</div>
            <div class="col-lg-3">@Html.EditorFor(x => x.JudgeReporterId, "LawUnit", null, new { selectMode = NomenclatureConstants.LawUnitSelectMode.AllWithHistoryNoVAS, lawUnitType = NomenclatureConstants.LawUnitTypes.Judge })</div>
            <div class="col-lg-3">@Html.EditorFor(x => x.SubstitudedJudgeId, "LawUnit", null, new { selectMode = NomenclatureConstants.LawUnitSelectMode.AllWithHistoryNoVAS, lawUnitType = NomenclatureConstants.LawUnitTypes.Judge })</div>
        </div>
  <div class="row">
            <div class="col-lg-3">@Html.EditorFor(m => m.DateFrom, "DateTime")</div>
            <div class="col-lg-3">@Html.EditorFor(m => m.DateTo, "DateTime")</div>
  
</div>




<div class="row">
    <div class="col-md-6 text-left pb-15">
        <button type="button" class="btn btn-primary" id="btnFilter" onclick="LoadTableCaseSessionAct()" value="Филтриране" title="Филтриране">
            Филтриране
            <i class="fa fa-search" title="Търсене"></i>
        </button>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <table id="caseSessionActMainTable" class="table table-hover table-striped"></table>
    </div>
</div>

   
    </div>
</div>




<script>
    function LoadTableCaseSessionAct() {
        if ($.fn.dataTable.isDataTable('#caseSessionActMainTable')) {
            refreshTable('#caseSessionActMainTable');
        }
        else {
            $('#caseSessionActMainTable').DataTable({
                ajax: {
                    "url": "@Url.Action("ListData", "CaseSelectionProtocolSubstitution")",
                    "type": "POST",
                    "datatype": "json",
                    data: function (d) {
                        d.model = {
                            DateFrom: $('#DateFrom').val(),
                            DateTo: $('#DateTo').val(),
                            JudgeReporterId: $('#JudgeReporterId').val(),
                            SubstitudedJudgeId: $('#SubstitudedJudgeId').val(),
                            CourtGroupId: $('#CourtGroupId').val(),
                        };
                    }
                },
                columns: [
                    {

                        name: 'selectionDate',
                        data: 'selectionDate',
                        title: 'Дата',
                        sortable: true,
                        searchable: false,
                        "render": function (value) {
                            if (value)
                                return moment(value).format("DD.MM.YYYY");
                            else
                                return "";
                        }
                    },
                    // {
                    //     name: 'id',
                    //     data: 'id',
                    //     title: 'Протокол',
                    //     "render": function (item, type, row, meta) {
                    //         var url = '@(Url.Action("CasePreview", "Case", new { id = 666 }))';
                    //         url = url.replace('666', row.caseId);
                    //         return "<a style='cursor: pointer;' data-toggle='tooltip' title='Преглед' href=" + url + ">" + row.id + "</a>";
                    //     },
                    //     sortable: true,
                    //     searchable: true
                    // },
                    {
                        name: 'selectedLawUnitName',
                        data: 'selectedLawUnitName',
                        title: 'Съдия-докладчик',
                        sortable: true,
                        searchable: true
                    },
                    {
                        name: 'substitutedLawUnitName',
                        data: 'substitutedLawUnitName',
                        title: 'Заместван съдия',
                        sortable: true,
                        searchable: true
                    },
          
                    {
                      
                        name: 'substitutionDateFrom',
                        data: 'substitutionDateFrom',
                        title: 'Заместван от',
                        sortable: true,
                        searchable: false,
                        "render": function (value) {
                            if (value)
                                return moment(value).format("DD.MM.YYYY");
                            else
                                return "";
                        }
                    },
                    {

                        name: 'substitutionDateTo',
                        data: 'substitutionDateTo',
                        title: 'Заместван до',
                        sortable: true,
                        searchable: false,
                        "render": function (value) {
                            if (value)
                                return moment(value).format("DD.MM.YYYY");
                            else
                                return "";
                        }
                    },
                    {
                        name: 'selectionProtocolStateName',
                        data: 'selectionProtocolStateName',
                        title: '',
                        sortable: true,
                        searchable: true
                    },
                    {
                        name: 'actions',
                        data: "id",
                        title: "",
                        sortable: false,
                        searchable: false,
                        className: "text-center noExport",
                        "render": function (value) {
                            return TemplateToHtml('#caseSelectionProtokolTemplateEdit', value);
                        }
                    }
                ]
            }).order([[5, "desc"]]);
        }
    }
</script>

<script id="caseSelectionProtokolTemplateEdit" type="text/x-handlebars-template">
    <a href="@Url.Action("PreviewDoc", "CaseSelectionProtocolSubstitution")?id={{this}}" class="btn btn-warning btn-sm" title="Преглед"><i class="fa fa-eye"></i><span class="hidden-sm hidden-xs"></span></a>
</script>





