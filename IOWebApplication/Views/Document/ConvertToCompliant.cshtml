@model DocumentVM
@using IOWebApplication.Infrastructure.Models.ViewModels
@using IOWebApplication.Infrastructure.Constants
@inject IOWebApplication.Infrastructure.Contracts.IUserContext userContext;
@{
    ViewData["Title"] = "Преобразуване на документ в съпровождащ";
}

@section breadcrumb{
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index","Home")" title="Начало"><i class="fa fa-home"></i></a></li>
        <li><a href="@Url.Action("Index","Document")">Съдебна регистратура</a></li>
    </ol>
}

    <div class="row">
        <div class="col-lg-8">
        @using (Html.BeginForm("ConvertToCompliant", "Document", System.Net.Http.HttpMethod.Post))
        {
            @Html.HiddenFor(x => x.Id)
            @Html.HiddenFor(x => x.HasCaseInfo)
            @Html.HiddenFor(x => x.DocumentDirectionId)

            <div id="saveContainer">
                <partial name="_SaveFormContent" model="@("#saveContainer")" />
                <div class="row">
                    <div class="col-lg-6">
                        @Html.DisplayFor(x => x.RegNumber, "obj")
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-6">
                        @Html.EditorFor(model => model.DocumentGroupId, "GenericDropDown")
                    </div>
                    <div class="col-lg-6">
                        @Html.EditorFor(model => model.DocumentTypeId, "GenericDropDown")
                    </div>
                </div>
                @Html.EditorFor(model => model.Description, "Textarea")
                <div id="selectCase" class="case-info">
                    <fieldset class="is-fieldset">
                        <legend class="legend_1">Свързано дело</legend>
                        @{
                            ViewData.TemplateInfo.HtmlFieldPrefix = nameof(Model.DocumentCaseInfo);
                        }

                        <partial name="_DocumentCaseInfoVM" model="@Model.DocumentCaseInfo" />
                        @{
                            ViewData.TemplateInfo.HtmlFieldPrefix = String.Empty;
                        }
                    </fieldset>
                </div>
            </div>
            <div class="form-group">
                <input type="submit" value="Запис" class="btn btn-success" />
                &nbsp;
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-danger">Назад</a>
            </div>
        }
    </div>
</div>

@section scripts {
    <script>
        $(function () {
            $('#DocumentCaseInfo_CourtId').val('@Model.DocumentCaseInfo.CourtId');
            loadCourts($('.eiss-case-select').find('.court-control')[0], '@Model.DocumentCaseInfo.CourtId');
            $('#DocumentGroupId').change(function () {

                requestCombo('@Url.Action("GetDDL_DocumentTypeByCourt", "Ajax")', {
                    documentGroupId: $(this).val()
                }, '#DocumentTypeId', '@(Model.DocumentTypeId)', function () { $('#DocumentTypeId').trigger('change') });
            }).trigger('change');

            $('#DocumentCaseInfo_HasLawAct').change(function () {
                if ($(this).is(':checked')) {
                    $('.lawact-select').show();
                } else {
                    $('.lawact-select').hide();
                }
            }).trigger('change');

            initCourts();
            initCase();
        });
        function courtSelect() {
            let courtId = $('#DocumentCaseInfo_CourtId').val();
            $('#DocumentCaseInfo_CourtId').parents('.documentCaseInfo:first').find('.case-container:first').data('court', courtId);
            if (@(Model.DocumentCaseInfo.CaseId ?? 0) > 0) {
                loadCase('#DocumentCaseInfo_CaseId_case', '@Model.DocumentCaseInfo.CaseId');
            }
        }

    </script>
}