@using IOWebApplication.Infrastructure.Models.ViewModels
@model DocumentVM
<fieldset class="is-fieldset">

    <legend class="legend_1">
        Регистратура Централизирано разпределение
    </legend>
    <div class="row">
        <div class="col-lg-12">
            <a href="@Url.Action("View",new{id = Model.AssignmentDocumentId})" target="_blank" title="Преглед на документ от Регистратура Централизирано разпределение">
                Документ @Model.AssignmentDocumentNumber/@Model.AssignmentDocumentDate.ToString("dd.MM.yyyy")
                <br />
                Регистриран в @Model.AssignmentDocumentCourt
            </a>
        </div>
    </div>

</fieldset>