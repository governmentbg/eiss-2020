@using IOWebApplication.Infrastructure.Models.ViewModels
@{
    var caseId = ViewBag.caseId;
    bool isViewCaseSelectionSubstitution = (bool)ViewBag.isViewCaseSelectionSubstitution;
    ViewData["Title"] = "Протоколи от разпределение";
}

@section breadcrumb {
    @if (ViewBag.breadcrumbs != null)
    {
        <partial name="Breadcrumbs" model="@(List<IOWebApplication.Infrastructure.Models.ViewModels.Common.BreadcrumbsVM>)ViewBag.breadcrumbs" />
    }
}

<div class="col-lg-12">
    <fieldset class="is-fieldset">
        <legend class="legend_1"> Протоколи от разпределение</legend>
        <div class="tab-pane1" id="tabResult">
            <partial name="../CaseSelectionProtokol/_CaseSelectionProtokol.cshtml" model="@new CaseMainDataVM { Id = @caseId } " />
        </div>
    </fieldset>
</div>

@if (isViewCaseSelectionSubstitution)
{
    <div class="col-lg-12">
        <fieldset class="is-fieldset">
            <legend class="legend_1"> Протоколи за заместване</legend>
            <div class="tab-pane1" id="tabResult">
                <partial name="../CaseSelectionProtocolSubstitution/_CaseSelectionSubstitution.cshtml" model="@new CaseMainDataVM { Id = @caseId } " />
            </div>
        </fieldset>
    </div>
}