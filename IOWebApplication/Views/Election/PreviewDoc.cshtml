@model ElectionProtocolVM
@using IOWebApplication.Infrastructure.Models.ViewModels.Election
@using IOWebApplication.Infrastructure.Constants
@using IOWebApplication.Infrastructure.Models.ViewModels.Common
@{
    ViewData["Title"] = "Преглед на протокол";
    Layout = "~/Views/Shared/_MasterLayout.cshtml";
}
@section menuHeader{
    <header class="main-header">
        @await Component.InvokeAsync(nameof(IOWebApplication.Components.MainMenuComponent))
    </header>
}
@section contentHeader{
    <section class="content-header">
        <h1>
            @ViewData["Title"]
        </h1>
        @if (ViewBag.breadcrumbs != null)
        {
            <partial name="Breadcrumbs" model="@(List<IOWebApplication.Infrastructure.Models.ViewModels.Common.BreadcrumbsVM>)ViewBag.breadcrumbs" />
        }
    </section>
}
<div class="row">

    <div class="col-lg-12">

        <div class="box box-default">
            <div class="box-header with-border">
                <h3 class="box-title">Протокол</h3>
                <div class="box-tools pull-right">
                    <button type="button" class="btn btn-box-tool" data-widget="collapse">
                        <i class="fa fa-plus"></i>
                    </button>
                </div>
            </div>
            <!-- /.box-header -->
            <div class="box-body" style="">
                <partial name="Preview" model="@Model" />

                <!-- /.box-body -->
            </div>

        </div>
    </div>
</div>
    <div class="box box-default">

        <!-- /.box-header -->
        <div class="box-body" style="">
 
                <div class="form-group">

                    @if (Model.DateSigned == null)
                    {
                   
                     <a href="@Url.Action("SendForSign", "Election",new {id=@Model.Id})" class="btn btn-success" title="Подпиши"> Подпиши</a>
                 
                    }
                    <a asp-controller="Election" asp-action="ProtocolList" asp-route-id="@Model.ElectionGroupId" class="btn btn-danger">Назад</a>
                </div>
          
        </div>
        <!-- /.box-body -->
   
