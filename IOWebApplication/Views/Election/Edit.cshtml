@using IOWebApplication.Infrastructure.Models.ViewModels.Election
@using IOWebApplication.Infrastructure.Contracts
@inject IUserContext userContext
@model ElectionGroupVM


@if (Model.Id> 0)
{
    ViewData["Title"] = "Преглед изборна сесия";
}
else
{
    ViewData["Title"] = "Нова изборна сесия";
}

@section breadcrumb{
    @if (ViewBag.breadcrumbs != null)
    {
        <partial name="Breadcrumbs" model="@(List<IOWebApplication.Infrastructure.Models.ViewModels.Common.BreadcrumbsVM>)ViewBag.breadcrumbs" />
    }
}

<div class="row">
    <div class="col-md-12">
        @using (Html.BeginForm(null, null, FormMethod.Post, new { id = "frmCheckList" }))
        {@Html.HiddenFor(x => x.Id)



        <div asp-validation-summary="ModelOnly" class="text-danger"></div>


        <div class="row">
            <div class="col-lg-3">
                @Html.EditorFor(x => x.ElectionTypeId, "GenericDropDown")
                @Html.EditorFor(x => x.Label)
                @Html.EditorFor(x => x.Description)
                @Html.EditorFor(x => x.DocumentId, "SelectDocument")

            </div>

        </div>

        <input type="submit" value="Запис" class="btn btn-success single-click-submit" />


        <a asp-action="Index" class="btn btn-danger">Назад</a>


    }
    </div>
</div>
<script>
    $(function () {
        initDocument();
    });

</script>


